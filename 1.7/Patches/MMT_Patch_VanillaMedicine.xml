<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- 原版医疗物资同名改造（HSK 方案，参照 Core_SK_CoreModule ThingDef_Medicines.xml）：
       保留原版 defName，patch 在 XML 继承解析之前执行，Replace 的节点均为原版 def 自身已有节点；
       不删除任何原版 def/RecipeDef（MedicineIndustrial 的 recipeMaker 是内嵌字段，移除它即隐藏原版配方，
       产物由 MMT_MakeMedicineIndustrial 接管，与 HSK 删除原版配方的做法等效） -->

  <Operation Class="PatchOperationSequence">
    <operations>

      <!-- 草药原料：效力 0.60 -> 0.30、质量上限 0.70 -> 0.60、腐烂 150 天 -> 30 天（对齐 HSK，为草药包让出 0.60 档位） -->
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="MedicineHerbal"]/statBases</xpath>
        <value>
          <statBases>
            <MarketValue>10</MarketValue>
            <Mass>0.35</Mass>
            <Flammability>1.3</Flammability>
            <MedicalPotency>0.30</MedicalPotency>
            <MedicalQualityMax>0.60</MedicalQualityMax>
            <DeteriorationRate>6</DeteriorationRate>
          </statBases>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="MedicineHerbal"]/comps/li[@Class="CompProperties_Rottable"]/daysToRotStart</xpath>
        <value><daysToRotStart>30</daysToRotStart></value>
      </li>

      <!-- 工业医药：隐藏原版制作配方（移除内嵌 recipeMaker/costList），由 MMT_MakeMedicineIndustrial 接管 -->
      <li Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="MedicineIndustrial"]/recipeMaker</xpath>
      </li>
      <li Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="MedicineIndustrial"]/costList</xpath>
      </li>

      <!-- 中性胺：堆叠 150 -> 400、市价 6 -> 10（对齐 HSK） -->
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Neutroamine"]/stackLimit</xpath>
        <value><stackLimit>400</stackLimit></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Neutroamine"]/statBases/MarketValue</xpath>
        <value><MarketValue>10</MarketValue></value>
      </li>

      <!-- 草药根：生长期 7 -> 5.8 天、播种技能 8 -> 5；原版无 harvestYield 节点故用 Add（产量 8，对齐 HSK），
           并加入播种研究前置 MMT_MedicalPlants_A1 -->
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Plant_Healroot"]/plant/growDays</xpath>
        <value><growDays>5.8</growDays></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Plant_Healroot"]/plant/sowMinSkill</xpath>
        <value><sowMinSkill>5</sowMinSkill></value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Plant_Healroot"]/plant</xpath>
        <value>
          <harvestYield>8</harvestYield>
          <sowResearchPrerequisites>
            <li>MMT_MedicalPlants_A1</li>
          </sowResearchPrerequisites>
        </value>
      </li>

      <!-- 原版研究 MedicineProduction（医疗物资 V）：造价 1500 -> 1000，前置 DrugProduction -> MMT_Medicine_B2（对齐 HSK 医疗线），
           移入 MMT 页（X=4,Y=4，位于 B2 与 D1 之间） -->
      <li Class="PatchOperationReplace">
        <xpath>Defs/ResearchProjectDef[defName="MedicineProduction"]/baseCost</xpath>
        <value><baseCost>1000</baseCost></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ResearchProjectDef[defName="MedicineProduction"]/label</xpath>
        <value><label>医疗物资 V</label></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ResearchProjectDef[defName="MedicineProduction"]/prerequisites</xpath>
        <value>
          <prerequisites>
            <li>MMT_Medicine_B2</li>
          </prerequisites>
        </value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ResearchProjectDef[defName="MedicineProduction"]</xpath>
        <value><tab>MMT_ResearchTab</tab></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ResearchProjectDef[defName="MedicineProduction"]/researchViewX</xpath>
        <value><researchViewX>4.00</researchViewX></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ResearchProjectDef[defName="MedicineProduction"]/researchViewY</xpath>
        <value><researchViewY>4.00</researchViewY></value>
      </li>

    </operations>
  </Operation>
</Patch>
