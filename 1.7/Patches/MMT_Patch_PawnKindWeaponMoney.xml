<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- MMT 武器重定价（HSK 价位）后，部分原版 PawnKind 的 weaponMoney 下限买不起带对应 weaponTags 的最便宜武器，
	     触发 "could end up weaponless" 配置错误。本补丁把下限抬到对应最便宜武器价位（上限保持不低于原值）。 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/PawnKindDef[defName="Villager"]/weaponMoney</xpath>
		<value><weaponMoney>230~250</weaponMoney></value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/PawnKindDef[defName="Villager_Pig"]</xpath>
		<value><weaponMoney>230~250</weaponMoney></value>
	</Operation>
