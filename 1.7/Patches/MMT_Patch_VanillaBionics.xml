  <!-- 原版同名仿生/义肢部件改造(对照 HSK AutoGenPatches/BodyParts):
       替换 costList 为 MMT 材料链,追加 recipeMaker 改到 MMT 工作台与研究。
       安装手术沿用原版(Human 自带 InstallXxx),数值保留原版。 -->

  <!-- 神经机械仿生臂(ArchotechArm) -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="ArchotechArm"]/costList</xpath>
    <operation Class="PatchOperationRemove">
      <xpath>Defs/ThingDef[defName="ArchotechArm"]/costList</xpath>
    </operation>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="ArchotechArm"]</xpath>
    <value>
    <costList>
      <MMT_UltraComponent>4</MMT_UltraComponent>
      <MMT_Biomatter>40</MMT_Biomatter>
      <MMT_SyntheticFibers>12</MMT_SyntheticFibers>
      <MMT_BioMicrochips>1</MMT_BioMicrochips>
      <MMT_ArtificialBone>5</MMT_ArtificialBone>
    </costList>
    <recipeMaker>
      <workSpeedStat>MMT_ElectronicCraftingSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <workAmount>12000</workAmount>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedHealthItemBionic</unfinishedThingDef>
      <skillRequirements>
        <Crafting>18</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>MMT_UpgradingStation</li>
      </recipeUsers>
    </recipeMaker>
    </value>
  </Operation>

