<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- 原版锭/零部件追加 MMT 类别，使类别过滤配方能选中原版物品；对照 HSK 对 Steel→SLDBar 的同类归属 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Steel"]/thingCategories</xpath>
    <value><li>MMT_SLDBar</li></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Plasteel"]/thingCategories</xpath>
    <value><li>MMT_USLDBar</li></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Gold"]/thingCategories</xpath>
    <value><li>MMT_PRSBar</li></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Silver"]/thingCategories</xpath>
    <value><li>MMT_PRSBar</li></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Uranium"]/thingCategories</xpath>
    <value><li>MMT_RADBar</li></value>
  </Operation>
  <!-- 原版原木归入 MMT_Woody，使木材类过滤的配方能选中原版原木 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="WoodLog"]/thingCategories</xpath>
    <value><li>MMT_Woody</li></value>
  </Operation>
  <!-- 原版啤酒归入 MMT_Alcohol，使酒类过滤的配方（如表面活性剂）能选中原版啤酒。
       Beer 自身未定义 thingCategories（继承自 DrugBase），补丁无法匹配继承节点，
       故用条件补丁：有节点则追加，无节点则补建节点。注意：继承的列表字段会与显式节点合并，
       因此补建节点时只写 MMT_Alcohol，不可重复写入 Drugs，否则报 duplicate thingCategory -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Beer"]/thingCategories</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Beer"]/thingCategories</xpath>
      <value><li>MMT_Alcohol</li></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Beer"]</xpath>
      <value>
        <thingCategories>
          <li>MMT_Alcohol</li>
        </thingCategories>
      </value>
    </nomatch>
  </Operation>
  <!-- 零件类别由 MMT_Patch_VanillaComponents.xml、布的类别由 MMT_Patch_VanillaTextiles.xml 同名改造直接处理，此处不再追加 -->
</Patch>
