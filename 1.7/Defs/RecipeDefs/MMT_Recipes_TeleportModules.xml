<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 充能效率模块：挂电动装配台；需研究"充能增效" -->
  <RecipeDef>
    <defName>MMT_MakeChargeEfficiencyModule</defName>
    <label>组装充能效率模块</label>
    <description>组装电能回路的增效控制模块，安装进折跃传送台或充能台后使充能速度提高 10%。产出 1。</description>
    <jobString>正在组装充能效率模块。</jobString>
    <workAmount>2000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>25</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Wire</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_ElectronicParts</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>MMT_Wire</li>
        <li>MMT_ElectronicParts</li>
        <li>ComponentIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_ChargeEfficiencyModule>1</MMT_ChargeEfficiencyModule>
    </products>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_ChargeBoost</researchPrerequisite>
  </RecipeDef>

  <!-- 次元传送模块：材料偏 Ultra（玻璃钢+超级零件），挂电动装配台；需研究"次元传送" -->
  <RecipeDef>
    <defName>MMT_MakeDimensionalModule</defName>
    <label>组装次元传送模块</label>
    <description>组装折跃装置的次元坐标锚定模块，安装进折跃传送台后使传送次数上限提高 1 次。产出 1。</description>
    <jobString>正在组装次元传送模块。</jobString>
    <workAmount>3000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_ElectronicParts</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Gold</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Plasteel</li>
        <li>ComponentSpacer</li>
        <li>MMT_ElectronicParts</li>
        <li>Gold</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_DimensionalModule>1</MMT_DimensionalModule>
    </products>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_DimensionalTeleport</researchPrerequisite>
  </RecipeDef>
</Defs>
