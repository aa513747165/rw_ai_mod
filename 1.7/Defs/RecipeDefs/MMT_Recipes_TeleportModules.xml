<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 充能效率模块：后期昂贵模块，材料跨电力（电线）/高级合金（稀有合金类）/电子（集成电路）/零件（高级零部件）四条链；挂电动装配台；需研究"充能增效" -->
  <RecipeDef>
    <defName>MMT_MakeChargeEfficiencyModule</defName>
    <label>组装充能效率模块</label>
    <description>组装电能回路的增效控制模块，安装进折跃传送台或充能台后使充能速度提高 10%。产出 1。</description>
    <jobString>正在组装充能效率模块。</jobString>
    <workAmount>4000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Wire</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>MMT_RARBar</li>
          </categories>
        </filter>
        <count>8</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_IntegratedCircuit</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_SpacerComponent</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_Wire</li>
        <li>MMT_IntegratedCircuit</li>
        <li>MMT_SpacerComponent</li>
      </thingDefs>
      <categories>
        <li>MMT_RARBar</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <MMT_ChargeEfficiencyModule>1</MMT_ChargeEfficiencyModule>
    </products>
    <skillRequirements>
      <Crafting>10</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_ChargeBoost</researchPrerequisite>
  </RecipeDef>

</Defs>
