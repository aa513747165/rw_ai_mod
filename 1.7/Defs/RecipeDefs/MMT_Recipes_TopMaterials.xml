    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_UltraComponents</researchPrerequisite>
  </RecipeDef>

  <!-- 拆解伪人格核心：对照 HSK DisassembleAIPersonaCore（AIPersonaCore 为原版） -->
