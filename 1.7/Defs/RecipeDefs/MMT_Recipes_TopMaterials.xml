<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 磁性材料：对照 HSK BuildMagneticMaterial（RobAssem → MMT_RoboticAssembler） -->
  <RecipeDef>
    <defName>MMT_BuildMagneticMaterial</defName>
    <label>合成磁性材料</label>
    <description>由磁性金属合成强磁材料。产出 5。</description>
    <jobString>正在合成磁性材料。</jobString>
    <workAmount>2400</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <recipeUsers>
      <li>MMT_RoboticAssembler</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Matter</li>
          </thingDefs>
        </filter>
        <count>30</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Sulphates</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>MMT_USLDBar</li>
          </categories>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>MMT_SLDBar</li>
          </categories>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MMT_SLDBar</li>
        <li>MMT_USLDBar</li>
      </categories>
      <thingDefs>
        <li>MMT_Matter</li>
        <li>MMT_Sulphates</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_MagneticMaterial>5</MMT_MagneticMaterial>
    </products>
    <skillRequirements>
      <Crafting>18</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_UltraComponents</researchPrerequisite>
  </RecipeDef>

