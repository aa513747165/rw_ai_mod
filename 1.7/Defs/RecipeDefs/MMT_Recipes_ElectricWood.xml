<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>MMT_MakeWoodPlanks_Electric</defName>
    <label>加工木板</label>
    <description>用电动锯木机将原木批量切割成木板。产出 30。</description>
    <jobString>正在电锯木板。</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>MakeWoodPlanks_Hand</effectWorking>
    <soundWorking>Recipe_MakeWoodPlanks_Hand</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>WoodLog</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_WoodPlank>30</MMT_WoodPlank>
    </products>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_ElectricWoodworking</researchPrerequisite>
  </RecipeDef>

