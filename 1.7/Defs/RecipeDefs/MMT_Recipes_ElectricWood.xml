<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>MMT_MakeWoodPlanks_Electric</defName>
    <label>电锯木板</label>
    <description>用电动锯木机将原木批量切割成木板。产出 30。</description>
    <jobString>正在电锯木板。</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>MakeWoodPlanks_Hand</effectWorking>
    <soundWorking>Recipe_MakeWoodPlanks_Hand</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>WoodLog</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_WoodPlank>30</MMT_WoodPlank>
    </products>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_ElectricWoodworking</researchPrerequisite>
  </RecipeDef>

  <RecipeDef>
    <defName>MMT_MakeKindling_Electric</defName>
    <label>电劈柴火</label>
    <description>用电动锯木机将原木批量劈成柴火。产出 40。</description>
    <jobString>正在电劈柴火。</jobString>
    <workAmount>500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>MakeWoodPlanks_Hand</effectWorking>
    <soundWorking>Recipe_MakeWoodPlanks_Hand</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>WoodLog</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Kindling>40</MMT_Kindling>
    </products>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.25</workSkillLearnFactor>
    <researchPrerequisite>MMT_ElectricWoodworking</researchPrerequisite>
  </RecipeDef>

  <RecipeDef>
    <defName>MMT_MakeCharcoal_Electric</defName>
    <label>电烧木炭</label>
    <description>用电动木炭窑将原木干馏成木炭，比土窑更快。产出 20。</description>
    <jobString>正在电烧木炭。</jobString>
    <workAmount>800</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </filter>
        <count>25</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>WoodLog</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Charcoal>20</MMT_Charcoal>
    </products>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_ElectricWoodworking</researchPrerequisite>
  </RecipeDef>
</Defs>
