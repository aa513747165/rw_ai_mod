<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>MMT_SmeltCopperBar_Hand</defName>
    <label>提炼铜（10个）</label>
    <description>将铜矿石冶炼成铜锭。产出 10。</description>
    <jobString>正在冶炼铜锭。</jobString>
    <workAmount>700</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_CopperOre</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_CopperOre</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_CopperBar>10</MMT_CopperBar>
    </products>
    <skillRequirements>
      <Crafting>1</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_BasicMetalworking</researchPrerequisite>
  </RecipeDef>

  <RecipeDef>
    <defName>MMT_SmeltTinBar_Hand</defName>
    <label>提炼锡（10个）</label>
    <description>将锡矿石冶炼成锡锭。产出 10。</description>
    <jobString>正在冶炼锡锭。</jobString>
    <workAmount>600</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_TinOre</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_TinOre</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_TinBar>10</MMT_TinBar>
    </products>
    <skillRequirements>
      <Crafting>1</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_BasicMetalworking</researchPrerequisite>
  </RecipeDef>

  <RecipeDef>
    <defName>MMT_MakeBronze_Hand</defName>
    <label>提炼青铜（30个）</label>
    <description>将铜锭和锡锭合炼成青铜。产出 30。</description>
    <jobString>正在冶炼青铜。</jobString>
    <workAmount>1000</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_CopperBar</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_TinBar</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_CopperBar</li>
        <li>MMT_TinBar</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Bronze>30</MMT_Bronze>
    </products>
    <skillRequirements>
      <Crafting>2</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_BasicMetalworking</researchPrerequisite>
  </RecipeDef>

  <RecipeDef>
    <defName>MMT_SmeltSteel_Hand</defName>
    <label>提炼钢铁（20个）</label>
    <description>将铁矿石和木炭冶炼成钢。产出 20。</description>
    <jobString>正在冶炼钢。</jobString>
    <workAmount>1300</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_IronOre</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Charcoal</li>
            <li>MMT_Coal</li>
          </thingDefs>
        </filter>
        <count>13</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_IronOre</li>
        <li>MMT_Charcoal</li>
        <li>MMT_Coal</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Steel>20</Steel>
    </products>
    <skillRequirements>
      <Crafting>3</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_BasicMetalworking</researchPrerequisite>
  </RecipeDef>
</Defs>
