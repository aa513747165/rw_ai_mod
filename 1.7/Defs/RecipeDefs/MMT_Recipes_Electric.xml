<Defs>
  <RecipeDef>
    <defName>MMT_SmeltCopperBar_Electric</defName>
    <label>提炼铜（20个）</label>
    <description>用电弧炉将铜矿石批量冶炼成铜锭。产出 20。</description>
    <jobString>正在电炼铜锭。</jobString>
    <workAmount>500</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_CopperOre</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_CopperOre</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_CopperBar>20</MMT_CopperBar>
    </products>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_ElectricSmelting</researchPrerequisite>
  </RecipeDef>

