    <label>冶炼镍锭</label>
    <description>将镍矿石冶炼成镍锭。产出 15。</description>
    <jobString>正在冶炼镍锭。</jobString>
    <workAmount>1500</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_NickelOre</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_NickelOre</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_NickelBar>15</MMT_NickelBar>
    </products>
    <skillRequirements>
      <Crafting>13</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_AdvancedMetalRefining</researchPrerequisite>
  </RecipeDef>

