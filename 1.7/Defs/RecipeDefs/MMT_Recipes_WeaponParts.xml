  <!-- 武器部件：对照 HSK MakeWeapon_Parts -->
  <RecipeDef>
    <defName>MMT_MakeWeaponParts</defName>
    <label>制造武器部件</label>
    <description>制造通用武器部件。产出 5。</description>
    <jobString>正在制造武器部件。</jobString>
    <workAmount>1500</workAmount>
    <workSpeedStat>SmithingSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MMT_MetallicBar</li>
          </categories>
        </filter>
        <count>25</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Mechanism</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ComponentIndustrial</li>
        <li>MMT_Mechanism</li>
      </thingDefs>
      <categories>
        <li>MMT_MetallicBar</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <MMT_WeaponParts>5</MMT_WeaponParts>
    </products>
