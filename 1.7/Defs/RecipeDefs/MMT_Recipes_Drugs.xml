    <defName>MMT_MakeIbuprofen</defName>
    <label>合成止痛药</label>
    <description>用中性胺合成止痛药。产出 1。</description>
    <jobString>正在合成止痛药。</jobString>
    <workAmount>200</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <soundWorking>Recipe_Drug</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
