<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 药品链毒品/兴奋剂配方：对照 HSK Recipes_Drug.xml、Drugs/HerbalTea.xml、Recipes_UF_Drying(.Industrial).xml。
       晾晒：MMT 无 UniversalFermenter 框架，用长工时普通配方模拟 4 天晾晒；
       活性炭：HSK 的 Charcoal/Coal 映射为 MMT_Charcoal/MMT_Coal -->

  <!-- 自然合成中性胺：对照 HSK MakeNaturalNeutroamine -->
  <RecipeDef>
    <defName>MMT_MakeNeutroamine</defName>
    <label>合成中性胺（天然）</label>
    <description>从中性花瓣与金丝桃中提取合成中性胺。产出 1。</description>
    <jobString>正在合成中性胺。</jobString>
    <workAmount>700</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <soundWorking>Recipe_Drug</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_NeutroPetals</li>
          </thingDefs>
        </filter>
        <count>8</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Hypericum</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_NeutroPetals</li>
        <li>MMT_Hypericum</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Neutroamine>1</Neutroamine>
    </products>
    <skillRequirements>
      <Medicine>6</Medicine>
      <Crafting>3</Crafting>
    </skillRequirements>
    <workSkill>Medicine</workSkill>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>MMT_Drugs_C2</researchPrerequisite>
  </RecipeDef>

  <!-- 石化精炼中性胺：对照 HSK/Rimefeller NeutroamineRefiner 的消耗速率（0.6 燃料/批放大为配方） -->
  <RecipeDef>
    <defName>MMT_RefineNeutroamine</defName>
    <label>精炼中性胺（石化）</label>
    <description>以化合燃料为原料催化裂解精炼中性胺。产出 1。</description>
    <jobString>正在精炼中性胺。</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Drug</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Chemfuel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Neutroamine>1</Neutroamine>
    </products>
    <skillRequirements>
      <Medicine>6</Medicine>
    </skillRequirements>
    <workSkill>Medicine</workSkill>
    <recipeUsers>
      <li>MMT_NeutroamineRefiner</li>
    </recipeUsers>
    <researchPrerequisite>MMT_Drugs_C2</researchPrerequisite>
  </RecipeDef>

  <!-- 晾晒烟叶：对照 HSK Make_Smokeleaf（发酵 4 天折算为长工时） -->
  <RecipeDef>
    <defName>MMT_DrySmokeleaf</defName>
    <label>晾晒烟叶</label>
    <description>将新鲜大麻叶摊开晾干。产出 5。</description>
    <jobString>正在晾晒烟叶。</jobString>
    <workAmount>2400</workAmount>
    <workSpeedStat>DrugCookingSpeed</workSpeedStat>
    <soundWorking>Recipe_Drug</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>SmokeleafLeaves</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>SmokeleafLeaves</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_DriedLeavesSmokeleaf>5</MMT_DriedLeavesSmokeleaf>
    </products>
    <workSkill>Cooking</workSkill>
    <recipeUsers>
      <li>MMT_DryingRack</li>
      <li>MMT_ElectricDryingRack</li>
    </recipeUsers>
    <researchPrerequisite>MMT_Drugs_A1</researchPrerequisite>
  </RecipeDef>

  <!-- 晾晒烟叶（批量）：对照 HSK Make_Smokeleaf_x5 -->
  <RecipeDef>
    <defName>MMT_DrySmokeleafBulk</defName>
    <label>晾晒烟叶（×5）</label>
    <description>批量晾干大麻叶。产出 25。</description>
    <jobString>正在晾晒烟叶。</jobString>
    <workAmount>9600</workAmount>
    <workSpeedStat>DrugCookingSpeed</workSpeedStat>
    <soundWorking>Recipe_Drug</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>SmokeleafLeaves</li>
          </thingDefs>
        </filter>
        <count>25</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>SmokeleafLeaves</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_DriedLeavesSmokeleaf>25</MMT_DriedLeavesSmokeleaf>
    </products>
    <workSkill>Cooking</workSkill>
    <recipeUsers>
      <li>MMT_DryingRack</li>
      <li>MMT_ElectricDryingRack</li>
    </recipeUsers>
    <researchPrerequisite>MMT_Drugs_A1</researchPrerequisite>
  </RecipeDef>

  <!-- 草药茶：对照 HSK MakeHerbalTea（HSK 挂 Brewery/ElectricBrewery/meditable/DrugLab） -->
  <RecipeDef>
    <defName>MMT_MakeHerbalTea</defName>
    <label>泡制草药茶</label>
    <description>用野玫瑰、金丝桃与薄荷泡制草药茶。产出 6。</description>
    <jobString>正在泡制草药茶。</jobString>
    <workAmount>780</workAmount>
    <workSpeedStat>DrugCookingSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Drug</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_WildRose</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Hypericum</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_MintLeaves</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_WildRose</li>
        <li>MMT_Hypericum</li>
        <li>MMT_MintLeaves</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_HerbalTea>6</MMT_HerbalTea>
    </products>
    <skillRequirements>
      <Medicine>3</Medicine>
      <Cooking>5</Cooking>
    </skillRequirements>
    <workSkill>Medicine</workSkill>
    <recipeUsers>
      <li>Brewery</li>
      <li>DrugLab</li>
      <li>MMT_MedicalTable</li>
      <li>MMT_ElectricMedicalTable</li>
    </recipeUsers>
    <researchPrerequisite>DrugProduction</researchPrerequisite>
  </RecipeDef>

  <!-- 活性炭丸：对照 HSK MakeActivatedCarbon -->
  <RecipeDef>
    <defName>MMT_MakeActivatedCarbon</defName>
    <label>烧制活性炭丸</label>
    <description>将煤炭高温活化后制成解毒药丸。产出 9。</description>
    <jobString>正在烧制活性炭丸。</jobString>
    <workAmount>780</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Drug</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Charcoal</li>
            <li>MMT_Coal</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_Charcoal</li>
        <li>MMT_Coal</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_ActivatedCarbon>9</MMT_ActivatedCarbon>
    </products>
    <skillRequirements>
      <Medicine>3</Medicine>
      <Crafting>5</Crafting>
    </skillRequirements>
    <workSkill>Medicine</workSkill>
    <recipeUsers>
      <li>DrugLab</li>
      <li>MMT_MedicalTable</li>
      <li>MMT_ElectricMedicalTable</li>
    </recipeUsers>
    <researchPrerequisite>DrugProduction</researchPrerequisite>
  </RecipeDef>

  <!-- 狂暴草：对照 HSK Berserk_herb（recipeMaker 拆为独立配方） -->
  <RecipeDef>
    <defName>MMT_MakeBerserkHerb</defName>
    <label>配制狂暴草</label>
    <description>将草药根与精神叶混合研磨，配制战斗用的狂暴草。产出 1。</description>
    <jobString>正在配制狂暴草。</jobString>
    <workAmount>200</workAmount>
    <workSpeedStat>DrugCookingSpeed</workSpeedStat>
    <soundWorking>Recipe_Drug</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MedicineHerbal</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>PsychoidLeaves</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MedicineHerbal</li>
        <li>PsychoidLeaves</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_BerserkHerb>1</MMT_BerserkHerb>
    </products>
    <recipeUsers>
      <li>CraftingSpot</li>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>PsychoidBrewing</researchPrerequisite>
  </RecipeDef>

  <!-- 美沙酮：对照 HSK Methadone -->
  <RecipeDef>
    <defName>MMT_MakeMethadone</defName>
    <label>合成美沙酮</label>
    <description>用中性胺合成戒断替代药物美沙酮。产出 1。</description>
    <jobString>正在合成美沙酮。</jobString>
    <workAmount>500</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <soundWorking>Recipe_Drug</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Methadone>1</MMT_Methadone>
    </products>
    <workSkill>Medicine</workSkill>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <researchPrerequisite>PenoxycylineProduction</researchPrerequisite>
  </RecipeDef>

  <!-- 止痛药：对照 HSK VG_Ibuprofen（recipeMaker 拆为独立配方） -->
