<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 超频模块：材料对齐原贴靠建筑造价（钢+机构件+工业零件），挂电动装配台；需研究"自动机增效" -->
  <RecipeDef>
    <defName>MMT_MakeOverclockModule</defName>
    <label>组装超频模块</label>
    <description>组装自动加工机组的超频驱动模块，安装后使设备处理速度提高 10%。产出 1。</description>
    <jobString>正在组装超频模块。</jobString>
    <workAmount>1500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>25</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Mechanism</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>MMT_Mechanism</li>
        <li>ComponentIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_OverclockModule>1</MMT_OverclockModule>
    </products>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_AutoBoost</researchPrerequisite>
  </RecipeDef>

  <!-- 并行模块：材料对齐原贴靠建筑造价，挂电动装配台；需研究"自动机增效" -->
  <RecipeDef>
    <defName>MMT_MakeParallelModule</defName>
    <label>组装并行模块</label>
    <description>组装自动加工机组的并行加工扩展模块，安装后使设备每轮多消耗一份输入并多产出一份产物。产出 1。</description>
    <jobString>正在组装并行模块。</jobString>
    <workAmount>1800</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>30</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Mechanism</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>MMT_Mechanism</li>
        <li>ComponentIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_ParallelModule>1</MMT_ParallelModule>
    </products>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_AutoBoost</researchPrerequisite>
  </RecipeDef>
</Defs>
