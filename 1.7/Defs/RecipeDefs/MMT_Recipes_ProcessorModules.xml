<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 超频模块：材料对齐原贴靠建筑造价（钢+机构件+工业零件），挂电动装配台；需研究"自动机增效" -->
  <RecipeDef>
    <defName>MMT_MakeOverclockModule</defName>
    <label>组装超频模块</label>
    <description>组装自动加工机组的超频驱动模块，安装后使设备处理速度提高 10%。产出 1。</description>
    <jobString>正在组装超频模块。</jobString>
    <workAmount>1500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>25</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Mechanism</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>MMT_Mechanism</li>
        <li>ComponentIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_OverclockModule>1</MMT_OverclockModule>
    </products>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_AutoBoost</researchPrerequisite>
  </RecipeDef>

  <!-- 并行模块：后期昂贵模块，材料跨高级合金（稀有合金类）/零件（先进机械组件）/电子（集成电路）/石化（塑料）四条链；挂电动装配台；需研究"自动机增效" -->
  <RecipeDef>
    <defName>MMT_MakeParallelModule</defName>
    <label>组装并行模块</label>
    <description>组装自动加工机组的并行加工扩展模块，安装后使设备每轮多消耗一份输入并多产出一份产物。产出 1。</description>
    <jobString>正在组装并行模块。</jobString>
    <workAmount>3600</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MMT_RARBar</li>
          </categories>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_AdvMechanism</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_IntegratedCircuit</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Plastic</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_AdvMechanism</li>
        <li>MMT_IntegratedCircuit</li>
        <li>MMT_Plastic</li>
      </thingDefs>
      <categories>
        <li>MMT_RARBar</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <MMT_ParallelModule>1</MMT_ParallelModule>
    </products>
    <skillRequirements>
      <Crafting>10</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_AutoBoost</researchPrerequisite>
  </RecipeDef>

  <!-- 增值模块：后期昂贵模块，材料跨高级合金（稀有合金类）/零件（先进机械组件）/电子（集成电路）/石化（合成橡胶）/贵金属（黄金）五条链；挂电动装配台；需研究"自动机增效" -->
  <RecipeDef>
    <defName>MMT_MakeYieldModule</defName>
    <label>组装增值模块</label>
    <description>组装自动加工设备的产出增值控制模块，安装后使设备产物增加（幅度因设备而异）；安装进折跃传送台则使传送次数上限 +1。产出 1。</description>
    <jobString>正在组装增值模块。</jobString>
    <workAmount>4200</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MMT_RARBar</li>
          </categories>
        </filter>
        <count>8</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_AdvMechanism</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_IntegratedCircuit</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Rubber</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Gold</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_AdvMechanism</li>
        <li>MMT_IntegratedCircuit</li>
        <li>MMT_Rubber</li>
        <li>Gold</li>
      </thingDefs>
      <categories>
        <li>MMT_RARBar</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <MMT_YieldModule>1</MMT_YieldModule>
    </products>
    <skillRequirements>
      <Crafting>10</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_AutoBoost</researchPrerequisite>
  </RecipeDef>
</Defs>
