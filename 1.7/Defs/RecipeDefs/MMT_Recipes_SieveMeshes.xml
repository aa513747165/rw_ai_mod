<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 木滤网：木+布手工编织，无研究（与手动筛子同期，切石时代即可用） -->
  <RecipeDef>
    <defName>MMT_MakeMeshWood</defName>
    <label>编织木滤网</label>
    <description>用木材和布编织粗孔筛网，安装进筛子后只能筛出常见基础矿石。产出 1。</description>
    <jobString>正在编织木滤网。</jobString>
    <workAmount>800</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Tailor</effectWorking>
    <soundWorking>Recipe_Tailor</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </filter>
        <count>40</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Cloth</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>WoodLog</li>
        <li>Cloth</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_MeshWood>1</MMT_MeshWood>
    </products>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <recipeUsers>
      <li>CraftingSpot</li>
    </recipeUsers>
  </RecipeDef>

  <!-- 铁滤网：钢丝编织，材料钢铁与"基础金属冶炼"（Medieval）同期可得 -->
  <RecipeDef>
    <defName>MMT_MakeMeshIron</defName>
    <label>编织铁滤网</label>
    <description>用钢丝编织中孔筛网，安装进筛子后只能筛出中等颗粒的金属矿粒与化工原料。产出 1。</description>
    <jobString>正在编织铁滤网。</jobString>
    <workAmount>1500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>25</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_MeshIron>1</MMT_MeshIron>
    </products>
    <skillRequirements>
      <Crafting>3</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_BasicMetalworking</researchPrerequisite>
    <recipeUsers>
      <li>CraftingSpot</li>
    </recipeUsers>
  </RecipeDef>

  <!-- 精密滤网：强化玻璃框+金丝编织，高级零部件可用钢锭制造（不经钛铁矿）；需研究"精密筛分" -->
  <RecipeDef>
    <defName>MMT_MakeMeshFine</defName>
    <label>编织精密滤网</label>
    <description>用强化玻璃框与金丝编织致密筛网，安装进筛子后只能筛出稀有重矿粒。产出 1。</description>
    <jobString>正在编织精密滤网。</jobString>
    <workAmount>4000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_ReinforcedGlass</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Gold</li>
          </thingDefs>
        </filter>
        <count>8</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_ReinforcedGlass</li>
        <li>Gold</li>
        <li>ComponentSpacer</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_MeshFine>1</MMT_MeshFine>
    </products>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_PrecisionSifting</researchPrerequisite>
    <recipeUsers>
      <li>FabricationBench</li>
    </recipeUsers>
  </RecipeDef>
</Defs>
