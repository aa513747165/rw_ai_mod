<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>MMT_AssembleElectronicParts_Electric</defName>
    <label>电装电子元件</label>
    <description>用电子电动工作台将铜锭、玻璃和硅组装成电子元件。产出 5。</description>
    <jobString>正在电装电子元件。</jobString>
    <workAmount>1600</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_CopperBar</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Glass</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Silicon</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_CopperBar</li>
        <li>MMT_Glass</li>
        <li>MMT_Silicon</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_ElectronicParts>5</MMT_ElectronicParts>
    </products>
    <skillRequirements>
      <Crafting>10</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_ElectricElectronics</researchPrerequisite>
  </RecipeDef>

  <RecipeDef>
    <defName>MMT_AssembleIC_Electric</defName>
