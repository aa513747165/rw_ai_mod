<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>MMT_DistillPolymers_Hand</defName>
    <label>蒸馏聚合物</label>
    <description>加热蒸馏原油，提取聚合物原料。产出 15。</description>
    <jobString>正在蒸馏聚合物。</jobString>
    <workAmount>1500</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_CrudeOil</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_CrudeOil</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Polymers>15</MMT_Polymers>
    </products>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_BasicPetrochemistry</researchPrerequisite>
  </RecipeDef>

