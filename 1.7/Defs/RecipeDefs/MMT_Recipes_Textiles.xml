<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- B8 织物配方：对照 HSK Recipes_Materials_Cloth.xml（HSK 的 TailoringSpeed 为 SK 自定义，映射原版 GeneralLaborSpeed）；挂 MMT_Loom recipes 列表 -->

  <!-- 布：对照 HSK MakeCloth -->
  <RecipeDef>
    <defName>MMT_MakeCloth</defName>
    <label>纺织布</label>
    <description>将原棉纺成布。产出 20。</description>
    <jobString>正在纺织布。</jobString>
    <workAmount>600</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Tailor</effectWorking>
    <soundWorking>Recipe_Tailor</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_RawCotton</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_RawCotton</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Cloth>20</Cloth>
    </products>
    <skillRequirements>
      <Crafting>2</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>ComplexClothing</researchPrerequisite>
  </RecipeDef>

