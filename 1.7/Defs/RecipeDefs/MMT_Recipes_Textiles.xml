  <!-- 绘画用品（花卉直用）：对照 HSK CookPaint；木本输入显式列举木制品（原版无木本物类别） -->
  <RecipeDef>
    <defName>MMT_CookPaint</defName>
    <label>调制绘画用品（花卉）</label>
    <description>以花卉颜料与木制画具调配绘画用品。产出 1。</description>
    <jobString>正在调制绘画用品。</jobString>
    <workAmount>550</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <recipeUsers>
      <li>ElectricStove</li>
      <li>FueledStove</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_WildRose</li>
            <li>MMT_Hypericum</li>
            <li>MMT_MintLeaves</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>WoodLog</li>
            <li>MMT_WoodPlank</li>
            <li>MMT_Bamboo</li>
            <li>MMT_BambooPlank</li>
            <li>MMT_RedWoodLog</li>
            <li>MMT_RedWoodPlank</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_WildRose</li>
        <li>MMT_Hypericum</li>
        <li>MMT_MintLeaves</li>
        <li>WoodLog</li>
        <li>MMT_WoodPlank</li>
        <li>MMT_Bamboo</li>
        <li>MMT_BambooPlank</li>
        <li>MMT_RedWoodLog</li>
        <li>MMT_RedWoodPlank</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_PaintingSupplies>1</MMT_PaintingSupplies>
    </products>
    <skillRequirements>
      <Crafting>5</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_ArtSupplies</researchPrerequisite>
  </RecipeDef>

