  <!-- 灵能结晶：化工全合成（MMT 无 HSK 的 desiri 动物来源），中间体 -->
  <RecipeDef>
    <defName>MMT_MakeSynchroCrystal</defName>
    <label>合成灵能结晶</label>
    <description>以硫酸盐与表面活性剂催化精神叶提取物，结晶制取灵能结晶。产出 2。</description>
    <jobString>正在合成灵能结晶。</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Drug</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Sulphates</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Surfactant</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>PsychoidLeaves</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_Sulphates</li>
        <li>MMT_Surfactant</li>
        <li>PsychoidLeaves</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_SynchroCrystal>2</MMT_SynchroCrystal>
    </products>
    <skillRequirements>
      <Medicine>8</Medicine>
      <Crafting>4</Crafting>
    </skillRequirements>
    <workSkill>Medicine</workSkill>
    <recipeUsers>
      <li>DrugLab</li>
      <li>MMT_ElectricMedicalTable</li>
      <li>MMT_AdvDrugLab</li>
    </recipeUsers>
    <researchPrerequisite>MMT_Drugs_D1</researchPrerequisite>
