<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 动力电池：对照 HSK MakeHexcell（挂电动电子台） -->
  <RecipeDef>
    <defName>MMT_MakeHexcell</defName>
    <label>制造动力电池</label>
    <description>制造紧凑型储能动力电池。产出 10。</description>
    <jobString>正在制造动力电池。</jobString>
    <workAmount>6000</workAmount>
    <workSpeedStat>MMT_ElectronicCraftingSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_MagneticMaterial</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>MMT_HCMBar</li>
          </categories>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Microchip</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_MagneticMaterial</li>
        <li>MMT_Microchip</li>
      </thingDefs>
      <categories>
        <li>MMT_HCMBar</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <MMT_Hexcell>10</MMT_Hexcell>
    </products>
    <skillRequirements>
      <Crafting>14</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_Robotics1</researchPrerequisite>
  </RecipeDef>

  <!-- 机器人部件：对照 HSK MakeRobotParts（挂电动电子台） -->
  <RecipeDef>
    <defName>MMT_MakeRobotParts</defName>
    <label>制造机器人部件</label>
    <description>制造机器人所需的精密部件组。产出 25。</description>
    <jobString>正在制造机器人部件。</jobString>
    <workAmount>8000</workAmount>
    <workSpeedStat>MMT_ElectronicCraftingSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MMT_USLDBar</li>
          </categories>
        </filter>
        <count>60</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_AdvMechanism</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_AdvMechanism</li>
      </thingDefs>
      <categories>
        <li>MMT_USLDBar</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <MMT_RobotParts>25</MMT_RobotParts>
    </products>
    <skillRequirements>
      <Crafting>15</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_Robotics1</researchPrerequisite>
  </RecipeDef>

  <!-- 矿物声纳模块：对照 HSK MakeMineralSonarModule（ComponentAdvanced 映射原版太空零件；挂电动装配台+电动电子台） -->
  <RecipeDef>
    <defName>MMT_MakeMineralSonarModule</defName>
    <label>组装矿物声纳模块</label>
    <description>以金属合金为封装外壳、电子元件为计算模块，组装矿物声纳模块。产出 1。</description>
    <jobString>正在组装矿物声纳模块。</jobString>
    <workAmount>4800</workAmount>
    <workSpeedStat>MMT_ElectronicCraftingSpeed</workSpeedStat>
    <effectWorking>ButcherMechanoid</effectWorking>
    <soundWorking>Recipe_ButcherCorpseMechanoid</soundWorking>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MMT_MetallicBar</li>
          </categories>
        </filter>
        <count>25</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_ElectronicParts</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Mechanism</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ComponentSpacer</li>
        <li>MMT_ElectronicParts</li>
        <li>MMT_Mechanism</li>
      </thingDefs>
      <categories>
        <li>MMT_MetallicBar</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <MMT_MineralSonarModule>1</MMT_MineralSonarModule>
    </products>
    <skillRequirements>
      <Crafting>10</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_AdvancedComponents</researchPrerequisite>
  </RecipeDef>

  <!-- 拆解护盾腰带：对照 HSK DeconstructPersonalShield（回收站不可用，挂自动化装配器；产出映射原版太空零件） -->
  <RecipeDef>
    <defName>MMT_DeconstructPersonalShield</defName>
    <label>拆解护盾腰带</label>
    <description>拆解一条护盾腰带，回收精密零件。</description>
    <jobString>正在拆解护盾腰带。</jobString>
    <workAmount>1000</workAmount>
    <workSpeedStat>MMT_ElectronicCraftingSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <recipeUsers>
      <li>MMT_RoboticAssembler</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Apparel_ShieldBelt</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Apparel_ShieldBelt</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <ComponentSpacer>8</ComponentSpacer>
      <MMT_IntegratedCircuit>1</MMT_IntegratedCircuit>
    </products>
    <skillRequirements>
      <Crafting>10</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_AdvancedComponents</researchPrerequisite>
  </RecipeDef>
</Defs>
