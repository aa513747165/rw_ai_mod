<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 机械带宽模块配方：挂电子器件工作台（配方列表在建筑 Def 中追加），需研究"机械集控核心" -->
  <RecipeDef>
    <defName MayRequire="Ludeon.Rimworld.Biotech">MMT_MakeMechBandwidthModule</defName>
    <label>组装机械带宽模块</label>
    <description>组装机械集控核心的带宽扩展模块，安装后使机械带宽上限提高 20 点。产出 1。</description>
    <jobString>正在组装机械带宽模块。</jobString>
    <workAmount>4800</workAmount>
    <workSpeedStat>MMT_ElectronicCraftingSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Microchip</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_IntegratedCircuit</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_AdvMechanism</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Gold</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_Microchip</li>
        <li>MMT_IntegratedCircuit</li>
        <li>MMT_AdvMechanism</li>
        <li>Plasteel</li>
        <li>Gold</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_MechBandwidthModule>1</MMT_MechBandwidthModule>
    </products>
    <skillRequirements>
      <Crafting>10</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_MechControlHub</researchPrerequisite>
  </RecipeDef>

