<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 原材料 → 无机物：对照 HSK ConvertResourcesRaw（[ResourcesRaw]×300 → ×150） -->
  <RecipeDef>
    <defName>MMT_ConvertResourcesRaw</defName>
    <label>转化为无机物</label>
    <description>将各类原材料加工转化为无机物。产出 150。</description>
    <jobString>正在转化无机物。</jobString>
    <workAmount>10000</workAmount>
    <workSpeedStat>MMT_ElectronicCraftingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>ResourcesRaw</li>
          </categories>
        </filter>
        <count>300</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>ResourcesRaw</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <MMT_Matter>150</MMT_Matter>
    </products>
    <skillRequirements>
      <Crafting>15</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_MatterConversion1</researchPrerequisite>
  </RecipeDef>

