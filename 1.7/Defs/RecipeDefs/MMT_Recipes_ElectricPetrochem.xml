<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>MMT_DistillPolymers_Electric</defName>
    <label>电蒸馏聚合物</label>
    <description>用石化电动实验室蒸馏原油，更快地提取聚合物。产出 15。</description>
    <jobString>正在电蒸馏聚合物。</jobString>
    <workAmount>1000</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_CrudeOil</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_CrudeOil</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Polymers>15</MMT_Polymers>
    </products>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_ElectricPetrochemistry</researchPrerequisite>
  </RecipeDef>

