    <jobString>正在移除脑激励器。</jobString>
    <workAmount>3700</workAmount>
    <skillRequirements>
      <Medicine>6</Medicine>
    </skillRequirements>
    <researchPrerequisite>MMT_ProsthesisInstall_D3</researchPrerequisite>
    <removesHediff>MMT_BrainStimulator</removesHediff>
  </RecipeDef>

