    <defName>MMT_MakeBandagekitcrudeBulk</defName>
    <label>制作粗制绷带（×3）</label>
    <description>批量缝制粗制绷带。产出 3。</description>
    <jobString>正在批量制作粗制绷带。</jobString>
    <workAmount>450</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <soundWorking>Recipe_Tailor</soundWorking>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MMT_BTextiles</li>
          </categories>
        </filter>
        <count>21</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MMT_BTextiles</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <MMT_Bandagekitcrude>3</MMT_Bandagekitcrude>
    </products>
    <recipeUsers>
      <li>CraftingSpot</li>
      <li>MMT_MedicalTable</li>
    </recipeUsers>
    <skillRequirements>
      <Medicine>1</Medicine>
      <Crafting>1</Crafting>
    </skillRequirements>
    <workSkill>Medicine</workSkill>
    <researchPrerequisite>MMT_Medicine_A1</researchPrerequisite>
  </RecipeDef>

