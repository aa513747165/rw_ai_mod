      <li>
        <filter>
          <categories>
            <li>MMT_BTextiles</li>
          </categories>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MMT_BTextiles</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <MMT_Bandagekit>1</MMT_Bandagekit>
    </products>
    <recipeUsers>
      <li>MMT_MedicalTable</li>
      <li>MMT_ElectricMedicalTable</li>
    </recipeUsers>
    <skillRequirements>
      <Medicine>2</Medicine>
      <Crafting>2</Crafting>
    </skillRequirements>
    <workSkill>Medicine</workSkill>
    <researchPrerequisite>MMT_Medicine_A2</researchPrerequisite>
  </RecipeDef>

