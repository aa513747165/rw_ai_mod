<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 药品链医疗配方：对照 HSK Recipes_Medicine.xml/Recipes_Meals_Medicals.xml。
       HSK 资源映射：Paraffins→MMT_Paraffins、Plastic→MMT_Plastic、SyntheticFibers→MMT_SyntheticFibers、
       Microchips→MMT_Microchip、BiosyntheticMaterial→MMT_BiosyntheticMaterial、BTextiles→MMT_BTextiles、
       Ash→MMT_Ash；闪耀药中的 Synthread 为原版物品直接沿用 -->

  <!-- 粗制绷带：对照 HSK MakeBandagekitcrude -->
  <RecipeDef>
    <defName>MMT_MakeBandagekitcrude</defName>
    <label>制作粗制绷带</label>
    <description>用纺织品粗略缝制绷带，只能止血。产出 1。</description>
    <jobString>正在制作粗制绷带。</jobString>
    <workAmount>150</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <soundWorking>Recipe_Tailor</soundWorking>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MMT_BTextiles</li>
          </categories>
        </filter>
        <count>7</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MMT_BTextiles</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <MMT_Bandagekitcrude>1</MMT_Bandagekitcrude>
    </products>
    <recipeUsers>
      <li>CraftingSpot</li>
      <li>MMT_MedicalTable</li>
    </recipeUsers>
    <skillRequirements>
      <Medicine>1</Medicine>
      <Crafting>1</Crafting>
    </skillRequirements>
    <workSkill>Medicine</workSkill>
    <researchPrerequisite>MMT_Medicine_A1</researchPrerequisite>
  </RecipeDef>

  <!-- 粗制绷带（批量）：对照 HSK MakeBandagekitcrudeBulk -->
