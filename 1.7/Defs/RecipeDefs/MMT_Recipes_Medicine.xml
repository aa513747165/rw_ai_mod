  <!-- 草药包：对照 HSK MakeHerbMedicine -->
  <RecipeDef>
    <defName>MMT_MakeHerbMedicine</defName>
    <label>配制草药包</label>
    <description>将草药原料与草木灰调配成效力更强的草药包。产出 1。</description>
    <jobString>正在配制草药包。</jobString>
    <workAmount>500</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Drug</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MedicineHerbal</li>
          </thingDefs>
        </filter>
        <count>8</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Ash</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MedicineHerbal</li>
        <li>MMT_Ash</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_HerbMedicine>1</MMT_HerbMedicine>
    </products>
    <recipeUsers>
      <li>MMT_MedicalTable</li>
      <li>MMT_ElectricMedicalTable</li>
    </recipeUsers>
    <skillRequirements>
      <Medicine>5</Medicine>
    </skillRequirements>
    <workSkill>Medicine</workSkill>
    <researchPrerequisite>MMT_Medicine_B1</researchPrerequisite>
  </RecipeDef>

  <!-- 基础医药包（芦荟方）：对照 HSK MakeHerbmedicine -->
  <RecipeDef>
    <defName>MMT_MakeBasicMedicineKit</defName>
    <label>制作基础医药包（芦荟）</label>
    <description>用芦荟叶与绷带组合制作基础医药包。产出 1。</description>
    <jobString>正在制作基础医药包。</jobString>
    <workAmount>500</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <soundWorking>Recipe_Drug</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Aloe</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Bandagekit</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_Aloe</li>
        <li>MMT_Bandagekit</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_BasicMedicineKit>1</MMT_BasicMedicineKit>
    </products>
    <recipeUsers>
      <li>DrugLab</li>
      <li>MMT_MedicalTable</li>
      <li>MMT_ElectricMedicalTable</li>
    </recipeUsers>
    <skillRequirements>
      <Medicine>4</Medicine>
      <Crafting>2</Crafting>
    </skillRequirements>
    <workSkill>Medicine</workSkill>
    <researchPrerequisite>MMT_Medicine_B2</researchPrerequisite>
  </RecipeDef>

  <!-- 基础医药包（混合草药方）：对照 HSK MakeHerbmedicineMix -->
