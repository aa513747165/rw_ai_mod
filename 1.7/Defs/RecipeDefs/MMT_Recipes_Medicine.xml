    <workAmount>500</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <soundWorking>Recipe_Drug</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_WildRose</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Hypericum</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_MintLeaves</li>
            <li>MMT_Aloe</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Bandagekit</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_WildRose</li>
        <li>MMT_Hypericum</li>
        <li>MMT_MintLeaves</li>
        <li>MMT_Aloe</li>
        <li>MMT_Bandagekit</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_BasicMedicineKit>1</MMT_BasicMedicineKit>
    </products>
    <recipeUsers>
      <li>DrugLab</li>
      <li>MMT_MedicalTable</li>
      <li>MMT_ElectricMedicalTable</li>
    </recipeUsers>
    <skillRequirements>
      <Medicine>4</Medicine>
      <Crafting>2</Crafting>
    </skillRequirements>
    <workSkill>Medicine</workSkill>
    <researchPrerequisite>MMT_Medicine_B2</researchPrerequisite>
  </RecipeDef>

  <!-- 抗生素：对照 HSK BrewMedicalDrink（HSK 的 Yeast 为专有资源，MMT 只用原版啤酒花） -->
  <RecipeDef>
    <defName>MMT_BrewMedicalDrink</defName>
    <label>提炼抗生素</label>
    <description>将草药根与啤酒花浓缩提炼为抗生素。产出 1。</description>
    <jobString>正在提炼抗生素。</jobString>
    <workAmount>1000</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Drug</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MedicineHerbal</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>RawHops</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MedicineHerbal</li>
        <li>RawHops</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_MedicalDrink>1</MMT_MedicalDrink>
    </products>
    <recipeUsers>
      <li>MMT_ElectricMedicalTable</li>
    </recipeUsers>
    <skillRequirements>
      <Medicine>10</Medicine>
    </skillRequirements>
    <workSkill>Medicine</workSkill>
    <researchPrerequisite>PenoxycylineProduction</researchPrerequisite>
  </RecipeDef>

  <!-- 工业医药：对照 HSK makemedicine（产物为原版 MedicineIndustrial，原版配方由 patch 隐藏） -->
  <RecipeDef>
    <defName>MMT_MakeMedicineIndustrial</defName>
    <label>制作医药</label>
    <description>用草药原料、中性胺与石化材料组装工业医药包。产出 1。</description>
    <jobString>正在制作医药。</jobString>
    <workAmount>800</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Drug</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MedicineHerbal</li>
          </thingDefs>
        </filter>
        <count>6</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Paraffins</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_SyntheticFibers</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Plastic</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Neutroamine</li>
        <li>MedicineHerbal</li>
        <li>MMT_Paraffins</li>
        <li>MMT_SyntheticFibers</li>
        <li>MMT_Plastic</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MedicineIndustrial>1</MedicineIndustrial>
    </products>
    <recipeUsers>
      <li>MMT_ElectricMedicalTable</li>
    </recipeUsers>
    <skillRequirements>
      <Medicine>10</Medicine>
    </skillRequirements>
    <workSkill>Medicine</workSkill>
    <researchPrerequisite>MedicineProduction</researchPrerequisite>
  </RecipeDef>

  <!-- 闪耀世界医药：对照 HSK makeadvmedicine（产物为原版 MedicineUltratech，原版本不可制作） -->
  <RecipeDef>
    <defName>MMT_MakeMedicineUltratech</defName>
    <label>制作闪耀世界医药</label>
    <description>融合微芯片、抗生素与生物合成材料，仿制闪耀世界的先进医药。产出 1。</description>
    <jobString>正在制作闪耀世界医药。</jobString>
    <workAmount>1400</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Drug</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Microchip</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_MedicalDrink</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_BiosyntheticMaterial</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Paraffins</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Synthread</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Plastic</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_Microchip</li>
        <li>MMT_MedicalDrink</li>
        <li>MMT_BiosyntheticMaterial</li>
        <li>MMT_Paraffins</li>
        <li>Neutroamine</li>
        <li>Synthread</li>
        <li>MMT_Plastic</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MedicineUltratech>1</MedicineUltratech>
    </products>
    <recipeUsers>
      <li>MMT_ElectricMedicalTable</li>
    </recipeUsers>
    <skillRequirements>
      <Medicine>15</Medicine>
    </skillRequirements>
    <workSkill>Medicine</workSkill>
    <researchPrerequisite>MMT_Medicine_D1</researchPrerequisite>
  </RecipeDef>
</Defs>
