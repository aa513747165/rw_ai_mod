<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>MMT_MixConcrete_Hand</defName>
    <label>搅拌混凝土</label>
    <description>将砂和碎石搅拌成混凝土。产出 15。</description>
    <jobString>正在搅拌混凝土。</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Sand</li>
          </thingDefs>
        </filter>
        <count>45</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_CrushedStone</li>
          </thingDefs>
        </filter>
        <count>30</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_Sand</li>
        <li>MMT_CrushedStone</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Concrete>15</MMT_Concrete>
    </products>
    <skillRequirements>
      <Crafting>3</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_ConcreteBasic</researchPrerequisite>
  </RecipeDef>

  <RecipeDef>
    <defName>MMT_MakeReinforcedConcrete_Hand</defName>
    <label>制作钢筋混凝土</label>
    <description>在混凝土中加入金属材料，制作钢筋混凝土。产出 8。</description>
    <jobString>正在制作钢筋混凝土。</jobString>
    <workAmount>1600</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>CutStone</effectWorking>
    <soundWorking>Recipe_MakeStoneBlocks</soundWorking>
    <recipeUsers>
      <li>TableStonecutter</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Metallic</li>
          </categories>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Concrete</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Metallic</li>
      </categories>
      <thingDefs>
        <li>MMT_Concrete</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_ReinforcedConcrete>8</MMT_ReinforcedConcrete>
    </products>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_ConcreteBasic</researchPrerequisite>
  </RecipeDef>

