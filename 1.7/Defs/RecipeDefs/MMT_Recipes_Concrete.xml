  <!-- 电动钢筋混凝土：对照 HSK MakeReinforcedConcrete_Electric；类别输入用 MMT_MetallicBar；挂电动装配台 -->
  <RecipeDef>
    <defName>MMT_MakeReinforcedConcrete_Electric</defName>
    <label>制作钢筋混凝土</label>
    <description>在混凝土中加入金属材料，制作钢筋混凝土。产出 16。</description>
    <jobString>正在制作钢筋混凝土。</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>CutStone</effectWorking>
    <soundWorking>Recipe_MakeStoneBlocks</soundWorking>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MMT_MetallicBar</li>
          </categories>
        </filter>
        <count>20</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Concrete</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MMT_MetallicBar</li>
      </categories>
      <thingDefs>
        <li>MMT_Concrete</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_ReinforcedConcrete>16</MMT_ReinforcedConcrete>
    </products>
    <skillRequirements>
      <Crafting>7</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
  </RecipeDef>

  <!-- 电动土堆：对照 HSK make_dirt_Electric -->
  <RecipeDef>
    <defName>MMT_MakeDirt_Electric</defName>
    <label>拌制土堆</label>
    <description>将沙和肥料拌成土堆。产出 30。</description>
    <jobString>正在拌制土堆。</jobString>
    <workAmount>1500</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Sand</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Fertilizer</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_Sand</li>
        <li>MMT_Fertilizer</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Dirt>30</MMT_Dirt>
    </products>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_ConcreteAdvanced</researchPrerequisite>
  </RecipeDef>
</Defs>
