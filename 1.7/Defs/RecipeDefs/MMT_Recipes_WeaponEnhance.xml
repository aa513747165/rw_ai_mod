  <RecipeDef>
    <defName>MMT_MakeQuenchOil</defName>
    <label>调配淬火油（3份）</label>
    <description>以兽脂与氧化化合燃料调配淬火油，是武器附魔模块的封装底料。产出 3 份。</description>
    <jobString>正在调配淬火油。</jobString>
    <workAmount>2400</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <soundWorking>Recipe_Drug</soundWorking>
    <ingredients>
      <li>
        <filter><thingDefs><li>MMT_Tallow</li></thingDefs></filter>
        <count>5</count>
      </li>
      <li>
        <filter><thingDefs><li>MMT_OxidizedChemfuel</li></thingDefs></filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_Tallow</li>
        <li>MMT_OxidizedChemfuel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_QuenchOil>3</MMT_QuenchOil>
    </products>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisites>
      <li>MMT_WeaponEnchantment</li>
    </researchPrerequisites>
  </RecipeDef>

