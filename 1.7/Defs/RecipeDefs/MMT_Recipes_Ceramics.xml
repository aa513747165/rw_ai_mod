<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>MMT_MakeCeramics</defName>
    <label>烧制陶瓷（10个）</label>
    <description>将软粘土和玻璃生料烧制成釉陶瓷。产出 10。</description>
    <jobString>正在烧制陶瓷。</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_SoftClay</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_GlassBatch</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_SoftClay</li>
        <li>MMT_GlassBatch</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Ceramics>10</MMT_Ceramics>
    </products>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_BasicMetalworking</researchPrerequisite>
  </RecipeDef>

  <RecipeDef>
    <defName>MMT_MakeClayBricks</defName>
    <label>烧制粘土砖（15个）</label>
    <description>将软粘土烧制成粘土砖。产出 15。</description>
    <jobString>正在烧制粘土砖。</jobString>
    <workAmount>800</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_SoftClay</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_SoftClay</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_ClayBrick>15</MMT_ClayBrick>
    </products>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_BasicMetalworking</researchPrerequisite>
  </RecipeDef>

  <RecipeDef>
    <defName>MMT_BurnThings</defName>
    <label>焚烧材料</label>
    <description>焚烧木材、织物和皮革获取灰烬。产出 3。</description>
    <jobString>正在焚烧材料。</jobString>
    <workAmount>400</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <requiredGiverWorkType>Hauling</requiredGiverWorkType>
    <effectWorking>Cremate</effectWorking>
    <soundWorking>Recipe_Cremate</soundWorking>
    <recipeUsers>
      <li>Campfire</li>
      <li>ElectricCrematorium</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Textiles</li>
            <li>Leathers</li>
          </categories>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Textiles</li>
        <li>Leathers</li>
      </categories>
      <thingDefs>
        <li>WoodLog</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Ash>3</MMT_Ash>
    </products>
  </RecipeDef>

  <RecipeDef>
    <defName>MMT_CremateCorpseCampfire</defName>
    <label>火化尸体</label>
    <description>在篝火上火化尸体，获得灰烬。产出 4。</description>
    <jobString>正在火化。</jobString>
    <workAmount>800</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cremate</effectWorking>
    <soundWorking>Recipe_Cremate</soundWorking>
    <autoStripCorpses>false</autoStripCorpses>
    <recipeUsers>
      <li>Campfire</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Corpses</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Corpses</li>
      </categories>
      <disallowedCategories>
        <li>CorpsesMechanoid</li>
      </disallowedCategories>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <thingDefs>
        <li>Corpse_Human</li>
      </thingDefs>
      <specialFiltersToAllow>
        <li>AllowCorpsesColonist</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">AllowCorpsesSlave</li>
        <li>AllowCorpsesStranger</li>
      </specialFiltersToAllow>
    </defaultIngredientFilter>
    <products>
      <MMT_Ash>4</MMT_Ash>
    </products>
  </RecipeDef>
</Defs>
