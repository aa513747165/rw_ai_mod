<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>MMT_MakeCeramics</defName>
    <label>烧制陶瓷（10个）</label>
    <description>将软粘土和玻璃生料烧制成釉陶瓷。产出 10。</description>
    <jobString>正在烧制陶瓷。</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_SoftClay</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_GlassBatch</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_SoftClay</li>
        <li>MMT_GlassBatch</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Ceramics>10</MMT_Ceramics>
    </products>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_BasicMetalworking</researchPrerequisite>
  </RecipeDef>

  <RecipeDef>
    <defName>MMT_MakeClayBricks</defName>
    <label>烧制粘土砖（15个）</label>
    <description>将软粘土烧制成粘土砖。产出 15。</description>
    <jobString>正在烧制粘土砖。</jobString>
    <workAmount>800</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_SoftClay</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_SoftClay</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_ClayBrick>15</MMT_ClayBrick>
    </products>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_BasicMetalworking</researchPrerequisite>
  </RecipeDef>
</Defs>
