<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>MMT_ExtractSilicon_Hand</defName>
    <label>提取硅</label>
    <description>熔炼砂以提取其中的硅。产出 5。</description>
    <jobString>正在提取硅。</jobString>
    <workAmount>1600</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Sand</li>
          </thingDefs>
        </filter>
        <count>50</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_Sand</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Silicon>5</MMT_Silicon>
    </products>
    <skillRequirements>
      <Crafting>5</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_BasicElectronics</researchPrerequisite>
  </RecipeDef>

  <RecipeDef>
    <defName>MMT_AssembleElectronicParts_Hand</defName>
    <label>组装电子元件</label>
    <description>将铜锭、玻璃和硅组装成电子元件。产出 5。</description>
    <jobString>正在组装电子元件。</jobString>
    <workAmount>2500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_CopperBar</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Glass</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Silicon</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_CopperBar</li>
        <li>MMT_Glass</li>
        <li>MMT_Silicon</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_ElectronicParts>5</MMT_ElectronicParts>
    </products>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_BasicElectronics</researchPrerequisite>
  </RecipeDef>

  <RecipeDef>
    <defName>MMT_AssembleIC_Hand</defName>
    <label>组装集成电路</label>
    <description>将硅、塑料、电子元件和金组装成集成电路。产出 5。</description>
    <jobString>正在组装集成电路。</jobString>
    <workAmount>3500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Silicon</li>
          </thingDefs>
        </filter>
        <count>25</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Plastic</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_ElectronicParts</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Gold</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_Silicon</li>
        <li>MMT_Plastic</li>
        <li>MMT_ElectronicParts</li>
        <li>Gold</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_IntegratedCircuit>5</MMT_IntegratedCircuit>
    </products>
    <skillRequirements>
      <Crafting>10</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_IntegratedCircuitTech</researchPrerequisite>
  </RecipeDef>

  <RecipeDef>
    <defName>MMT_AssembleMicrochip_Hand</defName>
    <label>组装微芯片</label>
    <description>将集成电路、碳材料和金组装成微芯片。产出 1。</description>
    <jobString>正在组装微芯片。</jobString>
    <workAmount>3500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_IntegratedCircuit</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Carbon</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Gold</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_IntegratedCircuit</li>
        <li>MMT_Carbon</li>
        <li>Gold</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Microchip>1</MMT_Microchip>
    </products>
    <skillRequirements>
      <Crafting>12</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_IntegratedCircuitTech</researchPrerequisite>
  </RecipeDef>
</Defs>
