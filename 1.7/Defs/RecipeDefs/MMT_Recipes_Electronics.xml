<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>MMT_ExtractSilicon_Hand</defName>
    <label>提取硅</label>
    <description>熔炼砂以提取其中的硅。产出 5。</description>
    <jobString>正在提取硅。</jobString>
    <workAmount>1600</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Sand</li>
          </thingDefs>
        </filter>
        <count>50</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_Sand</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Silicon>5</MMT_Silicon>
    </products>
    <skillRequirements>
      <Crafting>5</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_BasicElectronics</researchPrerequisite>
  </RecipeDef>

  <RecipeDef>
    <defName>MMT_AssembleElectronicParts_Hand</defName>
    <label>组装电子元件</label>
    <description>将铜锭、玻璃和硅组装成电子元件。产出 5。</description>
    <jobString>正在组装电子元件。</jobString>
    <workAmount>2500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_CopperBar</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Glass</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Silicon</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_CopperBar</li>
        <li>MMT_Glass</li>
        <li>MMT_Silicon</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_ElectronicParts>5</MMT_ElectronicParts>
    </products>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <researchPrerequisite>MMT_BasicElectronics</researchPrerequisite>
  </RecipeDef>
</Defs>
