<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 堆肥：对照 HSK MakeCompost；RottedMeat/RottedMush/Waste 为 HSK 专有，用原版类别+Hay+MMT_Ash 替代 -->
  <RecipeDef>
    <defName>MMT_MakeCompost</defName>
    <label>制作堆肥</label>
    <description>将有机废料堆成堆肥。产出 5。</description>
    <jobString>正在制作堆肥。</jobString>
    <workAmount>625</workAmount>
    <workSpeedStat>DrugCookingSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <recipeUsers>
      <li>ButcherSpot</li>
      <li>TableButcher</li>
      <li>FueledStove</li>
      <li>ElectricStove</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
            <li>AnimalProductRaw</li>
          </categories>
        </filter>
        <count>25</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
          <thingDefs>
            <li>Hay</li>
            <li>MMT_Ash</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>FoodRaw</li>
      </categories>
      <thingDefs>
        <li>Hay</li>
        <li>MMT_Ash</li>
      </thingDefs>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <thingDefs>
        <li>Hay</li>
        <li>MMT_Ash</li>
      </thingDefs>
    </defaultIngredientFilter>
    <products>
      <MMT_Compost>5</MMT_Compost>
    </products>
    <workSkill>Crafting</workSkill>
    <researchPrerequisite>MMT_AgricultureBasic</researchPrerequisite>
  </RecipeDef>

  <!-- 肥料：对照 HSK MakeFertilizer（HSK 中为无建筑挂载的死配方，MMT 挂到食物区建筑） -->
  <RecipeDef>
    <defName>MMT_MakeFertilizer</defName>
    <label>制作肥料</label>
    <description>将堆肥进一步加工为肥料。产出 10。</description>
    <jobString>正在制作肥料。</jobString>
    <workAmount>10000</workAmount>
    <workSpeedStat>DrugCookingSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <recipeUsers>
      <li>ButcherSpot</li>
      <li>TableButcher</li>
      <li>FueledStove</li>
      <li>ElectricStove</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Compost</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_Compost</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Fertilizer>10</MMT_Fertilizer>
    </products>
    <workSkill>Crafting</workSkill>
    <researchPrerequisite>MMT_AgricultureBasic</researchPrerequisite>
  </RecipeDef>

  <!-- 土堆（屠宰点小批量）：对照 HSK make_dirt -->
  <RecipeDef>
    <defName>MMT_MakeDirt</defName>
    <label>拌制土堆</label>
    <description>将沙和肥料拌成土堆。产出 3。</description>
    <jobString>正在拌制土堆。</jobString>
    <workAmount>300</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <recipeUsers>
      <li>ButcherSpot</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Sand</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Fertilizer</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_Sand</li>
        <li>MMT_Fertilizer</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Dirt>3</MMT_Dirt>
    </products>
    <workSkill>Crafting</workSkill>
    <researchPrerequisite>MMT_AgricultureBasic</researchPrerequisite>
  </RecipeDef>

  <!-- 土堆（手动搅拌器大批量）：对照 HSK make_dirt_hand；挂 MMT_ConcreteMixer 的 recipes 列表 -->
  <RecipeDef>
    <defName>MMT_MakeDirt_Hand</defName>
    <label>拌制土堆</label>
    <description>将沙和肥料拌成土堆。产出 30。</description>
    <jobString>正在拌制土堆。</jobString>
    <workAmount>3000</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Sand</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MMT_Fertilizer</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MMT_Sand</li>
        <li>MMT_Fertilizer</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MMT_Dirt>30</MMT_Dirt>
    </products>
    <workSkill>Crafting</workSkill>
    <researchPrerequisite>MMT_ConcreteBasic</researchPrerequisite>
  </RecipeDef>
</Defs>
