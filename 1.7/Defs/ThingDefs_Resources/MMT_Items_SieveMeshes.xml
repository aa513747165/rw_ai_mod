<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 滤网模块：安装在手动/电动/自动筛子内，筛分只在白名单矿石内抽取并按概率掺沙子；
       无滤网时维持全池随机。白名单与掺沙概率走 MeshFilterExtension（XML 可配置） -->
  <ThingDef ParentName="ResourceBase">
    <defName>MMT_MeshWood</defName>
    <label>木滤网</label>
    <description>木框绷麻绳的粗孔筛网，网眼大，只能拦住大颗粒的常见矿石碎屑，细小矿粒与沙砾一并漏走。安装进筛子后：只能筛出铁矿石、铜矿、锡矿、煤、盐、软粘土，每轮有 15% 概率只筛出沙子。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_MeshWood</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Wood_Drop</soundInteract>
    <soundDrop>Wood_Drop</soundDrop>
    <tickerType>Rare</tickerType>
    <techLevel>Neolithic</techLevel>
    <statBases>
      <MarketValue>25</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>1.0</Flammability>
      <Mass>1.5</Mass>
    </statBases>
    <thingCategories>
      <li>MMT_SieveMeshCat</li>
    </thingCategories>
    <stackLimit>10</stackLimit>
    <modExtensions>
      <li Class="MyModeTest.MeshFilterExtension">
        <tier>0</tier>
        <sandChance>0.15</sandChance>
        <ores>
          <li>MMT_IronOre</li>
          <li>MMT_CopperOre</li>
          <li>MMT_TinOre</li>
          <li>MMT_Coal</li>
          <li>MMT_Salt</li>
          <li>MMT_SoftClay</li>
        </ores>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>MMT_MeshIron</defName>
    <label>铁滤网</label>
    <description>钢丝编织的中孔筛网，网眼均匀，能拦住中等颗粒的金属矿粒。安装进筛子后：只能筛出铅矾矿、铝土矿、银矿、金矿、硫磺、硝石、原油，每轮有 5% 概率只筛出沙子。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_MeshIron</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <tickerType>Rare</tickerType>
    <techLevel>Medieval</techLevel>
    <statBases>
      <MarketValue>60</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>0.2</Flammability>
      <Mass>2</Mass>
    </statBases>
    <thingCategories>
      <li>MMT_SieveMeshCat</li>
    </thingCategories>
    <stackLimit>10</stackLimit>
    <modExtensions>
      <li Class="MyModeTest.MeshFilterExtension">
        <tier>1</tier>
        <sandChance>0.05</sandChance>
        <ores>
          <li>MMT_Anglesite</li>
          <li>MMT_AluminiumOre</li>
          <li>MMT_SilverOre</li>
          <li>MMT_GoldOre</li>
          <li>MMT_Sulfur</li>
          <li>MMT_Nitre</li>
          <li>MMT_CrudeOil</li>
        </ores>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>MMT_MeshFine</defName>
    <label>精密滤网</label>
    <description>强化玻璃框配金丝编织的致密筛网，网眼极细，能留住最细小的稀有重矿粒。安装进筛子后：只能筛出镍矿、钛铁矿、黑钨矿、铀、翡翠，不掺沙子。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_MeshFine</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <tickerType>Rare</tickerType>
    <techLevel>Spacer</techLevel>
    <statBases>
      <MarketValue>220</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>0.1</Flammability>
      <Mass>1.5</Mass>
    </statBases>
    <thingCategories>
      <li>MMT_SieveMeshCat</li>
    </thingCategories>
    <stackLimit>10</stackLimit>
    <modExtensions>
      <li Class="MyModeTest.MeshFilterExtension">
        <tier>2</tier>
        <ores>
          <li>MMT_NickelOre</li>
          <li>MMT_IlmeniteOre</li>
          <li>MMT_WolframiteOre</li>
          <li>Uranium</li>
          <li>Jade</li>
        </ores>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
