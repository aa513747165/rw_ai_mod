    <graphicData>
      <texPath>Things/Item/MMT/MMT_Crops/MMT_RedWoodLog</texPath>
      <color>(102,41,20)</color>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <soundInteract>Wood_Drop</soundInteract>
    <soundDrop>Wood_Drop</soundDrop>
    <tickerType>Rare</tickerType>
    <statBases>
      <MarketValue>2.0</MarketValue>
      <MaxHitPoints>165</MaxHitPoints>
      <Flammability>1</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <StuffPower_Armor_Blunt>0.8</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Sharp>0.7</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Heat>0.04</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>0.85</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>0.45</StuffPower_Insulation_Heat>
      <SharpDamageMultiplier>0.3</SharpDamageMultiplier>
      <BluntDamageMultiplier>0.8</BluntDamageMultiplier>
      <Mass>0.4</Mass>
    </statBases>
    <techLevel>Neolithic</techLevel>
    <stackLimit>300</stackLimit>
    <stuffProps>
      <stuffAdjective>红木</stuffAdjective>
      <categories>
        <li>Woody</li>
      </categories>
      <commonality>0.3</commonality>
      <color>(102,41,20)</color>
      <constructEffect>ConstructWood</constructEffect>
      <appearance>Planks</appearance>
      <soundImpactBullet>BulletImpact_Wood</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Wood</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Wood</soundMeleeHitBlunt>
      <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Wood</soundImpactMelee>
      <statOffsets>
        <Beauty>3</Beauty>
      </statOffsets>
      <statFactors>
        <MaxHitPoints>0.95</MaxHitPoints>
        <Flammability>0.8</Flammability>
        <Beauty>1.5</Beauty>
        <WorkToMake>0.8</WorkToMake>
        <WorkToBuild>0.8</WorkToBuild>
        <MeleeWeapon_CooldownMultiplier>1.15</MeleeWeapon_CooldownMultiplier>
        <MoveSpeed>0.8</MoveSpeed>
        <MarketValue>0.9</MarketValue>
        <BedRestEffectiveness>1.05</BedRestEffectiveness>
        <ImmunityGainSpeedFactor>0.95</ImmunityGainSpeedFactor>
        <WorkTableWorkSpeedFactor>0.65</WorkTableWorkSpeedFactor>
        <DoorOpenSpeed>1.2</DoorOpenSpeed>
        <Mass>0.55</Mass>
      </statFactors>
    </stuffProps>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <burnableByRecipe>True</burnableByRecipe>
  </ThingDef>

  <!-- 椰子：对照 HSK RawCoconut（FruitFoodRaw 为 SK 类别，归原版 PlantFoodRaw） -->
  <ThingDef ParentName="ResourceBase">
    <defName>MMT_RawCoconut</defName>
    <label>椰子</label>
    <description>椰子树结出的坚硬果实，可直接食用，也可作为化工原料。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_Crops/MMT_RawCoconut</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>6</MarketValue>
      <Nutrition>0.25</Nutrition>
      <Mass>0.5</Mass>
    </statBases>
    <tickerType>Rare</tickerType>
    <socialPropernessMatters>true</socialPropernessMatters>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>10</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <ingestible>
      <foodType>VegetableOrFruit</foodType>
      <preferability>RawTasty</preferability>
      <joy>0.08</joy>
      <joyKind>Gluttonous</joyKind>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>RawVegetable_Eat</ingestSound>
    </ingestible>
    <thingCategories>
      <li>PlantFoodRaw</li>
    </thingCategories>
  </ThingDef>

