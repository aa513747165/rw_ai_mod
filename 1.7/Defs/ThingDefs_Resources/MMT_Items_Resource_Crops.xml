  <!-- 竹节：对照 HSK Bamboo（HSK 的 Wooden 类别为 SK 自定义，归原版 ResourcesRaw；燃烧时长等 SK 字段已剔除） -->
  <ThingDef ParentName="ResourceBase">
    <defName>MMT_Bamboo</defName>
    <label>竹节</label>
    <description>竹子的茎秆，一种生长迅速的类木材料，可用于替代木材。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_Crops/MMT_Bamboo</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Wood_Drop</soundInteract>
    <soundDrop>Wood_Drop</soundDrop>
    <stackLimit>300</stackLimit>
    <tickerType>Rare</tickerType>
    <statBases>
      <MarketValue>2.0</MarketValue>
      <Flammability>5</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <StuffPower_Armor_Blunt>0.8</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Sharp>0.6</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Heat>0.04</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>0.9</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>0.5</StuffPower_Insulation_Heat>
      <Mass>0.25</Mass>
    </statBases>
    <techLevel>Neolithic</techLevel>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <burnableByRecipe>True</burnableByRecipe>
    <stuffProps>
      <categories>
        <li>Woody</li>
      </categories>
      <color>(204,170,128)</color>
      <constructEffect>ConstructWood</constructEffect>
      <appearance>Planks</appearance>
      <soundImpactBullet>BulletImpact_Wood</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Wood</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Wood</soundMeleeHitBlunt>
      <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Wood</soundImpactMelee>
      <stuffAdjective>竹制</stuffAdjective>
      <statOffsets>
        <Beauty>3</Beauty>
      </statOffsets>
      <statFactors>
        <MaxHitPoints>0.75</MaxHitPoints>
        <Flammability>1</Flammability>
        <Beauty>2.2</Beauty>
        <WorkToMake>0.5</WorkToMake>
        <WorkToBuild>0.5</WorkToBuild>
        <MeleeWeapon_CooldownMultiplier>1.05</MeleeWeapon_CooldownMultiplier>
        <MoveSpeed>1.0</MoveSpeed>
        <MarketValue>0.7</MarketValue>
        <BedRestEffectiveness>0.95</BedRestEffectiveness>
        <ImmunityGainSpeedFactor>1.05</ImmunityGainSpeedFactor>
        <WorkTableWorkSpeedFactor>0.5</WorkTableWorkSpeedFactor>
        <DoorOpenSpeed>1.4</DoorOpenSpeed>
        <Mass>0.3</Mass>
      </statFactors>
    </stuffProps>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- 红木：对照 HSK RedWoodLog（WoodLogs stuff 类别映射原版 Woody；SK 燃烧字段已剔除） -->
