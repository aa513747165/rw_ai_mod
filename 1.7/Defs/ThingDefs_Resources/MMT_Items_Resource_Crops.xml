<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- B8 作物收获资源：数值对齐 HSK（Items_Resource_Cloth_Raw/Crops/Crops_Fruits/Crops_Luxury/Wood.xml），已剔除 CE 专属字段与 SK 基类 -->

  <!-- 原棉：对照 HSK RawCotton（PlantMatter 为原版同名类别） -->
  <ThingDef ParentName="ResourceBase">
    <defName>MMT_RawCotton</defName>
    <label>原棉</label>
    <description>棉花植株收获的原始棉纤维，可在纺织机上纺成布。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_Crops/MMT_RawCotton</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Standard_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>300</stackLimit>
    <statBases>
      <MarketValue>1.5</MarketValue>
      <Flammability>2</Flammability>
      <DeteriorationRate>0.3</DeteriorationRate>
      <Mass>0.1</Mass>
    </statBases>
    <thingCategories>
      <li>PlantMatter</li>
    </thingCategories>
  </ThingDef>

