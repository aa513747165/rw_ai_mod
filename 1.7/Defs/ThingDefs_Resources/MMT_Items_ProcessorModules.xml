<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 超频模块：安装在自动研磨机/自动筛子/自动采石机/晶体培养舱内，每个使处理速度 +10%（间隔 / (1+0.1n)），
       单台最多 5 个；拆除设备时返还。需研究"自动机增效" -->
  <ThingDef ParentName="ResourceBase">
    <defName>MMT_OverclockModule</defName>
    <label>超频模块</label>
    <description>自动加工机组的超频驱动模块，由殖民者安装进自动研磨机、自动筛子、自动采石机或晶体培养舱内生效。每个使设备处理速度提高 10%，单台最多安装 5 个。拆除设备时返还。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_OverclockModule</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <tickerType>Rare</tickerType>
    <techLevel>Industrial</techLevel>
    <statBases>
      <MarketValue>180</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>0.2</Flammability>
      <Mass>2</Mass>
    </statBases>
    <thingCategories>
      <li>MMT_ElectronicsCat</li>
    </thingCategories>
    <stackLimit>10</stackLimit>
    <modExtensions>
      <li Class="MyModeTest.ModuleExtension">
        <slotKey>Overclock</slotKey>
        <effectReport>处理速度 +10%/个</effectReport>
        <effects>
          <li><key>SpeedFactor</key><valuePerItem>0.1</valuePerItem></li>
        </effects>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- 并行模块：安装在自动研磨机/自动筛子/晶体培养舱内，每个使生产线 +1 条（每轮多耗一份料多产一份产物），
       单台最多 3 个；拆除设备时返还。需研究"自动机增效" -->
  <ThingDef ParentName="ResourceBase">
    <defName>MMT_ParallelModule</defName>
    <label>并行模块</label>
    <description>自动加工机组的并行加工扩展模块，由殖民者安装进自动研磨机、自动筛子或晶体培养舱内生效。每个使设备每轮多消耗一份输入并多产出一份产物，研磨机/筛子最多 3 个，培养舱最多 5 个。拆除设备时返还。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_ParallelModule</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <tickerType>Rare</tickerType>
    <techLevel>Spacer</techLevel>
    <statBases>
      <MarketValue>1200</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>0.2</Flammability>
      <Mass>2.5</Mass>
    </statBases>
    <thingCategories>
      <li>MMT_ElectronicsCat</li>
    </thingCategories>
    <stackLimit>10</stackLimit>
    <modExtensions>
      <li Class="MyModeTest.ModuleExtension">
        <slotKey>Parallel</slotKey>
        <effectReport>生产线 +1 条/个</effectReport>
        <effects>
          <li><key>ExtraLanes</key><valuePerItem>1</valuePerItem></li>
        </effects>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- 增值模块：安装在自动采石机/自动研磨机/自动筛子内，每个使产物增加（幅度因设备而异：
       采石机 +10、研磨机 +5、筛子 +2），加工设备单台最多 5 个；也可安装进折跃传送台，
       每个使传送次数上限 +1（单台最多 10 个）；拆除设备时返还。
       需研究"自动机增效"。贴图为 HSK Synchronite（已授权） -->
  <ThingDef ParentName="ResourceBase">
    <defName>MMT_YieldModule</defName>
    <label>增值模块</label>
    <description>通用产出增值控制模块，由殖民者安装进设备内生效。安装进自动采石机、自动研磨机或自动筛子时每个使设备产物增加，幅度因设备而异：采石机单次产量 +10、研磨机每轮矿粉 +5、筛子每轮矿石 +2，单台最多安装 5 个；安装进折跃传送台时每个使传送次数上限提高 1 次，单台最多安装 10 个。拆除设备时返还。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_YieldModule</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <tickerType>Rare</tickerType>
    <techLevel>Spacer</techLevel>
    <statBases>
      <MarketValue>1300</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>0.2</Flammability>
      <Mass>2.5</Mass>
    </statBases>
    <thingCategories>
      <li>MMT_ElectronicsCat</li>
    </thingCategories>
    <stackLimit>10</stackLimit>
    <modExtensions>
      <li Class="MyModeTest.ModuleExtension">
        <slotKey>Yield</slotKey>
        <effectReport>产物增加/传送次数上限 +1（因设备而异）</effectReport>
        <effects>
          <li><key>YieldBonus</key><valuePerItem>1</valuePerItem></li>
          <li><key>ExtraTeleportCharges</key><valuePerItem>1</valuePerItem></li>
        </effects>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
