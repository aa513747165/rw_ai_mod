<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- B8 织物与杂项资源：数值对齐 HSK（Items_Resource_Cloth/Fuel/Stuff_Leather/Materials.xml）。HSK 类别映射：BTextiles→MMT_BTextiles，HTextiles→原版 Textiles，FuelCat→MMT_FuelCat，MiscManufactured→原版 Manufactured；SK stuff 类别 HF→原版 Fabric，Paint 剔除；已剔除 CE 专属字段 -->

  <!-- 亚麻布：对照 HSK Flaxcloth -->
  <ThingDef ParentName="ResourceBase">
    <defName>MMT_Flaxcloth</defName>
    <label>亚麻布</label>
    <description>为制衣设计的布料，柔软、轻盈且结实。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_Textiles/MMT_Flaxcloth</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(152,136,168)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <MarketValue>6</MarketValue>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <StuffPower_Armor_Blunt>0.97</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Sharp>1.08</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Heat>0.08</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>13</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>16</StuffPower_Insulation_Heat>
      <Mass>0.02</Mass>
    </statBases>
    <stackLimit>150</stackLimit>
    <techLevel>Medieval</techLevel>
    <stuffProps>
      <categories>
        <li>Fabric</li>
      </categories>
      <color>(152,136,168)</color>
      <statFactors>
        <MaxHitPoints>1.9</MaxHitPoints>
        <Beauty>1.8</Beauty>
        <WorkToMake>1.3</WorkToMake>
        <WorkToBuild>1.3</WorkToBuild>
        <MoveSpeed>0.95</MoveSpeed>
        <MarketValue>0.7</MarketValue>
        <BedRestEffectiveness>0.95</BedRestEffectiveness>
        <ImmunityGainSpeedFactor>1.15</ImmunityGainSpeedFactor>
        <Mass>0.47</Mass>
      </statFactors>
    </stuffProps>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <thingCategories>
      <li>MMT_BTextiles</li>
    </thingCategories>
    <burnableByRecipe>True</burnableByRecipe>
    <comps>
      <li>
        <compClass>CompColorable</compClass>
      </li>
    </comps>
  </ThingDef>

