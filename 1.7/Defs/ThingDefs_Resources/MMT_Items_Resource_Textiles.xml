      <StuffPower_Insulation_Heat>8</StuffPower_Insulation_Heat>
      <Mass>0.05</Mass>
    </statBases>
    <stuffProps>
      <color>(75,68,80)</color>
      <commonality>0.05</commonality>
      <statFactors>
        <MaxHitPoints>1.6</MaxHitPoints>
        <Flammability>0.5</Flammability>
        <Beauty>0.7</Beauty>
