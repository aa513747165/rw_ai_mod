<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- α阿尔法聚合物：对照 HSK AlphaPoly（stuff 类别仅留原版 Metallic，删 MeleePenetrationFactor） -->
  <ThingDef ParentName="ResourceBase">
    <defName>MMT_AlphaPoly</defName>
    <label>α阿尔法聚合物</label>
    <description>人工原子组装致密物质的第一代产物。这种人造稀有材料只能在高端量子加工台中组装，强度足以建造恒星色球层内的结构。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_AlphaPoly</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Silver_Drop</soundInteract>
    <soundDrop>Silver_Drop</soundDrop>
    <tradeability>None</tradeability>
    <stackLimit>75</stackLimit>
    <techLevel>Ultra</techLevel>
    <statBases>
      <MarketValue>45</MarketValue>
      <StuffPower_Armor_Blunt>0.7</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Sharp>1.6</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Heat>0.136</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>30</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>30</StuffPower_Insulation_Heat>
      <SharpDamageMultiplier>1.5</SharpDamageMultiplier>
      <BluntDamageMultiplier>1.5</BluntDamageMultiplier>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>0</Flammability>
      <Mass>0.15</Mass>
    </statBases>
    <useHitPoints>true</useHitPoints>
    <thingCategories>
      <li>MMT_USLDBar</li>
    </thingCategories>
    <stuffProps>
      <categories>
        <li>Metallic</li>
      </categories>
      <color>(100,60,100)</color>
      <commonality>0.05</commonality>
      <constructEffect>ConstructMetal</constructEffect>
      <soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
      <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Metal</soundImpactMelee>
      <stuffAdjective>α聚合物制</stuffAdjective>
      <appearance>Metal</appearance>
      <statOffsets>
        <Beauty>4</Beauty>
      </statOffsets>
      <statFactors>
        <MaxHitPoints>3.7</MaxHitPoints>
        <Flammability>0</Flammability>
        <Beauty>2</Beauty>
        <WorkToMake>3.0</WorkToMake>
        <WorkToBuild>3.0</WorkToBuild>
        <DoorOpenSpeed>1.2</DoorOpenSpeed>
        <MeleeWeapon_CooldownMultiplier>0.7</MeleeWeapon_CooldownMultiplier>
        <MoveSpeed>1.2</MoveSpeed>
        <MarketValue>3</MarketValue>
        <BedRestEffectiveness>1.4</BedRestEffectiveness>
        <ImmunityGainSpeedFactor>1.3</ImmunityGainSpeedFactor>
        <WorkTableWorkSpeedFactor>1.7</WorkTableWorkSpeedFactor>
        <Mass>0.6</Mass>
      </statFactors>
    </stuffProps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
  </ThingDef>

