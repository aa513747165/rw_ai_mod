        <WorkToMake>2</WorkToMake>
        <WorkToBuild>2</WorkToBuild>
        <DoorOpenSpeed>1.35</DoorOpenSpeed>
        <MoveSpeed>1.2</MoveSpeed>
        <MarketValue>0.7</MarketValue>
        <BedRestEffectiveness>0.55</BedRestEffectiveness>
