    <defName>MMT_BioferriteAlloy</defName>
    <label>生物铁合金</label>
    <description>活铁与铁熔炼而成的合金。活铁在合金状态下抑制了妨碍加工的特性，但未完全消除。该材料会与某些心灵流发生交互；合金形态下比纯活铁难点燃，但仍可燃。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_BioferriteAlloy</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <stackLimit>600</stackLimit>
    <techLevel>Industrial</techLevel>
    <statBases>
      <MarketValue>9</MarketValue>
      <Mass>0.35</Mass>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>0.5</Flammability>
      <StuffPower_Armor_Blunt>0.9</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Sharp>1.45</StuffPower_Armor_Sharp>
