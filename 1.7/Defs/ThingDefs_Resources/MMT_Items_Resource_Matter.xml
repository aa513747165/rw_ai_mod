<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 无机物：对照 HSK Matter（已剔除 CE 专属字段） -->
  <ThingDef ParentName="ResourceBase">
    <defName>MMT_Matter</defName>
    <label>无机物</label>
    <description>一罐无机物。可在无机物转化器中由各类原材料转化而成，也可还原为特定资源，或作为粒子对撞台的原料。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_Matter</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <techLevel>Spacer</techLevel>
    <statBases>
      <MarketValue>10</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>0</Flammability>
      <Mass>0.1</Mass>
    </statBases>
    <thingCategories>
      <li>MMT_SuperMaterialCat</li>
    </thingCategories>
    <stackLimit>150</stackLimit>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1.3</glowRadius>
        <glowColor>(0,0,217,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

  <!-- 反物质：对照 HSK Antimatter（剔除 MaxBurningTempCelsius/BurnDurationHours）；爆炸 comp 为原版 -->
  <ThingDef ParentName="ResourceBase">
    <defName>MMT_Antimatter</defName>
    <label>反物质</label>
    <description>以反原子形态存在的反物质是最难制备的材料之一。粒子加速器可以制造微量反粒子。极不稳定，请小心存放。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_Antimatter</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <tradeability>None</tradeability>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <techLevel>Ultra</techLevel>
    <statBases>
      <MaxHitPoints>5</MaxHitPoints>
      <MarketValue>120</MarketValue>
      <DeteriorationRate>0.01</DeteriorationRate>
      <Flammability>5</Flammability>
      <Mass>0.01</Mass>
    </statBases>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>1.5</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <explosiveExpandPerStackcount>0.5</explosiveExpandPerStackcount>
        <startWickHitPointsPercent>0.333</startWickHitPointsPercent>
        <wickTicks>
          <min>5</min>
          <max>10</max>
        </wickTicks>
      </li>
    </comps>
    <thingCategories>
      <li>MMT_SuperMaterialCat</li>
    </thingCategories>
  </ThingDef>

  <!-- 生物质：对照 HSK Biomatter（器官实验室不可用，来源改为化学台配方，见 B6 spec §4.6） -->
  <ThingDef ParentName="ResourceBase">
    <defName>MMT_Biomatter</defName>
    <label>生物质</label>
    <description>从尸体或生肉中提取的有机基质，是合成生物材料与生物电子元件的原料。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_Biomatter</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Standard_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>150</stackLimit>
    <tickerType>Rare</tickerType>
    <techLevel>Industrial</techLevel>
    <statBases>
      <MarketValue>10</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>2</Flammability>
      <Mass>0.1</Mass>
      <SellPriceFactor>0.20</SellPriceFactor>
    </statBases>
    <thingCategories>
      <li>MMT_SuperMaterialCat</li>
    </thingCategories>
    <tradeTags>
      <li>Exotic</li>
    </tradeTags>
  </ThingDef>

  <!-- 磁性材料：对照 HSK MagneticMaterial -->
  <ThingDef ParentName="ResourceBase">
    <defName>MMT_MagneticMaterial</defName>
    <label>磁性材料</label>
    <description>由多种强磁材料复合而成的先进材料。只有电磁物理专家级别的工艺才能制造。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_MagneticMaterial</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <tickerType>Rare</tickerType>
    <techLevel>Spacer</techLevel>
    <statBases>
      <MarketValue>110</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>0.1</Flammability>
      <Mass>0.05</Mass>
    </statBases>
    <thingCategories>
      <li>MMT_SuperMaterialCat</li>
    </thingCategories>
  </ThingDef>

  <!-- 生物合成材料：对照 HSK BiosyntheticMaterial（StackCount 多状态贴图指向目录） -->
  <ThingDef ParentName="ResourceBase">
    <defName>MMT_BiosyntheticMaterial</defName>
    <label>生物合成材料</label>
    <description>一种先进的高延展性生物合成材料。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_BiosyntheticMaterial</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <tickerType>Rare</tickerType>
    <techLevel>Spacer</techLevel>
    <statBases>
      <MarketValue>90</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>0.3</Flammability>
      <Mass>0.07</Mass>
    </statBases>
    <thingCategories>
      <li>MMT_SuperMaterialCat</li>
    </thingCategories>
  </ThingDef>

  <!-- 生物电子元件：对照 HSK BioMicrochips -->
  <ThingDef ParentName="ResourceBase">
    <defName>MMT_BioMicrochips</defName>
    <label>生物电子元件</label>
    <description>仿生微电子芯片。这些元件过于精密，无法手工制造，必须借助自动化装配器生产。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_BioMicrochips</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <stackLimit>25</stackLimit>
    <tickerType>Rare</tickerType>
    <techLevel>Spacer</techLevel>
    <statBases>
      <MarketValue>2100</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>1</Flammability>
      <Mass>0.4</Mass>
    </statBases>
    <thingCategories>
      <li>MMT_ElectronicsCat</li>
    </thingCategories>
    <tradeTags>
      <li>Exotic</li>
    </tradeTags>
  </ThingDef>
</Defs>
