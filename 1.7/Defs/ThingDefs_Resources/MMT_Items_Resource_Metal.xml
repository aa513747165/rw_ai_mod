  <ThingDef ParentName="ResourceBase">
    <defName>MMT_CopperBar</defName>
    <label>铜</label>
    <description>由铜矿石冶炼而成的铜锭，具有良好的导电性，可用于制造合金和建筑材料。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_Ingot/MMT_Ingot</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(160,115,45)</color>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <tickerType>Rare</tickerType>
    <statBases>
      <MarketValue>3.0</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>0</Flammability>
      <Mass>0.4</Mass>
    </statBases>
    <useHitPoints>true</useHitPoints>
    <stackLimit>300</stackLimit>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <stuffProps>
      <categories>
        <li>Metallic</li>
      </categories>
      <stuffAdjective>铜制</stuffAdjective>
      <color>(160,115,45)</color>
      <constructEffect>ConstructMetal</constructEffect>
      <statFactors>
        <MaxHitPoints>1.4</MaxHitPoints>
        <Flammability>0.1</Flammability>
        <WorkToMake>1.5</WorkToMake>
        <WorkToBuild>1.5</WorkToBuild>
      </statFactors>
    </stuffProps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
  </ThingDef>

