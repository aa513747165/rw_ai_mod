<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 熔火元素 ThinkTree（对照 Anomaly Devourer/Gorehulk 模式）：
       三个技能各挂一个 JobGiver_AIAbilityFight，按优先级排序——节点按序尝试，
       技能在冷却中则跳过落到下一节点；全部在冷却则退回近战普攻。
       Boss 在据点/袭击中始终处于敌对派系（虫巢派系，fleshType Insectoid 经 BossPool 解析），
       无需 ManhunterPermanent，因此技能 JobGiver 不会被精神状态树覆盖。
       优先级：火雨（长 CD 大杀器）> 召唤（维持炮灰数量）> 火柱（短 CD 主力输出）。 -->

  <ThinkTreeDef>
    <defName>MMT_FireElementalLord</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>LordDuty</treeDef>
        </li>
        <!-- 火雨：区域持续轰击 -->
        <li Class="JobGiver_AIAbilityFight">
          <targetAcquireRadius>65</targetAcquireRadius>
          <targetKeepRadius>72</targetKeepRadius>
          <ability>MMT_BossFire_FireRain</ability>
        </li>
        <!-- 召唤小火元素 -->
        <li Class="JobGiver_AIAbilityFight">
          <targetAcquireRadius>65</targetAcquireRadius>
          <targetKeepRadius>72</targetKeepRadius>
          <ability>MMT_BossFire_SummonLesser</ability>
        </li>
        <!-- 火柱：定点爆发 -->
        <li Class="JobGiver_AIAbilityFight">
          <targetAcquireRadius>65</targetAcquireRadius>
          <targetKeepRadius>72</targetKeepRadius>
          <ability>MMT_BossFire_FlamePillar</ability>
        </li>
        <!-- 近身反应与普攻 -->
        <li Class="JobGiver_ReactToCloseMeleeThreat">
          <maxDistance>2.9</maxDistance>
        </li>
        <li Class="JobGiver_AIFightEnemies">
          <targetAcquireRadius>65</targetAcquireRadius>
          <targetKeepRadius>72</targetKeepRadius>
        </li>
        <li Class="JobGiver_WanderAnywhere">
          <maxDanger>Deadly</maxDanger>
          <ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <!-- 小火元素：无技能，纯近战炮灰（限时召唤物，到期由 MMT_SummonTimer 移除）。 -->
  <ThinkTreeDef>
    <defName>MMT_FireElementalLesser</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>LordDuty</treeDef>
        </li>
        <li Class="JobGiver_ReactToCloseMeleeThreat">
          <maxDistance>2.9</maxDistance>
        </li>
        <li Class="JobGiver_AIFightEnemies">
          <targetAcquireRadius>65</targetAcquireRadius>
          <targetKeepRadius>72</targetKeepRadius>
        </li>
        <li Class="JobGiver_WanderAnywhere">
          <maxDanger>Deadly</maxDanger>
          <ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <!-- 共享 constant 树（对照 DevourerConstant）。 -->
  <ThinkTreeDef>
    <defName>MMT_FireElementalConstant</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
        <li Class="ThinkNode_ConditionalCanDoLordJobNow">
          <subNodes>
            <li Class="ThinkNode_Subtree">
              <treeDef>LordDutyConstant</treeDef>
            </li>
          </subNodes>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>
</Defs>
