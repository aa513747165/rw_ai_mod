<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 手动采石机作业：无限作业 toil，进度存 CompChunkDrill -->
  <JobDef>
    <defName>MMT_OperateChunkDrill</defName>
    <driverClass>MyModeTest.JobDriver_OperateChunkDrill</driverClass>
    <reportString>正在采石（TargetA）。</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <!-- 安装增效模块作业：取模块物品搬到自动设备装入槽位（JobDriver_InstallModule） -->
  <JobDef>
    <defName>MMT_InstallProcessorModule</defName>
    <driverClass>MyModeTest.JobDriver_InstallModule</driverClass>
    <reportString>正在安装增效模块（TargetA）。</reportString>
  </JobDef>

  <!-- 安装滤网作业：取滤网物品搬到筛子装入滤网槽（JobDriver_InstallSieveMesh） -->
  <JobDef>
    <defName>MMT_InstallSieveMesh</defName>
    <driverClass>MyModeTest.JobDriver_InstallSieveMesh</driverClass>
    <reportString>正在安装滤网（TargetA）。</reportString>
  </JobDef>

  <!-- 启动器官培养作业：搬原料到培养舱短工时启动，之后设备无人值守培养（JobDriver_OrganVatInitiate） -->
  <JobDef>
    <defName>MMT_InitiateOrganCulture</defName>
    <driverClass>MyModeTest.JobDriver_OrganVatInitiate</driverClass>
    <reportString>正在启动培养（TargetA）。</reportString>
  </JobDef>
</Defs>
