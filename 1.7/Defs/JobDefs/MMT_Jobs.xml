<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 手动采石机作业：无限作业 toil，进度存 CompChunkDrill -->
  <JobDef>
    <defName>MMT_OperateChunkDrill</defName>
    <driverClass>MyModeTest.JobDriver_OperateChunkDrill</driverClass>
    <reportString>正在采石（TargetA）。</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <!-- 安装增效模块作业：取模块物品搬到自动设备装入槽位（JobDriver_InstallModule） -->
  <JobDef>
    <defName>MMT_InstallProcessorModule</defName>
    <driverClass>MyModeTest.JobDriver_InstallModule</driverClass>
    <reportString>正在安装增效模块（TargetA）。</reportString>
  </JobDef>
</Defs>
