<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 无中生有链研究：解锁电动研磨机与电动筛子（手动版仅需切石） -->
  <ResearchProjectDef>
    <defName>MMT_OreSifting</defName>
    <label>矿粉筛选</label>
    <description>研究如何将岩块细磨成矿粉并淘洗出其中的矿物颗粒，建造电动研磨机与电动筛子。</description>
    <baseCost>800</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>MMT_ResearchTab</tab>
    <prerequisites>
      <li>Stonecutting</li>
      <li>Electricity</li>
    </prerequisites>
    <researchViewX>4.00</researchViewX>
    <researchViewY>2.00</researchViewY>
  </ResearchProjectDef>

  <!-- 自动化矿料处理：解锁自动研磨机/自动筛子/矿料进料口，实现无中生有闭环 -->
  <ResearchProjectDef>
    <defName>MMT_AutoOreProcessing</defName>
    <label>自动化矿料处理</label>
    <description>研究自动进料与连续加工技术，建造矿料进料口、自动研磨机与自动筛子，无需殖民者值守即可将岩块源源不断转化为矿石。</description>
    <baseCost>2000</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>MMT_ResearchTab</tab>
    <prerequisites>
      <li>MMT_OreSifting</li>
      <li>MicroelectronicsBasics</li>
    </prerequisites>
    <researchViewX>5.00</researchViewX>
    <researchViewY>3.00</researchViewY>
  </ResearchProjectDef>

  <!-- 自动机增效：解锁超频模块与并行模块，贴靠自动机叠加提速/增产 -->
  <ResearchProjectDef>
    <defName>MMT_AutoBoost</defName>
    <label>自动机增效</label>
    <description>研究自动加工机组的超频驱动与并行扩展技术，建造超频模块与并行模块，贴靠自动研磨机与自动筛子即可提升其处理速度或并行产出。</description>
    <baseCost>2500</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>MMT_ResearchTab</tab>
    <prerequisites>
      <li>MMT_AutoOreProcessing</li>
    </prerequisites>
    <researchViewX>6.00</researchViewX>
    <researchViewY>3.00</researchViewY>
  </ResearchProjectDef>
</Defs>
