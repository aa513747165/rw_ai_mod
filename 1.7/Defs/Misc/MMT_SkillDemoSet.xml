<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 技能框架演示技能集：第一~十九步全部 35 个演示条目（唯一数据源）。
       不进任何建筑/角色 Def；Dev 模式经 Debug「MMT 技能 → 赋予全部演示技能（选中小人）」
       由 MMTSkillDemoGrant 运行时注入 comp 到小人身上实测。
       沙袋人偶（友方/敌方）仅作技能靶子，不再携带技能。 -->
  <MyModeTest.MMTSkillDemoSetDef>
    <defName>MMT_SkillDemoSet</defName>
    <label>技能框架演示技能集</label>
    <demos>
      <li>
        <label>测试·友方回响</label>
        <iconPath>UI/RoM/Heal</iconPath>
        <radius>5</radius>
        <targetFriendly>true</targetFriendly>
      </li>
      <li>
        <label>测试·敌方回响</label>
        <iconPath>UI/RoM/MagicMissile</iconPath>
        <radius>5</radius>
        <targetFriendly>false</targetFriendly>
      </li>
      <li>
        <label>测试·单发火球术</label>
        <iconPath>Things/Projectile/LauncherShot</iconPath>
        <radius>0</radius>
        <demoType>singleShot</demoType>
        <castSeconds>1.5</castSeconds>
        <projectileDefName>MMT_Proj_SkillFireball</projectileDefName>
        <soundDefName>Shot_IncendiaryLauncher</soundDefName>
        <castBarColor>(1,0.45,0.15,0.5)</castBarColor>
      </li>
      <li>
        <label>测试·多方位火球术</label>
        <iconPath>Things/Projectile/LauncherShot</iconPath>
        <radius>0</radius>
        <demoType>funnelShot</demoType>
        <castSeconds>3</castSeconds>
        <projectileDefName>MMT_Proj_SkillFireball</projectileDefName>
        <soundDefName>Shot_IncendiaryLauncher</soundDefName>
        <castBarColor>(1,0.45,0.15,0.5)</castBarColor>
        <funnelCount>5</funnelCount>
        <ringRadius>1.8</ringRadius>
        <aimTicks>15</aimTicks>
      </li>
      <li>
        <label>测试·烈焰射线</label>
        <iconPath>Things/Projectile/ChargeLanceShot</iconPath>
        <radius>0</radius>
        <demoType>beam</demoType>
        <castSeconds>2</castSeconds>
        <soundDefName>ChargeLance_Fire</soundDefName>
        <castBarColor>(1,0.45,0.15,0.5)</castBarColor>
        <beamDurationSeconds>4</beamDurationSeconds>
        <beamRange>20</beamRange>
        <beamWidth>0.7</beamWidth>
        <beamTint>(1,0.55,0.15)</beamTint>
        <beamDamage>4</beamDamage>
        <beamDamageIntervalTicks>10</beamDamageIntervalTicks>
        <beamIgniteChance>0.1</beamIgniteChance>
      </li>
      <li>
        <label>测试·落雷</label>
        <iconPath>Things/Mote/ElectricalSpark</iconPath>
        <radius>0</radius>
        <targetFriendly>false</targetFriendly>
        <demoType>strike</demoType>
        <castSeconds>1.5</castSeconds>
        <castBarColor>(0.6,0.75,1,0.5)</castBarColor>
        <strikeRequireTarget>true</strikeRequireTarget>
        <strikeDamage>20</strikeDamage>
      </li>
      <li>
        <label>测试·雷暴</label>
        <iconPath>Things/Mote/ChainSparks</iconPath>
        <radius>5</radius>
        <targetFriendly>false</targetFriendly>
        <demoType>strike</demoType>
        <castSeconds>3</castSeconds>
        <castBarColor>(0.6,0.75,1,0.5)</castBarColor>
        <strikeCount>8</strikeCount>
        <strikeIntervalTicks>12</strikeIntervalTicks>
        <strikeDamage>10</strikeDamage>
      </li>
      <li>
        <label>测试·烈焰喷发</label>
        <iconPath>Things/Mote/BlastFlame</iconPath>
        <radius>0</radius>
        <targetFriendly>false</targetFriendly>
        <demoType>groundFire</demoType>
        <castSeconds>2</castSeconds>
        <castBarColor>(1,0.45,0.15,0.5)</castBarColor>
        <soundDefName>FireSpew_Resolve</soundDefName>
        <groundRequireTarget>true</groundRequireTarget>
        <groundDurationSeconds>6</groundDurationSeconds>
        <groundVisualScale>2.2</groundVisualScale>
        <groundDamage>6</groundDamage>
        <groundDamageIntervalTicks>10</groundDamageIntervalTicks>
        <groundIgnitePawnChance>0.3</groundIgnitePawnChance>
        <groundIgniteCellChance>0.05</groundIgniteCellChance>
      </li>
      <li>
        <label>测试·烈焰火海</label>
        <iconPath>Things/Mote/FireGlow</iconPath>
        <radius>5</radius>
        <targetFriendly>false</targetFriendly>
        <demoType>groundFire</demoType>
        <castSeconds>3</castSeconds>
        <castBarColor>(1,0.45,0.15,0.5)</castBarColor>
