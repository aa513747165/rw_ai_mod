        <groundDurationSeconds>5</groundDurationSeconds>
        <groundVisualScale>1.6</groundVisualScale>
        <groundDamage>2</groundDamage>
        <groundDamageIntervalTicks>15</groundDamageIntervalTicks>
        <groundDensity>0.85</groundDensity>
        <groundIgnitePawnChance>0.15</groundIgnitePawnChance>
        <groundIgniteCellChance>0.03</groundIgniteCellChance>
      </li>
      <li>
        <label>测试·守护光环</label>
        <iconPath>Things/Item/Equipment/Special/BroadshieldCore</iconPath>
        <radius>3</radius>
        <demoType>aura</demoType>
        <castSeconds>1.5</castSeconds>
        <castBarColor>(0.4,0.6,1,0.5)</castBarColor>
        <auraShieldMode>true</auraShieldMode>
        <auraDurationSeconds>12</auraDurationSeconds>
        <auraShieldHitPoints>200</auraShieldHitPoints>
      </li>
      <li>
        <label>测试·迅捷光环</label>
        <iconPath>UI/Icons/MoveSpeedBonus</iconPath>
        <radius>4</radius>
        <targetFriendly>true</targetFriendly>
        <demoType>aura</demoType>
        <castSeconds>2</castSeconds>
        <castBarColor>(0.3,1,0.3,0.5)</castBarColor>
        <auraDurationSeconds>15</auraDurationSeconds>
        <auraBuffDefName>MMT_AuraBuff_Swift</auraBuffDefName>
      </li>
      <li>
        <label>测试·迟缓光环</label>
        <iconPath>UI/Icons/MoveSpeedBonus</iconPath>
        <radius>4</radius>
        <targetFriendly>false</targetFriendly>
        <demoType>aura</demoType>
        <castSeconds>2</castSeconds>
        <castBarColor>(0.3,1,0.3,0.5)</castBarColor>
        <auraDurationSeconds>15</auraDurationSeconds>
        <auraBuffDefName>MMT_AuraDebuff_Slow</auraBuffDefName>
      </li>
      <li>
        <label>测试·迅捷祝福</label>
        <iconPath>UI/Icons/MoveSpeedBonus</iconPath>
        <radius>0</radius>
        <targetFriendly>true</targetFriendly>
        <demoType>bufffx</demoType>
        <castSeconds>1</castSeconds>
        <castBarColor>(0.3,1,0.3,0.5)</castBarColor>
        <buffRequireTarget>true</buffRequireTarget>
        <buffHediffDefName>MMT_Buff_Swift</buffHediffDefName>
      </li>
      <li>
        <label>测试·群体迅捷</label>
        <iconPath>UI/Icons/MoveSpeedBonus</iconPath>
        <radius>5</radius>
        <targetFriendly>true</targetFriendly>
        <demoType>bufffx</demoType>
        <castSeconds>2</castSeconds>
        <castBarColor>(0.3,1,0.3,0.5)</castBarColor>
        <buffHediffDefName>MMT_Buff_Swift</buffHediffDefName>
      </li>
      <li>
        <label>测试·迟缓诅咒</label>
        <iconPath>UI/Icons/MoveSpeedBonus</iconPath>
        <radius>0</radius>
        <targetFriendly>false</targetFriendly>
        <demoType>bufffx</demoType>
        <castSeconds>1</castSeconds>
        <castBarColor>(1,0.3,0.3,0.5)</castBarColor>
        <buffRequireTarget>true</buffRequireTarget>
        <buffHediffDefName>MMT_Debuff_Slow</buffHediffDefName>
        <buffIconTint>(1,0.3,0.3)</buffIconTint>
      </li>
      <li>
        <label>测试·群体迟缓</label>
        <iconPath>UI/Icons/MoveSpeedBonus</iconPath>
        <radius>5</radius>
        <targetFriendly>false</targetFriendly>
        <demoType>bufffx</demoType>
        <castSeconds>2</castSeconds>
        <castBarColor>(1,0.3,0.3,0.5)</castBarColor>
        <buffHediffDefName>MMT_Debuff_Slow</buffHediffDefName>
        <buffIconTint>(1,0.3,0.3)</buffIconTint>
      </li>
      <li>
        <label>测试·折跃</label>
        <iconPath>Things/Mote/MMT_BlinkFlash</iconPath>
        <radius>0</radius>
        <demoType>blink</demoType>
        <castSeconds>0.5</castSeconds>
        <castBarColor>(0.7,0.4,1,0.5)</castBarColor>
        <range>10</range>
      </li>
      <li>
        <label>测试·群体传送</label>
        <iconPath>Things/Mote/MMT_BlinkFlash</iconPath>
        <radius>4</radius>
        <targetFriendly>false</targetFriendly>
        <demoType>massTeleport</demoType>
        <castSeconds>1.5</castSeconds>
        <castBarColor>(0.7,0.4,1,0.5)</castBarColor>
        <range>24.9</range>
      </li>
      <li>
        <label>测试·冲锋</label>
        <iconPath>Things/Mote/MMT_DashTrail</iconPath>
        <radius>0</radius>
        <demoType>charge</demoType>
        <castSeconds>0.5</castSeconds>
        <castBarColor>(0.7,0.4,1,0.5)</castBarColor>
        <range>15</range>
        <chargeTicksPerCell>1.5</chargeTicksPerCell>
      </li>
      <li>
        <label>测试·跳跃</label>
        <iconPath>Things/Mote/MMT_BlinkFlash</iconPath>
        <radius>0</radius>
        <demoType>jump</demoType>
        <castSeconds>0.5</castSeconds>
        <castBarColor>(0.7,0.4,1,0.5)</castBarColor>
        <range>20</range>
        <jumpPeakHeight>3</jumpPeakHeight>
      </li>
      <li>
        <label>测试·雷球</label>
        <iconPath>Things/Mote/MMT_SummonOrb</iconPath>
        <radius>0</radius>
        <targetFriendly>false</targetFriendly>
        <demoType>summonOrb</demoType>
        <castSeconds>1.5</castSeconds>
        <castBarColor>(0.55,0.75,1,0.5)</castBarColor>
        <range>15</range>
        <summonDamage>8</summonDamage>
        <summonPulseRadius>2.5</summonPulseRadius>
        <summonPulseIntervalTicks>20</summonPulseIntervalTicks>
      </li>
      <li>
        <label>测试·追踪弹</label>
        <iconPath>Things/Mote/MMT_HomingBolt</iconPath>
        <radius>0</radius>
        <targetFriendly>false</targetFriendly>
        <demoType>summonHoming</demoType>
        <castSeconds>1</castSeconds>
        <castBarColor>(0.55,0.75,1,0.5)</castBarColor>
        <range>20</range>
        <summonDamage>20</summonDamage>
        <summonHomingExplosionRadius>1.5</summonHomingExplosionRadius>
        <summonHomingDurationSeconds>8</summonHomingDurationSeconds>
      </li>
      <li>
        <label>测试·动物召唤</label>
        <iconPath>Things/Mote/MMT_SummonPaw</iconPath>
        <radius>0</radius>
        <demoType>summonAnimal</demoType>
        <castSeconds>1</castSeconds>
        <castBarColor>(0.4,0.8,1,0.5)</castBarColor>
        <range>10</range>
        <summonAnimalKindDefName>Husky</summonAnimalKindDefName>
        <summonAnimalDurationSeconds>20</summonAnimalDurationSeconds>
      </li>
      <li>
        <label>测试·炮塔召唤</label>
        <iconPath>Things/Building/MMT_SummonTurret_Top</iconPath>
        <radius>0</radius>
        <demoType>summonTurret</demoType>
        <castSeconds>2</castSeconds>
        <castBarColor>(1,0.6,0.2,0.5)</castBarColor>
        <range>12</range>
        <summonTurretDurationSeconds>40</summonTurretDurationSeconds>
      </li>
      <!-- 第十一步：延时打击·陨石（预警圈 → 延迟 → 陨石轰击） -->
      <li>
        <label>测试·陨石术</label>
        <iconPath>Things/Mote/MMT_Meteor</iconPath>
        <radius>3</radius>
        <targetFriendly>false</targetFriendly>
        <demoType>delayedStrike</demoType>
        <castSeconds>2</castSeconds>
        <castBarColor>(1,0.4,0.2,0.5)</castBarColor>
        <meteorDelaySeconds>2</meteorDelaySeconds>
        <meteorFallTicks>25</meteorFallTicks>
        <meteorDamage>40</meteorDamage>
        <meteorExplosionRadius>3</meteorExplosionRadius>
        <meteorIgniteChance>0.3</meteorIgniteChance>
      </li>
      <!-- 第十二步：近战击退（锁定近身目标猛击并击飞） -->
      <li>
        <label>测试·猛击击退</label>
        <iconPath>Things/Mote/MMT_DashTrail</iconPath>
        <radius>0</radius>
        <targetFriendly>false</targetFriendly>
        <demoType>knockback</demoType>
        <castSeconds>0.5</castSeconds>
        <castBarColor>(0.9,0.7,0.3,0.5)</castBarColor>
        <range>3</range>
        <knockbackDamage>12</knockbackDamage>
        <knockbackCells>4</knockbackCells>
        <knockbackWallSlamDamage>8</knockbackWallSlamDamage>
      </li>
      <!-- 第十三步：连锁闪电（锁定首目标，自动弹跳） -->
      <li>
        <label>测试·连锁闪电</label>
        <iconPath>Things/Mote/ChainSparks</iconPath>
        <radius>0</radius>
        <targetFriendly>false</targetFriendly>
        <demoType>chainLightning</demoType>
        <castSeconds>1</castSeconds>
        <castBarColor>(0.6,0.8,1,0.5)</castBarColor>
        <range>20</range>
        <soundDefName>Thunder_OnMap</soundDefName>
        <chainBounceCount>4</chainBounceCount>
        <chainBounceRange>5</chainBounceRange>
        <chainDamage>15</chainDamage>
        <chainDamageFalloff>0.75</chainDamageFalloff>
      </li>
      <!-- 第十五步：锥形吐息·龙息（鼠标指定方向，持续喷吐） -->
      <li>
        <label>测试·龙息</label>
        <iconPath>Things/Mote/BlastFlame</iconPath>
        <radius>0</radius>
        <targetFriendly>false</targetFriendly>
        <demoType>breathCone</demoType>
        <castSeconds>1</castSeconds>
        <castBarColor>(1,0.45,0.15,0.5)</castBarColor>
        <range>12</range>
        <soundDefName>FireSpew_Resolve</soundDefName>
        <breathRange>8</breathRange>
        <breathHalfAngleDegrees>30</breathHalfAngleDegrees>
        <breathDurationSeconds>3</breathDurationSeconds>
        <breathDamage>3</breathDamage>
        <breathDamageIntervalTicks>10</breathDamageIntervalTicks>
        <breathIgniteChance>0.2</breathIgniteChance>
      </li>
      <!-- 第十六步：抛物线大火球（高空抛物线跨墙，落点大爆炸） -->
      <li>
        <label>测试·大火球</label>
        <iconPath>Things/Projectile/MMT_BigFireball</iconPath>
        <radius>0</radius>
        <targetFriendly>false</targetFriendly>
        <demoType>singleShot</demoType>
        <ignoreLineOfSight>true</ignoreLineOfSight>
        <castSeconds>2</castSeconds>
        <castBarColor>(1,0.45,0.15,0.5)</castBarColor>
        <range>30</range>
        <projectileDefName>MMT_Proj_BigFireball</projectileDefName>
        <soundDefName>Shot_IncendiaryLauncher</soundDefName>
      </li>
      <!-- 第十七步：范围回血（治疗量池 + 绿十字 + 治疗粒子） -->
      <li>
        <label>测试·治愈之光</label>
        <iconPath>Things/Mote/HealingCross</iconPath>
        <radius>4</radius>
        <targetFriendly>true</targetFriendly>
        <demoType>heal</demoType>
        <castSeconds>2</castSeconds>
        <castBarColor>(0.4,1,0.5,0.5)</castBarColor>
        <healAmount>15</healAmount>
      </li>
      <!-- 第十八步：石墙术（圈选范围召唤临时石墙） -->
      <li>
        <label>测试·石墙术</label>
        <iconPath>Things/Building/MMT_StoneWall</iconPath>
        <radius>2.5</radius>
        <demoType>wall</demoType>
        <castSeconds>1.5</castSeconds>
        <castBarColor>(0.7,0.65,0.55,0.5)</castBarColor>
        <range>15</range>
        <soundDefName>ChunkRock_Drop</soundDefName>
        <wallDurationSeconds>30</wallDurationSeconds>
      </li>
      <!-- 第十九步：毒气池（通用持续地面区域：站内积累原版毒素，离区自然衰减） -->
      <li>
        <label>测试·毒气池</label>
        <iconPath>Things/Mote/MMT_AuraDisc</iconPath>
        <radius>4</radius>
        <targetFriendly>false</targetFriendly>
        <demoType>groundZone</demoType>
        <castSeconds>2</castSeconds>
        <castBarColor>(0.55,0.85,0.3,0.5)</castBarColor>
        <soundDefName>FireSpew_Resolve</soundDefName>
        <zoneDurationSeconds>20</zoneDurationSeconds>
        <zoneIntervalTicks>30</zoneIntervalTicks>
        <zoneAffectEveryone>true</zoneAffectEveryone>
        <zoneHediffDefName>ToxicBuildup</zoneHediffDefName>
        <zoneHediffSeverity>0.04</zoneHediffSeverity>
        <zoneTint>(0.55,0.85,0.3)</zoneTint>
      </li>
