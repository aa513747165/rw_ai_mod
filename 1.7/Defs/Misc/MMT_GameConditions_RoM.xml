    <label>暖流</label>
    <description>魔法唤来的暖流，全图气温升高。</description>
    <conditionClass>GameCondition</conditionClass>
    <temperatureOffset>8</temperatureOffset>
    <preventRain>false</preventRain>
    <canBePermanent>false</canBePermanent>
  </GameConditionDef>
  <GameConditionDef>
    <defName>MMT_Cond_CoolFront</defName>
