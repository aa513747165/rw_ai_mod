    <conditionClass>GameCondition</conditionClass>
    <temperatureOffset>-8</temperatureOffset>
    <preventRain>false</preventRain>
    <canBePermanent>false</canBePermanent>
  </GameConditionDef>
  <GameConditionDef>
    <defName>MMT_Cond_FertileRain</defName>
    <label>丰饶之雨</label>
    <description>蕴含自然魔力的雨水，种植区作物加速生长。</description>
    <conditionClass>MyModeTest.GameCondition_MMTFertility</conditionClass>
    <preventRain>false</preventRain>
    <canBePermanent>false</canBePermanent>
  </GameConditionDef>
