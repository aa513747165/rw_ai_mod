<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 部署式护盾发生器：使用后在脚下生成临时护盾投影器（拦外部投射物，30秒后燃尽），机制对齐 Royalty 低级护盾背包；贴图暂引用 Royalty -->
  <ThingDef>
    <thingClass>ThingWithComps</thingClass>
    <defName>MMT_DeployableShield</defName>
    <label>部署式护盾发生器</label>
    <description>一次性便携护盾装置。部署后在原地展开一个临时能量护盾，拦截外部射入的投射物，护盾内的友军仍可向外射击；内置电源能量有限，燃尽后装置自动焚毁。</description>
    <category>Item</category>
    <thingCategories>
      <li>ItemsExotic</li>
    </thingCategories>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <rotatable>false</rotatable>
    <pathCost>15</pathCost>
    <stackLimit>1</stackLimit>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/BroadshieldPack/BroadshieldPack</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Standard_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <statBases>
      <DeteriorationRate>0</DeteriorationRate>
      <MarketValue>600</MarketValue>
      <Mass>3</Mass>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0.4</Flammability>
      <SellPriceFactor>0.70</SellPriceFactor>
    </statBases>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>部署{0_label}</useLabel>
        <useDuration>120</useDuration>
        <showUseGizmo>true</showUseGizmo>
      </li>
      <li Class="MyModeTest.CompProperties_UseEffectSpawnBuilding">
        <buildingDef>MMT_ShieldProjector</buildingDef>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>
</Defs>
