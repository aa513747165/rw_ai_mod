  <!-- 毒品扩展链成品：现代层（灵能粉/灵能茶/高级灵能茶/卷烟/雪茄/咖啡/战斗鸡尾酒）+ 未来层（超级灵能茶/纳米修复针/基因强化剂/纳米净化血清）。
       灵能粉数值全面对标 HSK Synchronisity；纳米修复针/基因强化剂/净化血清为 MMT 原创未来层制品。
       贴图：HSK 授权复制（目录贴图走 Graphic_StackCount，单图走 Graphic_Single）或直引原版路径 -->

  <!-- 灵能粉：对标 HSK Synchronisity（硬毒品：灵能敏感+意识+、休息效率大降；自成瘾体系见 MMT_Hediffs_DrugsExt.xml） -->
  <ThingDef ParentName="DrugBase">
    <defName>MMT_Synchronisity</defName>
    <label>灵能粉</label>
    <description>从灵能结晶中精炼出的淡紫色粉末，能显著放大服用者的灵能感知与意识，同时大幅降低疲劳累积速度。长期使用会产生依赖，戒断时出现灵能反噬，高耐受下有诱发灵能昏迷的风险。</description>
    <descriptionHyperlinks>
      <HediffDef>MMT_SynchronisityHigh</HediffDef>
      <HediffDef>MMT_SynchronisityTolerance</HediffDef>
      <HediffDef>MMT_SynchronisityAddiction</HediffDef>
      <HediffDef>PsychicComa</HediffDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_Medicine/MMT_Synchronisity</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.75</drawSize>
    </graphicData>
    <rotatable>false</rotatable>
    <statBases>
      <WorkToMake>350</WorkToMake>
      <MarketValue>28</MarketValue>
      <Mass>0.05</Mass>
    </statBases>
    <techLevel>Spacer</techLevel>
    <ingestible>
      <foodType>Processed</foodType>
      <preferability>NeverForNutrition</preferability>
      <joyKind>Chemical</joyKind>
      <joy>0.80</joy>
      <drugCategory>Hard</drugCategory>
      <baseIngestTicks>150</baseIngestTicks>
      <ingestSound>Ingest_Snort</ingestSound>
      <ingestCommandString>吸食 {0}</ingestCommandString>
      <ingestReportString>正在吸食 {0}。</ingestReportString>
      <useEatingSpeedStat>false</useEatingSpeedStat>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>MMT_SynchronisityHigh</hediffDef>
          <severity>0.75</severity>
          <toleranceChemical>MMT_Synchronisity</toleranceChemical>
        </li>
        <li Class="IngestionOutcomeDoer_OffsetNeed">
          <need>Rest</need>
          <offset>0.4</offset>
          <toleranceChemical>MMT_Synchronisity</toleranceChemical>
        </li>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>MMT_SynchronisityTolerance</hediffDef>
          <severity>0.040</severity>
          <divideByBodySize>true</divideByBodySize>
        </li>
        <!-- 恢复灵能焦点（原版类，1.7 GoJuice 同款） -->
        <li Class="IngestionOutcomeDoer_OffsetPsyfocus">
          <offset>0.15</offset>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Drug">
        <chemical>MMT_Synchronisity</chemical>
        <addictiveness>0.03</addictiveness>
        <existingAddictionSeverityOffset>0.20</existingAddictionSeverityOffset>
        <needLevelOffset>0.9</needLevelOffset>
        <isCombatEnhancingDrug>true</isCombatEnhancingDrug>
        <listOrder>100</listOrder>
        <overdoseSeverityOffset>0.18~0.35</overdoseSeverityOffset>
        <largeOverdoseChance>0.01</largeOverdoseChance>
      </li>
    </comps>
  </ThingDef>

