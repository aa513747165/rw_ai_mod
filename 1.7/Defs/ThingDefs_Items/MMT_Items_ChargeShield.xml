<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 充能护盾腰带：腰带层服装（与原版护盾腰带同槽位）。征召时指令栏出现开关按钮；
       开启后全额吸收所有伤害（含近战），每点伤害耗电 40 Wd，开启期间持续耗电 300 Wd/天；
       电能耗尽或解除征召自动关闭，可在充能台回充。机制见 ShieldPack.cs；
       物品图标用 MMT 专属贴图；与原版护盾腰带一样不设 wornGraphicPath，
       小人穿戴时不绘制任何图层（1.7 渲染：WornGraphicPath 为空则不生成服装渲染节点） -->
  <ThingDef ParentName="ApparelBase">
    <defName>MMT_ChargeShieldPack</defName>
    <label>充能护盾腰带</label>
    <thingClass>MyModeTest.Apparel_ChargeShieldPack</thingClass>
    <description>新一代个人能量护盾装置，佩戴于腰部。征召时可在指令栏开启护盾：开启后展开贴身能量场，全额吸收所有伤害（包括近战），每吸收 1 点伤害耗电 40 Wd，开启期间持续耗电 300 Wd/天；电能耗尽护盾自动关闭，EMP 武器可直接击穿并清空电量。电量耗尽后可在充能台回充重复使用。</description>
    <tickerType>Normal</tickerType>
    <techLevel>Spacer</techLevel>
    <!-- ApparelNoQualityBase 自带 smeltable=true，本品由配方直接产出无 costList，熔炼无产出会报配置错误 -->
    <smeltable>false</smeltable>
    <graphicData>
      <texPath>Things/Item/MMT/Shield/MMT_ShieldBeltTech</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>3</Mass>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>0.4</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <MarketValue>1500</MarketValue>
      <SellPriceFactor>0.70</SellPriceFactor>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <thingCategories>
      <li>ApparelUtility</li>
      <li>MMT_RechargeableDevices</li>
    </thingCategories>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <tags>
        <li>BeltDefense</li>
      </tags>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    </apparel>
    <comps>
      <li Class="MyModeTest.CompProperties_Rechargeable">
        <maxChargeWd>4000</maxChargeWd>
      </li>
      <li Class="MyModeTest.CompProperties_ShieldPack">
        <passiveDrainWdPerDay>300</passiveDrainWdPerDay>
        <wdPerDamage>40</wdPerDamage>
      </li>
    </comps>
    <allowedArchonexusCount>1</allowedArchonexusCount>
    <tradeTags>
      <li>Armor</li>
    </tradeTags>
  </ThingDef>
</Defs>
