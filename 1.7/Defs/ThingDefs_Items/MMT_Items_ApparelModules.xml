    <graphicData><texPath>Things/Item/MMT/ApparelMod/MMT_ApparelModFortify</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <soundInteract>Metal_Drop</soundInteract><soundDrop>Metal_Drop</soundDrop>
    <tickerType>Rare</tickerType><techLevel>Spacer</techLevel>
    <statBases><MarketValue>400</MarketValue><DeteriorationRate>0</DeteriorationRate><Flammability>0.2</Flammability><Mass>1</Mass></statBases>
    <thingCategories><li>MMT_ElectronicsCat</li></thingCategories>
    <stackLimit>10</stackLimit>
