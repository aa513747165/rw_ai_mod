<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 职业仪式随身组：挂上后凭证/能量结晶在家园地图也有右键"拾取"入背包选项
       （原版 FloatMenuOptionProvider_PickUpItem 要求 orderedTakeGroup.max>0，否则家园图只能搬运入库）。
       max 取 25，覆盖升阶最大消耗 能量结晶×20（PawnClassUtil.CrystalCost tier3）。 -->
  <OrderedTakeGroupDef>
    <defName>MMT_ClassRitual</defName>
    <label>职业仪式材料</label>
    <max>25</max>
  </OrderedTakeGroupDef>

  <!-- 职业凭证（mmt-class-design.md §5.1）：全职业通用单种凭证。按"物品"对待（不计入顶部资源面板、可右键拾取入背包）。
       来源：副本据点掉落（职业圣殿/Boss 巢穴，mmt-dungeon-design.md §3.2）、
       职业凭证碎片 3 合 1（MMT_CraftClassToken，装备强化台）、Dev 模式发放（DebugAction"MMT 职业/发放职业凭证"）。 -->
  <ThingDef ParentName="ResourceBase">
    <defName>MMT_ClassToken</defName>
    <label>职业凭证</label>
    <description>记载着古老职业传承的秘典，封面上烫印着三十六种职业纹章。在职业导师台上消耗它，可以让一名历练有成的殖民者踏上职业之路。</description>
    <graphicData>
      <texPath>Things/Item/MMT/MMT_ClassToken</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tickerType>Rare</tickerType>
    <techLevel>Spacer</techLevel>
    <resourceReadoutPriority>Uncounted</resourceReadoutPriority>
    <orderedTakeGroup>MMT_ClassRitual</orderedTakeGroup>
    <statBases>
      <MarketValue>1500</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>1.0</Flammability>
      <Mass>0.5</Mass>
      <Beauty>2</Beauty>
    </statBases>
    <stackLimit>5</stackLimit>
    <thingCategories>
      <li>MMT_ClassItemsCat</li>
    </thingCategories>
  </ThingDef>
</Defs>
