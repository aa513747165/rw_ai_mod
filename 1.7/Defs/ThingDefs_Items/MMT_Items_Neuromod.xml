<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 神经调制使用品(组十四,非植入;特殊效果由 MMT C# comp 实现) -->
  <ThingDef ParentName="MechSerumBase">
    <defName>MMT_CONN_NeuromodBooster</defName>
    <label>神经调节增强器</label>
    <description>一种小型装置，穿透眼球以有效重新映射现有大脑结构。通常只会带来小幅改善……</description>
    <graphicData><texPath>Things/Item/MMT/MMT_Bionics/Neuromod</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <techLevel>Spacer</techLevel>
    <stackLimit>1</stackLimit>
    <tradeNeverStack>true</tradeNeverStack>
    <drawGUIOverlay>false</drawGUIOverlay>
    <thingCategories><li>Neurotrainers</li></thingCategories>
    <tradeability>Sellable</tradeability>
    <thingSetMakerTags><li>RewardStandardHighFreq</li></thingSetMakerTags>
    <tradeTags><li>ExoticMisc</li></tradeTags>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Mass>0.2</Mass>
      <DeteriorationRate>1.0</DeteriorationRate>
      <Flammability>0.2</Flammability>
      <MarketValue>1500</MarketValue>
    </statBases>
    <costList>
      <Gold>15</Gold>
      <MMT_Glass>10</MMT_Glass>
      <MMT_SyntheticFibers>6</MMT_SyntheticFibers>
      <MMT_BioMicrochips>1</MMT_BioMicrochips>
      <MMT_UltraComponent>1</MMT_UltraComponent>
    </costList>
    <recipeMaker>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <skillRequirements>
        <Medicine>18</Medicine>
      </skillRequirements>
      <researchPrerequisite>MMT_Prosthesis_E2</researchPrerequisite>
      <recipeUsers>
        <li>MMT_ElectricElectronicsTable</li>
      </recipeUsers>
    </recipeMaker>
    <comps>
      <li Class="CompProperties_Usable"><useJob>UseItem</useJob><useLabel>使用神经调节增强器</useLabel></li>
      <li Class="CompProperties_UseEffect"><compClass>MyModeTest.CompUseEffect_LearnSkillRandom</compClass></li>
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
  </ThingDef>

