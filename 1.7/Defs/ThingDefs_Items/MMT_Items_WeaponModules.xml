    <defName>MMT_WeaponModSharp</defName>
    <label>锋利模块</label>
    <description>低级武器附魔模块：高频震动刃口校准器。安装后武器伤害 +8%。在武器强化台对台内武器安装（右键强化台）。</description>
    <graphicData><texPath>Things/Item/MMT/WeaponMod/MMT_WeaponModSharp</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <soundInteract>Metal_Drop</soundInteract><soundDrop>Metal_Drop</soundDrop>
    <tickerType>Rare</tickerType><techLevel>Spacer</techLevel>
    <statBases><MarketValue>400</MarketValue><DeteriorationRate>0</DeteriorationRate><Flammability>0.2</Flammability><Mass>1</Mass></statBases>
    <thingCategories><li>MMT_ElectronicsCat</li></thingCategories>
    <stackLimit>10</stackLimit>
    <modExtensions>
      <li Class="MyModeTest.ModuleExtension">
        <slotKey>WeaponEnchant</slotKey>
        <effectReport>伤害 +8%</effectReport>
        <effects><li><key>WeaponDamageFactor</key><valuePerItem>0.08</valuePerItem></li></effects>
