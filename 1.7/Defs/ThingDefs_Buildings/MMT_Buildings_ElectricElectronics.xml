<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_ElectricElectronicsTable</defName>
    <label>电子电动工作台</label>
    <description>以电力驱动的精密电子工作台，可以更快地组装电子元件、集成电路和微芯片。需要持续供电。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_ElectricElectronicsTable/MMT_ElectricElectronicsTable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>80</pathCost>
    <fillPercent>0.6</fillPercent>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>140</costStuffCount>
    <costList>
      <MMT_CopperBar>40</MMT_CopperBar>
      <ComponentIndustrial>10</ComponentIndustrial>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <statBases>
      <WorkToBuild>2750</WorkToBuild>
      <MaxHitPoints>220</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-1</Cleanliness>
      <Mass>500</Mass>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_AssembleElectronicParts_Electric</li>
      <li>MMT_AssembleIC_Electric</li>
      <li>MMT_AssembleMicrochip_Electric</li>
    </recipes>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>600</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <building>
      <uninstallWork>1400</uninstallWork>
    </building>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_ElectricElectronics</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
  </ThingDef>
</Defs>
