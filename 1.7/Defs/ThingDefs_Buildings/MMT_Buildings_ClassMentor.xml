<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 职业导师台（mmt-class-design.md §5.1）：右键 FloatMenu 就职/升阶（CompClassMentor）。
       造价按设计§5.1：微芯片×6 + 高级合金×40 + 玻璃钢×60；
       spike 回填：MMT 无"玻璃钢"与通用"高级合金"物品，取最近似的高级链产物——钨钴合金 + 强化玻璃块。
       贴图暂用 RoM 奥术防御塔贴图占位（待 AI 生成专属贴图，见 §5.1）。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_ClassMentorBench</defName>
    <label>职业导师台</label>
    <description>铭刻着三十六种职业纹章的导师台。右键建筑可为小人举行就职仪式（消耗随身携带的职业凭证×1，需历练 5 级；无灵能链接者将在仪式中觉醒灵能）或晋升阶位（II 阶需历练 10 级 + 能量结晶×10，III 阶需历练 15 级 + 能量结晶×20）。每人限一个职业。</description>
    <graphicData>
      <texPath>Things/Building/Production/RoM/MMT_ClassMentorBench</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2.6,2.6)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <rotatable>false</rotatable>
    <tickerType>Rare</tickerType>
    <designationCategory>MMT_Production</designationCategory>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>6000</WorkToBuild>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0.4</Flammability>
      <Mass>40</Mass>
    </statBases>
    <costList>
      <MMT_Microchip>6</MMT_Microchip>
      <MMT_PobediteAlloy>40</MMT_PobediteAlloy>
      <MMT_ReinforcedGlass>60</MMT_ReinforcedGlass>
    </costList>
    <comps>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>800</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable" />
      <li Class="MyModeTest.CompProperties_ClassMentor" />
    </comps>
  </ThingDef>
</Defs>
