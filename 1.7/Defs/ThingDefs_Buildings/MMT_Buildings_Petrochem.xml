<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_HandChemTable</defName>
    <label>石化产品实验室</label>
    <description>依靠人力操作的化学实验台，用于蒸馏原油和合成石化材料。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_HandChemTable/MMT_HandChemTable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,4)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>80</pathCost>
    <fillPercent>0.6</fillPercent>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>130</costStuffCount>
    <costList>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>2000</WorkToBuild>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-3</Cleanliness>
      <Mass>200</Mass>
    </statBases>
    <size>(3,2)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_DistillPolymers_Hand</li>
      <li>MMT_MakePlastic_Hand</li>
      <li>MMT_MakeRubber_Hand</li>
      <li>MMT_MakeSyntheticFibers_Hand</li>
      <li>MMT_MakeCarbon_Hand</li>
      <li>MMT_MakeParaffins</li>
      <li>MMT_MakeSulphates</li>
    </recipes>
    <tickerType>Normal</tickerType>
    <building>
      <uninstallWork>1200</uninstallWork>
    </building>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_BasicPetrochemistry</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
  </ThingDef>

  <!-- 手压油泵：参考原版深钻井的无电变体，但不依赖地下资源/扫描，任意位置建造后通过配方缓慢压取原油 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_HandOilPump</defName>
    <label>手压油泵</label>
    <description>依靠人力往复压取地下浅层原油的泵架。不需要电力，但出油很慢。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_HandOilPump</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2,3.5)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>80</pathCost>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>1500</WorkToBuild>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Mass>80</Mass>
    </statBases>
    <size>(2,2)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_PumpCrudeOil</li>
    </recipes>
    <tickerType>Normal</tickerType>
    <building>
      <uninstallWork>800</uninstallWork>
    </building>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_BasicPetrochemistry</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
  </ThingDef>

  <ThingDef ParentName="RockBase">
    <defName>MMT_MineableOilSeep</defName>
    <label>油苗</label>
    <description>地表渗出的原油矿脉，开采后可获得原油，用于蒸馏聚合物。</description>
    <graphicData>
      <texPath>Things/Building/Linked/RockFlecked_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <color>(45,42,40)</color>
      <colorTwo>(65,34,34)</colorTwo>
    </graphicData>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
    </statBases>
    <building>
      <isResourceRock>true</isResourceRock>
      <mineableThing>MMT_CrudeOil</mineableThing>
      <mineableYield>75</mineableYield>
      <mineableScatterCommonality>0.8</mineableScatterCommonality>
      <mineableScatterLumpSizeRange>10~18</mineableScatterLumpSizeRange>
      <veinMineable>true</veinMineable>
    </building>
  </ThingDef>
</Defs>
