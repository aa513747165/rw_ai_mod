    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_AdvWeaponCraftingTable/MMT_AdvWeaponCraftingTable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.7</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>160</costStuffCount>
    <costList>
      <MMT_Rubber>55</MMT_Rubber>
      <ComponentIndustrial>15</ComponentIndustrial>
      <MMT_Mechanism>8</MMT_Mechanism>
      <MMT_IntegratedCircuit>5</MMT_IntegratedCircuit>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>6500</WorkToBuild>
      <MaxHitPoints>250</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-8</Cleanliness>
      <Mass>500</Mass>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_MakeWeaponParts</li>
      <li>MMT_MakePistolComponent</li>
      <li>MMT_MakeSMGComponent</li>
      <li>MMT_MakeShotgunComponent</li>
      <li>MMT_MakeRifleComponent</li>
      <li>MMT_MakeSniperComponent</li>
      <li>MMT_MakeAdvRifleComponent</li>
      <li>MMT_MakeAdvSniperComponent</li>
      <li>MMT_MakeHeavyComponent</li>
      <li>MMT_MakeCannonComponent</li>
      <li>MMT_MakeLauncherComponent</li>
    </recipes>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>500</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <building>
      <uninstallWork>1450</uninstallWork>
    </building>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>Fabrication</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
  </ThingDef>

  <!-- 未来武器工作台：对照 HSK MechWeaponCraftingWorkTable -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_MechWeaponTable</defName>
    <label>未来武器工作台</label>
    <description>加工电荷、光束与离子武器部件的太空时代工作台。需要持续供电。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_MechWeaponTable/MMT_MechWeaponTable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.7</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>190</costStuffCount>
    <costList>
      <MMT_MagneticMaterial>20</MMT_MagneticMaterial>
      <ComponentSpacer>12</ComponentSpacer>
      <MMT_AdvMechanism>5</MMT_AdvMechanism>
      <MMT_BioMicrochips>2</MMT_BioMicrochips>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>11000</WorkToBuild>
      <MaxHitPoints>260</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-8</Cleanliness>
      <Mass>500</Mass>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_MakeWeaponParts</li>
      <li>MMT_MakeChargedComponent</li>
      <li>MMT_MakeLaserComponent</li>
      <li>MMT_MakePlasmaComponent</li>
    </recipes>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1800</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <building>
      <uninstallWork>5500</uninstallWork>
    </building>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>ChargedShot</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>18</constructionSkillPrerequisite>
  </ThingDef>
</Defs>
