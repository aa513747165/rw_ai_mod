<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- B8 武器加工建筑：对照 HSK Buildings_Production_Weapons.xml。SK 基类/IdlePower/设施联动剔除，用 MMT 既有建筑模板；HSK stuff 类别 RuggedMetallic/SolidMetallic 映射原版 Metallic -->

  <!-- 武器加工台：对照 HSK WeaponCraftingWorkTable -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_WeaponCraftingTable</defName>
    <label>武器加工台</label>
    <description>加工手枪、步枪等枪械部件的工作台。需要持续供电。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_WeaponCraftingTable/MMT_WeaponCraftingTable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.7</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>140</costStuffCount>
    <costList>
      <ComponentIndustrial>15</ComponentIndustrial>
      <MMT_ElectronicParts>6</MMT_ElectronicParts>
      <MMT_Mechanism>6</MMT_Mechanism>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>4000</WorkToBuild>
      <MaxHitPoints>210</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-8</Cleanliness>
      <Mass>500</Mass>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_MakeWeaponParts</li>
      <li>MMT_MakePistolComponent</li>
      <li>MMT_MakeSMGComponent</li>
      <li>MMT_MakeShotgunComponent</li>
      <li>MMT_MakeRifleComponent</li>
      <li>MMT_MakeSniperComponent</li>
    </recipes>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>500</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <building>
      <uninstallWork>1450</uninstallWork>
    </building>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>Machining</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
  </ThingDef>

  <!-- 先进武器加工台：对照 HSK AdvWeaponCraftingWorkTable（研究 Range_C2 映射原版 Fabrication） -->
