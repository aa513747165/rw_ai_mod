<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 药品链建筑：对照 HSK meditable/DryingRack/ElectricDryingRack/NeutroamineRefiner。
       与 HSK 差异：HSK 的 meditable 为电动且研究前置 DrugProduction，MMT 按惯例拆为手工+电动两台；
       精炼厂不使用 Rimefeller 自定义类，用原版 Building_WorkTable + 配方模式烧化合燃料；
       手工制药台/晾晒架与电动版共用贴图（HSK 无独立手工版贴图） -->

  <!-- 手工制药台：绷带、草药包、基础医药包（对照 HSK 挂 meditable 的手工类配方） -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_MedicalTable</defName>
    <label>手工制药台</label>
    <description>一张用于处理药材、制作绷带和草药包的手工工作台。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_ElectricMedicalTable/MMT_ElectricMedicalTable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.6</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>75</costStuffCount>
    <costList>
      <MMT_Glass>20</MMT_Glass>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>2000</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-2</Cleanliness>
      <Mass>120</Mass>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_MakeHerbalTea</li>
      <li>MMT_MakeActivatedCarbon</li>
      <li>MMT_MakeBandagekitcrude</li>
      <li>MMT_MakeBandagekitcrudeBulk</li>
      <li>MMT_MakeBandagekit</li>
      <li>MMT_MakeBandagekitBulk</li>
      <li>MMT_MakeHerbMedicine</li>
      <li>MMT_MakeBasicMedicineKit</li>
      <li>MMT_MakeBasicMedicineKitMix</li>
    </recipes>
    <building>
      <workTableRoomRole>Laboratory</workTableRoomRole>
    </building>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_Medicine_A2</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
  </ThingDef>

  <!-- 电动制药台：对照 HSK meditable（工业医药、闪耀医药、抗生素） -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_ElectricMedicalTable</defName>
    <label>电动制药台</label>
    <description>以电力驱动的精密制药设备，用于合成工业医药、抗生素与闪耀世界医药。需要持续供电。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_ElectricMedicalTable/MMT_ElectricMedicalTable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.6</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>125</costStuffCount>
    <costList>
      <MMT_Glass>60</MMT_Glass>
      <MMT_Rubber>45</MMT_Rubber>
      <ComponentIndustrial>10</ComponentIndustrial>
      <MMT_ElectronicParts>5</MMT_ElectronicParts>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>4000</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-3</Cleanliness>
      <Mass>500</Mass>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_MakeHerbalTea</li>
      <li>MMT_MakeActivatedCarbon</li>
      <li>MMT_MakeBandagekit</li>
      <li>MMT_MakeBandagekitBulk</li>
      <li>MMT_MakeHerbMedicine</li>
      <li>MMT_MakeBasicMedicineKit</li>
      <li>MMT_MakeBasicMedicineKitMix</li>
      <li>MMT_BrewMedicalDrink</li>
      <li>MMT_MakeMedicineIndustrial</li>
      <li>MMT_MakeMedicineUltratech</li>
    </recipes>
    <building>
      <workTableRoomRole>Laboratory</workTableRoomRole>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>500</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MedicineProduction</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
  </ThingDef>

  <!-- 晾晒架：对照 HSK DryingRack（烟叶脱水；MMT 无发酵框架，用长工时配方模拟） -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_DryingRack</defName>
    <label>晾晒架</label>
    <description>一个通风的木架，用于将新鲜烟叶自然晾干。费时但不需要电力。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_DryingRack</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <fillPercent>0.4</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>800</WorkToBuild>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Mass>40</Mass>
    </statBases>
    <size>(2,1)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_DrySmokeleaf</li>
      <li>MMT_DrySmokeleafBulk</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_Drugs_A1</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
      <!-- 1.7 BuildingBase 不再自带 BuildingProperties,必须显式声明 -->
    <building/>
  </ThingDef>

  <!-- 电动晾晒架：对照 HSK ElectricDryingRack（批量/更快） -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_ElectricDryingRack</defName>
    <label>电动晾晒架</label>
    <description>以电力加热通风的干燥设备，可批量快速烘干烟叶。需要持续供电。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_ElectricDryingRack/MMT_ElectricDryingRack</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2.5,2.5)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.6</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>80</costStuffCount>
    <costList>
      <ComponentIndustrial>4</ComponentIndustrial>
      <MMT_ElectronicParts>2</MMT_ElectronicParts>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>2500</WorkToBuild>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Mass>120</Mass>
    </statBases>
    <size>(2,2)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_DrySmokeleaf</li>
      <li>MMT_DrySmokeleafBulk</li>
    </recipes>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>400</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_Drugs_B1</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
      <!-- 1.7 BuildingBase 不再自带 BuildingProperties,必须显式声明 -->
    <building/>
  </ThingDef>

  <!-- 中性胺精炼厂：对照 HSK/Rimefeller NeutroamineRefiner（烧化合燃料产中性胺） -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_NeutroamineRefiner</defName>
    <label>中性胺精炼厂</label>
    <description>以化合燃料为原料，通过高压催化裂解精炼中性胺的工业设备。需要持续供电。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_NeutroamineRefiner</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.8</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>160</costStuffCount>
    <costList>
      <MMT_SyntheticFibers>25</MMT_SyntheticFibers>
      <MMT_Glass>25</MMT_Glass>
      <MMT_ElectronicParts>15</MMT_ElectronicParts>
      <ComponentSpacer>5</ComponentSpacer>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>8000</WorkToBuild>
      <MaxHitPoints>400</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-5</Cleanliness>
      <Mass>800</Mass>
    </statBases>
    <size>(2,2)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_RefineNeutroamine</li>
    </recipes>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>2500</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_Drugs_C2</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
      <!-- 1.7 BuildingBase 不再自带 BuildingProperties,必须显式声明 -->
    <building/>
  </ThingDef>
</Defs>
