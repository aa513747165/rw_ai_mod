<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="RockBase">
    <defName>MMT_MineableNickelOre</defName>
    <label>镍矿矿藏</label>
    <description>露头的镍矿石矿脉，开采后可获得镍矿石，用于冶炼镍锭和提取钴。</description>
    <graphicData>
      <texPath>Things/Building/Linked/RockFlecked_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <color>(88,115,175)</color>
      <colorTwo>(42,208,206)</colorTwo>
    </graphicData>
    <statBases>
      <MaxHitPoints>10000</MaxHitPoints>
    </statBases>
    <building>
      <isResourceRock>true</isResourceRock>
      <mineableThing>MMT_NickelOre</mineableThing>
      <mineableYield>50</mineableYield>
      <mineableScatterCommonality>0.4</mineableScatterCommonality>
      <mineableScatterLumpSizeRange>5~10</mineableScatterLumpSizeRange>
      <veinMineable>true</veinMineable>
    </building>
  </ThingDef>

