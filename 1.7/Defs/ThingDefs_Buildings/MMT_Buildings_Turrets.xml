<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!--MMT 可建造炮塔：refuelable 装填耗弹-->
	<ThingDef Name="MMT_TurretBuildingBase" ParentName="BuildingBase" Abstract="True">
		<thingClass>Building_TurretGun</thingClass>
		<drawerType>MapMeshAndRealTime</drawerType>
		<altitudeLayer>Building</altitudeLayer>
		<tickerType>Normal</tickerType>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<fillPercent>0.85</fillPercent>
		<hasTooltip>true</hasTooltip>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<stealable>false</stealable>
		<rotatable>false</rotatable>
		<minifiedDef>MinifiedThing</minifiedDef>
		<tradeability>None</tradeability>
		<thingCategories>
			<li>BuildingsSecurity</li>
		</thingCategories>
		<designationCategory>Security</designationCategory>
		<statBases>
			<Flammability>0.7</Flammability>
			<Beauty>-60</Beauty>
		</statBases>
		<comps>
			<li Class="CompProperties_Forbiddable" />
		</comps>
		<building>
			<ai_combatDangerous>true</ai_combatDangerous>
		</building>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
	</ThingDef>
	<ThingDef ParentName="MMT_TurretBuildingBase">
		<defName>MMT_Turret_M2Browning</defName>
		<label>M2 .50勃朗宁机枪</label>
		<description>一种需要手动操作，固定的M2勃朗宁重机枪。使用.50大口径机枪弹，每次点射发射15发弹药。</description>
		<graphicData>
			<texPath>Things/Building/Security/M240_Base</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(4,4)</drawSize>
			<shadowData>
				<volume>(0.3, 0.6, 0.3)</volume>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Building/Security/50BMG_ico</uiIconPath>
		<techLevel>Spacer</techLevel>
		<statBases>
			<Beauty>-60</Beauty>
			<Flammability>1.0</Flammability>
			<Mass>33.5</Mass>
			<MaxHitPoints>140</MaxHitPoints>
			<WorkToBuild>1200</WorkToBuild>
		</statBases>
		<size>(1,1)</size>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>70</costStuffCount>
		<costList>
			<MMT_MGTurret_Crate>1</MMT_MGTurret_Crate>
		</costList>
		<comps>
			<li Class="CompProperties_Mannable">
				<manWorkType>Violent</manWorkType>
			</li>
			<li Class="CompProperties_Refuelable">
				<fuelCapacity>150</fuelCapacity>
				<fuelMultiplier>1</fuelMultiplier>
				<initialFuelPercent>0</initialFuelPercent>
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
				<showFuelGizmo>true</showFuelGizmo>
				<fuelFilter>
					<thingDefs>
						<li>MMT_Ammo_50BMG_FMJ</li>
					</thingDefs>
				</fuelFilter>
			</li>
		</comps>
		<hasInteractionCell>True</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<building>
			<turretGunDef>MMT_Gun_M2Browning</turretGunDef>
			<turretTopDrawSize>4</turretTopDrawSize>
		</building>
		<researchPrerequisites>
			<li>SniperTurret</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>9</constructionSkillPrerequisite>
	</ThingDef>
