		<building>
			<turretGunDef>MMT_Gun_Oerlikonautocannon</turretGunDef>
			<turretTopDrawSize>4</turretTopDrawSize>
		</building>
		<researchPrerequisites>
			<li>MMT_HeavyTurrets3</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>13</constructionSkillPrerequisite>
		<specialDisplayRadius>7</specialDisplayRadius>
	</ThingDef>
	<!-- KPV 14.5mm 重机枪塔：前中期有人操作炮塔，对应 HSK Turret_KPV（贴图 HSK KPVT 系列） -->
	<ThingDef ParentName="MMT_TurretBuildingBase">
		<defName>MMT_TurretKPV</defName>
		<label>14.5mm KPV重机枪</label>
		<description>一种需要手动操作，固定的14.5mm KPV重机枪。使用14.5x114mm机枪弹，每次点射发射8发弹药。</description>
		<graphicData>
			<texPath>Things/Building/Security/KPVT_Base</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2,2)</drawSize>
			<shadowData>
				<volume>(0.3, 0.6, 0.3)</volume>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Building/Security/KPVT_ico</uiIconPath>
		<techLevel>Industrial</techLevel>
		<statBases>
			<Beauty>-60</Beauty>
			<Flammability>0.5</Flammability>
			<Mass>90</Mass>
			<MaxHitPoints>150</MaxHitPoints>
			<WorkToBuild>1500</WorkToBuild>
		</statBases>
		<size>(1,1)</size>
		<!-- 覆盖基类 rotatable=false：KPV 可旋转以调整操作位朝向 -->
		<rotatable>true</rotatable>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>80</costStuffCount>
		<costList>
			<MMT_KPVTurret_Crate>1</MMT_KPVTurret_Crate>
		</costList>
		<comps>
			<li Class="CompProperties_Mannable">
				<manWorkType>Violent</manWorkType>
			</li>
			<li Class="CompProperties_Refuelable">
				<fuelCapacity>200</fuelCapacity>
				<fuelMultiplier>1</fuelMultiplier>
				<initialFuelPercent>0</initialFuelPercent>
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
				<showFuelGizmo>true</showFuelGizmo>
				<fuelFilter>
					<thingDefs>
						<li>MMT_Ammo_145x114mm_FMJ</li>
					</thingDefs>
				</fuelFilter>
			</li>
		</comps>
		<hasInteractionCell>True</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<building>
			<turretGunDef>MMT_Gun_KPV</turretGunDef>
			<turretTopDrawSize>4</turretTopDrawSize>
		</building>
		<researchPrerequisites>
			<li>MMT_HeavyMachineGunTurret</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>7</constructionSkillPrerequisite>
		<specialDisplayRadius>40</specialDisplayRadius>
	</ThingDef>
</Defs>