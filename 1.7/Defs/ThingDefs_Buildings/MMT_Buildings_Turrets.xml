		<constructionSkillPrerequisite>12</constructionSkillPrerequisite>
		<specialDisplayRadius>6</specialDisplayRadius>
	</ThingDef>
	<ThingDef ParentName="MMT_TurretBuildingBase">
		<defName>MMT_Turret_Oerlikonautocannon</defName>
		<label>20mm厄利孔机炮</label>
		<description>需要人工控制的厄利孔机炮。具有较强的反器材能力。当承受大量伤害时可能发生大爆炸。使用20x102mm炮弹。</description>
		<graphicData>
			<texPath>Things/Building/Security/AMTurretGun_Base</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(4,4)</drawSize>
			<shadowData>
				<volume>(0.3, 0.6, 0.3)</volume>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Building/Security/AMTurretGun_Top_ico</uiIconPath>
		<techLevel>Ultra</techLevel>
		<statBases>
			<Beauty>-60</Beauty>
			<Flammability>0.7</Flammability>
			<Mass>76.5</Mass>
			<MaxHitPoints>150</MaxHitPoints>
			<WorkToBuild>1700</WorkToBuild>
		</statBases>
		<size>(2,2)</size>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>100</costStuffCount>
		<costList>
			<MMT_Oerlikonautocannon_Crate>1</MMT_Oerlikonautocannon_Crate>
