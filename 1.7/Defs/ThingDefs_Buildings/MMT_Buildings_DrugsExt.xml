<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 高级药物合成台：未来层药物生产建筑（毒品 VIII 解锁），结构模板对齐 MMT_ElectricMedicalTable，
       贴图为 AI 生成（宽幅正视图用于南/北向，竖幅图用于东/西向）；占地 3x2，drawSize (3.6,2.27)
       为宽幅(1.62)与竖幅(1/0.646)两种贴图宽高比的折中，旋转时绘制矩形随之交换；
       遮罩为全黑（不做材料染色，保留贴图原色）。
       1.7 BuildingBase 不再自带 BuildingProperties，必须显式声明 <building/> -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_AdvDrugLab</defName>
    <label>高级药物合成台</label>
    <description>集成了微芯片控制与纳米装配能力的太空时代合成设备，用于制备灵能制品与机械液系高端药物。需要持续供电。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_AdvDrugLab/MMT_AdvDrugLab</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3.6,2.27)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.6</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(1,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>100</costStuffCount>
    <costList>
      <MMT_Plastic>40</MMT_Plastic>
      <MMT_Glass>30</MMT_Glass>
      <MMT_Microchip>2</MMT_Microchip>
      <MMT_SpacerComponent>6</MMT_SpacerComponent>
      <ComponentSpacer>5</ComponentSpacer>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>6000</WorkToBuild>
      <MaxHitPoints>250</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-5</Cleanliness>
      <Mass>800</Mass>
    </statBases>
    <size>(3,2)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_MakeSynchroCrystal</li>
      <li>MMT_MakeSynchronisity</li>
      <li>MMT_BrewPsyfocusTea</li>
      <li>MMT_BrewAdvPsyfocusTea</li>
      <li>MMT_BrewSuperPsyfocusTea</li>
      <li>MMT_MakeBattleCocktail</li>
      <li>MMT_MakeNanoRepairSerum</li>
      <li>MMT_MakeGeneBooster</li>
      <li>MMT_MakeNanoPurgeSerum</li>
      <li>MMT_MakePsychicAmplifier</li>
      <li>MMT_MakeMechSerumResurrector</li>
    </recipes>
    <building>
      <workTableRoomRole>Laboratory</workTableRoomRole>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1500</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_Drugs_D2</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
  </ThingDef>
</Defs>
