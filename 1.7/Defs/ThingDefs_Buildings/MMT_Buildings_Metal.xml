<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_HandFurnace</defName>
    <label>熔炉</label>
    <description>依靠人力鼓风加热的熔炉，用于将金属矿石冶炼成金属锭，并合炼青铜和钢。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_HandFurnace/MMT_HandFurnace</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.7</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>240</costStuffCount>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>3000</WorkToBuild>
      <MaxHitPoints>280</MaxHitPoints>
      <Flammability>0</Flammability>
      <Cleanliness>-8</Cleanliness>
      <Mass>1000</Mass>
    </statBases>
    <size>(3,3)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_SmeltCopperBar_Hand</li>
      <li>MMT_SmeltTinBar_Hand</li>
      <li>MMT_MakeBronze_Hand</li>
      <li>MMT_SmeltSteel_Hand</li>
      <li>MMT_ExtractSilicon_Hand</li>
      <li>MMT_SmeltSilver_Hand</li>
      <li>MMT_SmeltGold_Hand</li>
      <li>MMT_SmeltLeadBar_Hand</li>
    </recipes>
    <tickerType>Normal</tickerType>
    <building>
      <uninstallWork>1850</uninstallWork>
    </building>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_BasicMetalworking</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
  </ThingDef>

  <ThingDef ParentName="RockBase">
    <defName>MMT_MineableIronOre</defName>
    <label>铁矿</label>
    <description>露头的铁矿石矿脉，开采后可获得铁矿石，用于炼钢。</description>
    <graphicData>
      <texPath>Things/Building/Linked/RockFlecked_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <color>(125,140,131)</color>
      <colorTwo>(147,144,134)</colorTwo>
    </graphicData>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
    </statBases>
    <building>
      <isResourceRock>true</isResourceRock>
      <mineableThing>MMT_IronOre</mineableThing>
      <mineableYield>75</mineableYield>
      <mineableScatterCommonality>1.0</mineableScatterCommonality>
      <mineableScatterLumpSizeRange>15~25</mineableScatterLumpSizeRange>
      <veinMineable>true</veinMineable>
    </building>
  </ThingDef>

