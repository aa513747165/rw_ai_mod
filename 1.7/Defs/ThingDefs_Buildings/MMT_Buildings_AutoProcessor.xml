<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 矿料进料口：对照原版 Hopper（Building_Storage + isHopper），固定接受岩块与矿粉，
       贴图为 HSK hopper 换色（黄色警示块→青色） -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_Hopper</defName>
    <label>矿料进料口</label>
    <description>为相邻的自动研磨机、自动筛子储存待加工原料。搬运工会自动补充岩块与矿粉。</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_Hopper/MMT_Hopper</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <pathCost>42</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <surfaceType>Item</surfaceType>
    <building>
      <isHopper>true</isHopper>
      <storageGroupTag>MMTHopper</storageGroupTag>
      <blueprintClass>Blueprint_Storage</blueprintClass>
      <fixedStorageSettings>
        <priority>Important</priority>
        <filter>
          <categories>
            <li>StoneChunks</li>
          </categories>
          <thingDefs>
            <li>MMT_OrePowder</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <categories>
            <li>StoneChunks</li>
          </categories>
          <thingDefs>
            <li>MMT_OrePowder</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <castEdgeShadows>true</castEdgeShadows>
    <statBases>
      <WorkToBuild>300</WorkToBuild>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>15</Steel>
      <MMT_Mechanism>2</MMT_Mechanism>
    </costList>
    <tickerType>Never</tickerType>
    <rotatable>true</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <designationCategory>MMT_Production</designationCategory>
    <placeWorkers>
      <li>PlaceWorker_NextToHopperAccepter</li>
    </placeWorkers>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites>
      <li>MMT_AutoOreProcessing</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- 自动研磨机：RockCrusher 静态帧贴图，每 2500 tick 从相邻进料口消耗 1 岩块产 40 矿粉 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_AutoGrinder</defName>
    <label>自动研磨机</label>
    <description>重型破碎研磨机组，从相邻进料口自动吞入岩块并碾成矿粉。无人值守但处理速度较慢。需要持续供电。</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_AutoGrinder/MMT_AutoGrinder</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2,2)</drawSize>
      <drawRotated>false</drawRotated>
    </graphicData>
    <passability>Impassable</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.8</fillPercent>
    <blockWind>true</blockWind>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <costList>
      <Steel>80</Steel>
      <MMT_Mechanism>6</MMT_Mechanism>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>4000</WorkToBuild>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Beauty>-10</Beauty>
      <Cleanliness>-3</Cleanliness>
      <Mass>80</Mass>
    </statBases>
    <size>(2,2)</size>
    <designationCategory>MMT_Production</designationCategory>
    <building>
      <wantsHopperAdjacent>true</wantsHopperAdjacent>
    </building>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>500</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="MyModeTest.CompProperties_AutoProcessor">
        <intervalTicks>2500</intervalTicks>
        <inputCount>1</inputCount>
        <outputDef>MMT_OrePowder</outputDef>
        <outputCountRange>40~40</outputCountRange>
        <inputCategories>
          <li>StoneChunks</li>
        </inputCategories>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_AutoOreProcessing</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
  </ThingDef>

  <!-- 自动筛子：程序化生成贴图（金属框+料斗+电机），每 2500 tick 消耗 20 矿粉随机产 6~10 矿石 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_AutoSieve</defName>
    <label>自动筛子</label>
    <description>带料斗与振动电机的全自动筛分机组，从相邻进料口持续吞入矿粉并筛出矿石。筛出什么全凭矿脉权重。需要持续供电。</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_AutoSieve/MMT_AutoSieve</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <passability>Impassable</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.8</fillPercent>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>80</costStuffCount>
    <costList>
      <MMT_Mechanism>4</MMT_Mechanism>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>3500</WorkToBuild>
      <MaxHitPoints>280</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Beauty>-10</Beauty>
      <Cleanliness>-3</Cleanliness>
      <Mass>60</Mass>
    </statBases>
    <size>(2,2)</size>
    <designationCategory>MMT_Production</designationCategory>
    <building>
      <wantsHopperAdjacent>true</wantsHopperAdjacent>
    </building>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>400</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="MyModeTest.CompProperties_AutoProcessor">
        <intervalTicks>2500</intervalTicks>
        <inputCount>20</inputCount>
        <outputCountRange>6~10</outputCountRange>
        <inputDefs>
          <li>MMT_OrePowder</li>
        </inputDefs>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_AutoOreProcessing</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
  </ThingDef>
</Defs>
