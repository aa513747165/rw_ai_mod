<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_HandAssemblyBench</defName>
    <label>手工装配台</label>
    <description>摆满手工工具的工作台，用于组装基础零件、导线与机构件。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_HandAssemblyBench/MMT_HandAssemblyBench</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.7</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>125</costStuffCount>
    <costList>
      <WoodLog>40</WoodLog>
      <Steel>25</Steel>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>1200</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-8</Cleanliness>
      <WorkTableWorkSpeedFactor>0.9</WorkTableWorkSpeedFactor>
      <Mass>500</Mass>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_MakeComponentMedieval_Wood</li>
      <li>MMT_MakeComponentMedieval_Metal</li>
      <li>MMT_MakeComponentIndustrial_Hand</li>
      <li>MMT_MakeWire_Hand</li>
      <li>MMT_MakeMechanism_Hand</li>
      <li>MMT_MakeComponentSpacer_Hand</li>
      <li>MMT_MakeAdvMechanism_Hand</li>
    </recipes>
    <tickerType>Normal</tickerType>
    <building>
      <uninstallWork>600</uninstallWork>
    </building>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_ComponentCrafting</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>MMT_ElectricAssemblyBench</defName>
    <label>电动装配台</label>
    <description>以电力驱动的装配台，可以更快地组装零件、导线与机构件。需要持续供电。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_ElectricAssemblyBench/MMT_ElectricAssemblyBench</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.7</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>220</costStuffCount>
    <costList>
      <MMT_SyntheticFibers>45</MMT_SyntheticFibers>
      <MMT_IntegratedCircuit>10</MMT_IntegratedCircuit>
      <ComponentIndustrial>15</ComponentIndustrial>
      <MMT_Mechanism>10</MMT_Mechanism>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>5500</WorkToBuild>
      <MaxHitPoints>210</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-2</Cleanliness>
      <WorkTableWorkSpeedFactor>1.5</WorkTableWorkSpeedFactor>
      <Mass>500</Mass>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_MakeComponentMedieval_Wood</li>
      <li>MMT_MakeComponentMedieval_Metal</li>
      <li>MMT_MakeComponentIndustrial_Electric</li>
      <li>MMT_MakeWire_Electric</li>
      <li>MMT_MakeMechanism_Electric</li>
      <li>MMT_MakeComponentSpacer_Electric</li>
      <li>MMT_MakeAdvMechanism_Electric</li>
      <li>MMT_MakeSpacerComponent</li>
      <li>MMT_MakeReinforcedConcrete_Electric</li>
      <li>MMT_MakeMineralSonarModule</li>
      <li>MMT_MakeOverclockModule</li>
      <li>MMT_MakeParallelModule</li>
      <li>MMT_MakeDeployableShield</li>
    </recipes>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>750</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <building>
      <uninstallWork>2750</uninstallWork>
    </building>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_ComponentCrafting</li>
      <li>MMT_AdvancedComponents</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>MMT_RoboticAssembler</defName>
    <label>自动化装配器</label>
    <description>应用最先进机器人技术的装配机器，可以制造人手无法企及的精密零件。工作时需要大量电力。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_RoboticAssembler/MMT_RoboticAssembler</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.7</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>120</costStuffCount>
    <costList>
      <MMT_SyntheticFibers>45</MMT_SyntheticFibers>
      <MMT_SpacerComponent>10</MMT_SpacerComponent>
      <MMT_AdvMechanism>10</MMT_AdvMechanism>
      <MMT_Microchip>5</MMT_Microchip>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>9000</WorkToBuild>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-4</Cleanliness>
      <Mass>100</Mass>
    </statBases>
    <size>(1,1)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_MakeUltraComponent</li>
    </recipes>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>5000</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Glower">
        <glowRadius>2</glowRadius>
        <glowColor>(255,0,0,0)</glowColor>
      </li>
    </comps>
    <building>
      <uninstallWork>4500</uninstallWork>
    </building>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_UltraComponents</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
  </ThingDef>
</Defs>
