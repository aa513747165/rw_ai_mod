  <!-- 器官培养舱：对照 HSK TableOrganvat（发酵槽机制）改为自研简化培养 Comp——
       殖民者搬原料短工时启动，之后通电无人值守培养 1.5 天自动产出（断电暂停）。
       提取生物质随建筑解锁（研究挂义肢制造 IV），8 种器官培养需义肢制造 V。
       贴图为 HSK TableOrganvat2x2_off（已授权）。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_OrganVat</defName>
    <label>器官培养舱</label>
    <description>一个装满营养液的大型培养罐，可以将人类尸体转化为生物质，并用生物质培养出天然器官。选中殖民者右键选择培养内容，搬入原料启动后设备自动培养，需要持续供电。</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_OrganVat/MMT_OrganVat</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.6</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <costList>
      <MMT_Rubber>35</MMT_Rubber>
      <MMT_SyntheticFibers>25</MMT_SyntheticFibers>
      <MMT_Glass>25</MMT_Glass>
      <MMT_ElectronicParts>5</MMT_ElectronicParts>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>6000</WorkToBuild>
      <MaxHitPoints>190</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Mass>80</Mass>
    </statBases>
    <size>(2,2)</size>
    <designationCategory>MMT_Production</designationCategory>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>700</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="MyModeTest.CompProperties_OrganVat">
        <formingTicks>90000</formingTicks>
        <initiateTicks>1800</initiateTicks>
        <products>
          <li>
            <label>提取生物质</label>
            <productDef>MMT_Biomatter</productDef>
            <productCount>20</productCount>
            <useCorpse>true</useCorpse>
          </li>
          <li>
            <label>培养眼</label>
            <productDef>Eye</productDef>
            <ingredientDef>MMT_Biomatter</ingredientDef>
            <ingredientCount>35</ingredientCount>
            <needsOrganResearch>true</needsOrganResearch>
          </li>
          <li>
            <label>培养耳</label>
            <productDef>Ear</productDef>
            <ingredientDef>MMT_Biomatter</ingredientDef>
            <ingredientCount>35</ingredientCount>
            <needsOrganResearch>true</needsOrganResearch>
          </li>
          <li>
            <label>培养鼻</label>
            <productDef>Nose</productDef>
            <ingredientDef>MMT_Biomatter</ingredientDef>
            <ingredientCount>35</ingredientCount>
            <needsOrganResearch>true</needsOrganResearch>
          </li>
          <li>
            <label>培养心脏</label>
            <productDef>Heart</productDef>
            <ingredientDef>MMT_Biomatter</ingredientDef>
            <ingredientCount>35</ingredientCount>
            <needsOrganResearch>true</needsOrganResearch>
          </li>
          <li>
            <label>培养肺</label>
            <productDef>Lung</productDef>
            <ingredientDef>MMT_Biomatter</ingredientDef>
            <ingredientCount>35</ingredientCount>
            <needsOrganResearch>true</needsOrganResearch>
          </li>
          <li>
            <label>培养肝</label>
            <productDef>Liver</productDef>
            <ingredientDef>MMT_Biomatter</ingredientDef>
            <ingredientCount>35</ingredientCount>
            <needsOrganResearch>true</needsOrganResearch>
          </li>
          <li>
            <label>培养肾</label>
            <productDef>Kidney</productDef>
            <ingredientDef>MMT_Biomatter</ingredientDef>
            <ingredientCount>35</ingredientCount>
            <needsOrganResearch>true</needsOrganResearch>
          </li>
          <li>
            <label>培养胃</label>
            <productDef>Stomach</productDef>
            <ingredientDef>MMT_Biomatter</ingredientDef>
            <ingredientCount>35</ingredientCount>
            <needsOrganResearch>true</needsOrganResearch>
          </li>
        </products>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites>
      <li>MMT_Prosthesis_D1</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>14</constructionSkillPrerequisite>
      <!-- 1.7 BuildingBase 不再自带 BuildingProperties,必须显式声明 -->
    <building/>
  </ThingDef>
</Defs>
