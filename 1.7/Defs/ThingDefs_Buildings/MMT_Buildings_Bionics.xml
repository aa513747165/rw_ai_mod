<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 仿生链工作台:对照 HSK Core_SK Buildings_Production_Medicine.xml 五级义肢台,
       SK.CompProperties_IdlePower 换成原版 CompProperties_Power(功耗取 basePowerConsumption),
       自定义材料类别(RuggedMetallic 等)归并到原版 Metallic/Woody/Stony。
       配方经各仿生物品 recipeMaker.recipeUsers 自动注册;人造骨头两个显式配方挂在人造器官组装台。 -->

  <!-- 原始假肢工作台(无电力) -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_PrimitiveProstheticsTable</defName>
    <label>原始假肢工作台</label>
    <description>为生产基本假肢而配备的工作台。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_PrimitiveProstheticsTable/MMT_PrimitiveProstheticsTable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(4,2)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.6</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Stony</li>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>80</costStuffCount>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>3700</WorkToBuild>
      <MaxHitPoints>130</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-6</Cleanliness>
      <Mass>500</Mass>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>MMT_Production</designationCategory>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_Prosthesis_B1</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
      <!-- 1.7 BuildingBase 不再自带 BuildingProperties,必须显式声明 -->
    <building/>
  </ThingDef>

  <!-- 假肢工作台 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_BasicProstheticsTable</defName>
    <label>假肢工作台</label>
    <description>用于生产非常简单的假肢的工作台。需要电力才能正常运作。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_BasicProstheticsTable/MMT_BasicProstheticsTable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.6</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>120</costStuffCount>
    <costList>
      <ComponentIndustrial>12</ComponentIndustrial>
      <MMT_Mechanism>8</MMT_Mechanism>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>3700</WorkToBuild>
      <MaxHitPoints>140</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-3</Cleanliness>
      <Mass>500</Mass>
    </statBases>
    <size>(2,1)</size>
    <designationCategory>MMT_Production</designationCategory>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>350</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_Prosthesis_C2</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
      <!-- 1.7 BuildingBase 不再自带 BuildingProperties,必须显式声明 -->
    <building/>
  </ThingDef>

  <!-- 人造器官组装台 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_SyntheticsTable</defName>
    <label>人造器官组装台</label>
    <description>一个配备了极其强大纳米打印机的工作站，能够生产人造器官和AI芯片。需要电力才能正常运作。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_SyntheticsTable/MMT_SyntheticsTable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3.5,1.5)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.6</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>135</costStuffCount>
    <costList>
      <MMT_Plastic>65</MMT_Plastic>
      <MMT_SyntheticFibers>20</MMT_SyntheticFibers>
      <MMT_IntegratedCircuit>6</MMT_IntegratedCircuit>
      <MMT_SpacerComponent>5</MMT_SpacerComponent>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>5500</WorkToBuild>
      <MaxHitPoints>230</MaxHitPoints>
      <Flammability>0.8</Flammability>
      <Cleanliness>-2</Cleanliness>
      <Mass>500</Mass>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_MakeArtificialBone</li>
      <li>MMT_MakeArtificialBoneBulk</li>
    </recipes>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>850</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_Prosthesis_D3</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>16</constructionSkillPrerequisite>
      <!-- 1.7 BuildingBase 不再自带 BuildingProperties,必须显式声明 -->
    <building/>
  </ThingDef>

