<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 充能台：为可充能设备（如充能护盾腰带）回充电量的 1×1 台座。
       右键建筑由小人手动装卸：空台"装载可充能设备"（从该小人穿戴/背包中选择），
       有设备"取出设备"（确认后取回）。充能时设备飘浮在台座正上方并亮起微弱光柱，
       充能功耗 1500W、待机 25W（动态功耗见 ChargingStation.cs）。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_ChargingStation</defName>
    <label>充能台</label>
    <description>为内置电池的便携式设备回充电量的台座。右键建筑选择"装载可充能设备"，小人会把身上穿戴或携带的设备（如充能护盾腰带）装入台座回充，充满后右键取出。充能时设备会飘浮在台座上方并亮起充能光柱。</description>
    <thingClass>MyModeTest.Building_ChargingStation</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/MMT_ChargingStation</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1.4,1.4)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.3</fillPercent>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <designationCategory>MMT_Production</designationCategory>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>3000</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>0.6</Flammability>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <MMT_Wire>10</MMT_Wire>
    </costList>
    <comps>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1500</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable" />
      <li Class="MyModeTest.CompProperties_ChargingStation">
        <chargeRateWdPerDay>3000</chargeRateWdPerDay>
        <chargePowerW>1500</chargePowerW>
        <idlePowerW>25</idlePowerW>
      </li>
    </comps>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites>
      <li>MMT_RechargeableTech</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <!-- 1.7 BuildingBase 不再自带 BuildingProperties，必须显式声明 -->
    <building/>
  </ThingDef>
</Defs>
