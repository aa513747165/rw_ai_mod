<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 医疗注射炮台：选中后每种库存药品一个"发射"gizmo，瞄准射程内友方小人发射注射弹。
       药仓允许混装、每种药品独立上限（C# CompMedicalTurret 实现），不继承 Building_TurretGun
       （原版炮塔只攻击敌对目标），thingClass 用普通 Building，无敌对 AI，待机零开销。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_MedicalTurret</defName>
    <label>医疗注射炮台</label>
    <description>一座自动注射装置，可将装载的药物以注射弹形式精准发射给射程内的友方小人。注射型药物命中后等同服用，医药则自动为其包扎治疗。需要通电。</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Security/MMT_MedicalTurret_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <shadowData>
        <volume>(0.3, 0.6, 0.3)</volume>
      </shadowData>
    </graphicData>
    <uiIconPath>Things/Building/Security/MMT_MedicalTurret_ico</uiIconPath>
    <size>(2,2)</size>
    <designationCategory>Security</designationCategory>
    <altitudeLayer>Building</altitudeLayer>
    <drawerType>MapMeshAndRealTime</drawerType>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.6</fillPercent>
    <hasTooltip>true</hasTooltip>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <tradeability>None</tradeability>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
    <techLevel>Industrial</techLevel>
    <statBases>
      <WorkToBuild>2500</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>0.7</Flammability>
      <Mass>30</Mass>
      <Beauty>-10</Beauty>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
      <MMT_Wire>8</MMT_Wire>
    </costList>
    <comps>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="MyModeTest.CompProperties_MedicalTurret">
        <range>25</range>
        <cooldownTicks>180</cooldownTicks>
        <maxPerKind>5</maxPerKind>
      </li>
    </comps>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <placeWorkers>
      <li>MyModeTest.PlaceWorker_ShowSpecialRadius</li>
    </placeWorkers>
    <specialDisplayRadius>25</specialDisplayRadius>
    <researchPrerequisites>
      <li>MMT_Medicine_C1</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <!-- 1.7 BuildingBase 不再自带 BuildingProperties，必须显式声明 -->
    <building/>
  </ThingDef>
</Defs>
