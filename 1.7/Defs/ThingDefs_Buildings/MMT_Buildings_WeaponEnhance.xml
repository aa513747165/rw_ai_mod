<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 武器强化台（设计方案 §2）：赌博线强化 +1~+15（每级伤害 ×1.05，满级额外穿甲 +10%）
       + 确定线附魔（模块物品安装，基础 1 槽，+7/+13 解锁第 2/3 槽）。
       强化材料阶梯：+1~+6 常规自产材料，+7 起必须探索据点/任务获取远古材料。
       右键建筑：装载武器（从主手/背包）→ 强化/附魔 → 取出。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_WeaponEnhanceBench</defName>
    <label>武器强化台</label>
    <description>对武器与防具进行强化与附魔的精密工作台。\n\n强化（赌博线）：消耗材料逐级提升，武器每级伤害 ×1.05、防具每级护甲 ×1.03，满级 15 级武器额外护甲穿透 +10%、防具额外护甲 +10%/隔温 +20%；成功率随等级递减（1-3 级必成，15 级仅 5%）。+6 级以后需要探索据点或任务获得的远古材料。\n\n附魔（确定线）：先在本台制作附魔模块，再安装到台内装备，100% 成功；基础 1 个槽位，强化 +7 解锁第 2 槽、+13 解锁第 3 槽。武器与防具模块互不通用。\n\n右键建筑装载武器或防具后开始操作。兼容其它 Mod 的武器与防具（可在 Mod 设置中关闭）。</description>
    <thingClass>MyModeTest.Building_WeaponEnhanceBench</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_WeaponEnhanceBench/MMT_WeaponEnhanceBench</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3.2,3.2)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <designationCategory>MMT_Production</designationCategory>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>6000</WorkToBuild>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Mass>120</Mass>
    </statBases>
    <costList>
      <MMT_ReinforcedGlass>80</MMT_ReinforcedGlass>
      <MMT_RobotParts>20</MMT_RobotParts>
      <MMT_CarbonAlloy>40</MMT_CarbonAlloy>
      <MMT_Microchip>4</MMT_Microchip>
    </costList>
    <!-- 附魔模块制作配方（强化/附魔操作走右键作业，不占配方位） -->
    <recipes>
      <li>MMT_MakeWeaponModSharp</li>
      <li>MMT_MakeWeaponModAccurate</li>
      <li>MMT_MakeWeaponModSwift</li>
      <li>MMT_MakeWeaponModPierce</li>
      <li>MMT_MakeWeaponModDeadly</li>
      <li>MMT_MakeWeaponModGale</li>
      <li>MMT_MakeWeaponModHeavy</li>
      <li>MMT_MakeWeaponModRapid</li>
      <li>MMT_MakeWeaponModEmp</li>
      <li>MMT_MakeWeaponModIncendiary</li>
      <li>MMT_MakeWeaponModLifeLeech</li>
      <li>MMT_MakeWeaponModShieldBreaker</li>
      <li>MMT_MakeWeaponModFrost</li>
      <li>MMT_MakeWeaponModExecute</li>
      <li>MMT_MakeWeaponModChainLightning</li>
      <li>MMT_MakeWeaponModTimeFold</li>
      <li>MMT_MakeWeaponModOverload</li>
      <li>MMT_MakeWeaponModBlitz</li>
      <li>MMT_MakeWeaponModGambler</li>
      <li>MMT_MakeWeaponModRiot</li>
      <li>MMT_MakeWeaponModExplode</li>
      <li>MMT_MakeWeaponModStormCall</li>
      <li>MMT_MakeWeaponModGas</li>
      <li>MMT_MakeWeaponModSuppress</li>
      <li>MMT_MakeWeaponModDisarm</li>
      <li>MMT_MakeWeaponModToxic</li>
      <li>MMT_MakeWeaponModInsectBane</li>
      <li>MMT_MakeWeaponModMending</li>
      <li>MMT_MakeWeaponModGuardian</li>
      <li>MMT_MakeWeaponModInsight</li>
      <li>MMT_MakeWeaponModSureHit</li>
      <!-- 防具附魔模块（防具强化线，槽位类别 ApparelEnchant） -->
      <li>MMT_MakeApparelModFortify</li>
      <li>MMT_MakeApparelModBladeWard</li>
      <li>MMT_MakeApparelModBulwark</li>
      <li>MMT_MakeApparelModWarmth</li>
      <li>MMT_MakeApparelModCooling</li>
      <li>MMT_MakeApparelModHeatWard</li>
      <li>MMT_MakeApparelModAbsorb</li>
      <li>MMT_MakeApparelModEvasion</li>
      <li>MMT_MakeApparelModSwift</li>
      <li>MMT_MakeApparelModPorter</li>
      <li>MMT_MakeApparelModRecovery</li>
      <li>MMT_MakeApparelModEmpShield</li>
      <li>MMT_MakeApparelModDiligent</li>
      <li>MMT_MakeApparelModThorns</li>
      <li>MMT_MakeApparelModDischarge</li>
      <li>MMT_MakeApparelModAegis</li>
      <li>MMT_MakeApparelModFeather</li>
      <li>MMT_MakeApparelModToxicCloud</li>
    </recipes>
    <comps>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1500</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable" />
      <li Class="MyModeTest.CompProperties_WeaponEnhanceBench" />
    </comps>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites>
      <li>MMT_WeaponEnhancement</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,2)</interactionCellOffset>
    <!-- 1.7 BuildingBase 不再自带 BuildingProperties，必须显式声明 -->
    <building/>
  </ThingDef>
</Defs>
