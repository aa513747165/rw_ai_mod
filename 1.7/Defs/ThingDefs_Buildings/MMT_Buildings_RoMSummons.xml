  <!-- 生成物：tools/build_mmt_rom_classes.py，不要手改。召唤建筑（炮塔/图腾/地雷） -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_Bld_SummonPylon</defName>
    <label>魔法防御塔</label>
    <description>召唤的奥术炮塔，自动轰击附近敌人，限时存在。</description>
    <graphicData>
      <texPath>Things/Building/Production/RoM/MMT_SummonPylon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1.4,1.4)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>36000</lifespanTicks>
      </li>
      <li Class="MyModeTest.CompProperties_MMTSummonTurret">
        <mode>attack</mode>
        <damageDef>Bullet</damageDef>
        <damageAmount>12</damageAmount>
        <radius>20</radius>
        <intervalTicks>90</intervalTicks>
      </li>
    </comps>
  </ThingDef>
