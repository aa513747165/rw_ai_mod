<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_HandSawmill</defName>
    <label>手工锯台</label>
    <description>依靠人力切割原木的工作台，用于制作木板和柴火。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_HandSawmill/MMT_HandSawmill</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>80</pathCost>
    <fillPercent>0.6</fillPercent>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>120</costStuffCount>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>700</WorkToBuild>
      <MaxHitPoints>170</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-7</Cleanliness>
      <Mass>500</Mass>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_MakeWoodPlanks_Hand</li>
      <li>MMT_MakeKindling_Hand</li>
    </recipes>
    <tickerType>Normal</tickerType>
    <building>
      <uninstallWork>1250</uninstallWork>
    </building>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_Woodworking</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
  </ThingDef>

  <!-- 窑炉：对标 HSK Kiln 的全能燃料窑（烧木炭/烧砖/陶瓷/焚烧），SK 燃料组件用原版 CompProperties_Refuelable 替代 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_CharcoalKiln</defName>
    <label>窑炉</label>
    <description>烧柴煤的土窑，用于烧制木炭、粘土砖、陶瓷，也可焚烧杂物获取灰烬。可用石砖或粘土砖建造。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_CharcoalKiln/MMT_CharcoalKiln</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>90</pathCost>
    <fillPercent>0.9</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <stuffCategories>
      <li>Stony</li>
      <li>MMT_Bricks</li>
    </stuffCategories>
    <costStuffCount>180</costStuffCount>
    <statBases>
      <WorkToBuild>3000</WorkToBuild>
      <MaxHitPoints>270</MaxHitPoints>
      <Flammability>0</Flammability>
      <Cleanliness>-8</Cleanliness>
      <Mass>500</Mass>
    </statBases>
    <size>(3,3)</size>
    <designationCategory>MMT_Production</designationCategory>
    <recipes>
      <li>MMT_MakeCharcoal_Hand</li>
      <li>MMT_MakeCeramics</li>
      <li>MMT_MakeClayBricks</li>
      <li>MMT_BurnThings</li>
    </recipes>
    <tickerType>Normal</tickerType>
    <building>
      <uninstallWork>1850</uninstallWork>
    </building>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>10.0</fuelConsumptionRate>
        <fuelCapacity>30.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>MMT_Coal</li>
            <li>MMT_Charcoal</li>
            <li>MMT_Kindling</li>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(217,112,33,0)</glowColor>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MMT_CharcoalBurning</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
  </ThingDef>
</Defs>
