<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 深空扫描仪（设计方案 §3）：蓄电充满 + 消耗 1 个矿物声纳模块启动扫描，
       1 天后在世界地图距家 6-30 格处生成探索据点（稀有资源点/轨道遗迹/机械据点，30 天过期）。
       模块槽可装处理速度模块缩短扫描时间。折跃进入/召回走传送台现有链路。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_DeepSpaceScanner</defName>
    <label>深空扫描仪</label>
    <description>向深空发射探测脉冲的大型相控阵，能定位轨道残骸与失落据点的微弱信号。\n\n蓄电充满（30000 Wd）且地图上有矿物声纳模块时可启动扫描：消耗全部蓄电与声纳模块，在世界地图上标出一处探索据点（30 天有效）。扫描分浅层/深层/全域三档——档位越高，声纳模块消耗与扫描时长越大，据点守卫越强，奖励越好。安装处理速度模块可缩短扫描时间。\n\n据点守卫森严，但藏有外界无法生产的远古材料——那是武器高级强化与纪元奇点的关键。</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MMT_DeepSpaceScanner</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(4.6,4.6)</drawSize>
    </graphicData>
    <size>(3,3)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <pathCost>70</pathCost>
    <fillPercent>1</fillPercent>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <designationCategory>MMT_Production</designationCategory>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>8000</WorkToBuild>
      <MaxHitPoints>400</MaxHitPoints>
      <Flammability>0.4</Flammability>
      <Mass>200</Mass>
    </statBases>
    <costList>
      <Steel>150</Steel>
      <MMT_MineralSonarModule>10</MMT_MineralSonarModule>
      <MMT_SpacerComponent>6</MMT_SpacerComponent>
      <Gold>20</Gold>
    </costList>
    <comps>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>3000</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable" />
      <!-- 蓄电 30000 Wd（3000/天回充）；扫描一次清空 -->
      <li Class="MyModeTest.CompProperties_BuildingBattery">
        <maxChargeWd>30000</maxChargeWd>
        <chargeRateWdPerDay>3000</chargeRateWdPerDay>
      </li>
      <!-- 超频模块：扫描提速 +10%/个，最多 5 个（与自动加工设备共用 MMT_OverclockModule） -->
      <li Class="MyModeTest.CompProperties_ModuleSlots">
        <slotLimits>
          <li><key>Overclock</key><max>5</max></li>
        </slotLimits>
      </li>
      <li Class="MyModeTest.CompProperties_DeepSpaceScanner">
        <scanDays>1</scanDays>
        <sonarModulesPerScan>1</sonarModulesPerScan>
        <!-- 三档扫描（mmt-dungeon-design.md §1.1）：模块数/天数成本 × 设置 dungeonTierCostFactor；
             威胁 = clamp(财富/100, 800, 5000) × 据点类型系数 × 档位威胁系数；
             lootTier/品质地板喂装备箱掷点（精良~稀有 ↔ Good~Excellent，史诗~传说 ↔ Masterwork~Legendary） -->
        <scanTiers>
          <li>
            <tier>1</tier>
            <label>浅层扫描</label>
            <sonarModules>1</sonarModules>
            <scanDaysFactor>1.0</scanDaysFactor>
            <threatFactor>1.0</threatFactor>
            <lootTier>1</lootTier>
            <gearQualityMin>Good</gearQualityMin>
            <gearQualityMax>Excellent</gearQualityMax>
          </li>
          <li>
            <tier>2</tier>
            <label>深层扫描</label>
            <sonarModules>2</sonarModules>
            <scanDaysFactor>1.5</scanDaysFactor>
            <threatFactor>1.6</threatFactor>
            <lootTier>2</lootTier>
            <gearQualityMin>Excellent</gearQualityMin>
            <gearQualityMax>Masterwork</gearQualityMax>
          </li>
          <li>
            <tier>3</tier>
            <label>全域扫描</label>
            <sonarModules>3</sonarModules>
            <scanDaysFactor>2.0</scanDaysFactor>
            <threatFactor>2.5</threatFactor>
            <lootTier>3</lootTier>
            <gearQualityMin>Masterwork</gearQualityMin>
            <gearQualityMax>Legendary</gearQualityMax>
          </li>
        </scanTiers>
        <!-- 据点加权池（§0 清单 XML 化；其它 mod 可 XPath 追加自己的据点条目）。
             Boss 巢穴（MMT_SitePart_BossLair）锁定 III 档、不进随机池，由任务链/Dev 生成。 -->
        <sitePool>
          <li>
            <sitePart>MMT_SitePart_RareDeposit</sitePart>
            <label>稀有资源点</label>
            <weight>28</weight>
            <threatFactor>0.5</threatFactor>
          </li>
          <li>
            <sitePart>MMT_SitePart_OrbitalRuinCache</sitePart>
            <label>轨道遗迹</label>
            <weight>22</weight>
            <threatFactor>1.0</threatFactor>
            <mechGuardFallback>true</mechGuardFallback>
          </li>
          <li>
            <sitePart>MMT_SitePart_StrongholdCache</sitePart>
            <label>机械据点</label>
            <weight>12</weight>
            <threatFactor>1.6</threatFactor>
            <mechGuardFallback>true</mechGuardFallback>
          </li>
          <li>
            <sitePart>MMT_SitePart_TrainingGround</sitePart>
            <label>试炼场</label>
            <weight>22</weight>
            <threatFactor>1.2</threatFactor>
            <factionGuards>true</factionGuards>
          </li>
          <li>
            <sitePart>MMT_SitePart_ClassShrine</sitePart>
            <label>职业圣殿</label>
            <weight>16</weight>
            <threatFactor>1.4</threatFactor>
            <factionGuards>true</factionGuards>
          </li>
          <!-- Boss 巢穴：低概率进池（权重 4/104 ≈ 3.8%），受 bossEncountersEnabled 设置门控 -->
          <li>
            <sitePart>MMT_SitePart_BossLair</sitePart>
            <label>远古守卫巢穴</label>
            <weight>4</weight>
            <threatFactor>2.0</threatFactor>
            <factionGuards>true</factionGuards>
            <requiresBossEncounters>true</requiresBossEncounters>
          </li>
        </sitePool>
      </li>
    </comps>
    <inspectorTabs>
      <li>MyModeTest.ITab_ModuleSlots</li>
    </inspectorTabs>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites>
      <li>MMT_DeepSpaceScan</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <!-- 1.7 BuildingBase 不再自带 BuildingProperties，必须显式声明 -->
    <building/>
  </ThingDef>
</Defs>
