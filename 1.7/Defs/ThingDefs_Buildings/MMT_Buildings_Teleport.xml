<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 折跃传送台：后期传送建筑。装载体系复用原版 CompTransporter（搬运/走入 Job、
       质量上限、ITab_ContentsTransporter 全免费，装载/取消 gizmo 由原版自带）；
       自定义 CompTeleportPad 提供"启动传送"（世界地图选已有地图目标瞬间空降）
       与召回执行端（配合 Architect 菜单的召回框选 Designator）。
       次数制：待机 3000W；开启并通电时以 3000Wd/天自动蓄电（内置储能 15000Wd，约 5 天充满），
       蓄电每充满一次转化为 1 次传送并重新蓄电；次数上限 = 1 + 次元传送模块数（最多 10 个），
       次数为 0 时进入等待蓄电的 CD。充能效率模块（最多 5 个）每个提升 10% 蓄电速度。
       贴图为 HSK 蓝色传送门（Core_SK Genstep/Blueportal，已授权）。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MMT_TeleportPad</defName>
    <label>折跃传送台</label>
    <description>量子折跃装置，可将舱内的人员和物资传送到世界地图上任意地块：敌对据点为折跃进攻（跳图后自选落点，光柱落地后载荷全部吐出、载体消散），非敌对定居点直接在世界地图该格组成商队（货物挂成员背包、可正常交易；隐身穿梭机随行，随时可发射折跃返回——返回时除出发时携带的物品外全部吐出，返回再消耗一次传送），空白地块会生成荒野临时地图（人员全部撤离后自动销毁，遗留物品随图消失），己方基地可精确选落点；也可从目标地图框选召回。接入电网并保持开启即可自动蓄电（3000Wd/天），蓄电每充满一次转化为 1 次传送次数并重新蓄电，次数上限 1 次；安装次元传送模块可提高次数上限（每个 +1，最多 10 个），安装充能效率模块可提升蓄电速度（每个 +10%，最多 5 个）。</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/MMT_TeleportPad</texPath>
      <graphicClass>MyModeTest.MMT_Graphic_Rotating</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(4,4)</drawSize>
      <drawRotated>false</drawRotated>
    </graphicData>
    <size>(3,3)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.3</fillPercent>
    <rotatable>true</rotatable>
    <!-- 必须 RealtimeOnly：BuildingBase 默认 MapMeshOnly（贴图烘焙进静态区块网格，
         DrawWorker 只在区块重建时走一次），传送台的 MMT_Graphic_Rotating 自转需要
         每帧 Graphic.Draw；MapMeshAndRealTime 下 DrawAt 仍不画基础贴图，只有
         RealtimeOnly 会让 DrawAt 每帧调用 Graphic.Draw -->
    <drawerType>RealtimeOnly</drawerType>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <tickerType>Normal</tickerType>
    <designationCategory>MMT_Production</designationCategory>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>12000</WorkToBuild>
      <MaxHitPoints>500</MaxHitPoints>
      <Flammability>0</Flammability>
      <Mass>100</Mass>
    </statBases>
    <costList>
      <Plasteel>120</Plasteel>
      <Uranium>40</Uranium>
      <ComponentSpacer>6</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>3000</basePowerConsumption>
      </li>
      <li Class="CompProperties_Transporter">
        <massCapacity>1000</massCapacity>
        <canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting>
      </li>
      <li Class="MyModeTest.CompProperties_TeleportPad" />
      <!-- 增效模块槽：充能效率模块（蓄电提速 +10%/个，最多 5）+ 次元传送模块（次数上限 +1/个，最多 10） -->
      <li Class="MyModeTest.CompProperties_ModuleSlots">
        <slotLimits>
          <li><key>ChargeEfficiency</key><max>5</max></li>
          <li><key>TeleportCharge</key><max>10</max></li>
        </slotLimits>
      </li>
      <!-- 建筑蓄电：蓄满 15000Wd 转化为 1 次传送次数并重新蓄电；3000 Wd/天 ≈ 待机功耗，5 天充满 -->
      <li Class="MyModeTest.CompProperties_BuildingBattery">
        <maxChargeWd>15000</maxChargeWd>
        <chargeRateWdPerDay>3000</chargeRateWdPerDay>
      </li>
    </comps>
    <inspectorTabs>
      <li>ITab_ContentsTransporter</li>
      <li>MyModeTest.ITab_ModuleSlots</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites>
      <li>MMT_Teleportation</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
      <!-- 1.7 BuildingBase 不再自带 BuildingProperties,必须显式声明 -->
    <building/>
  </ThingDef>
</Defs>
