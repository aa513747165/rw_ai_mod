<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 熔火元素种族（魔兽火元素风格 Boss + 召唤物）：
       fleshType Insectoid 是纯 XML 下让 Boss 获得常驻敌对派系的关键——BossPool.ResolveBossFaction
       对虫族返回虫巢派系（Core 原生，无 DLC 门槛），Boss 因此不经 ManhunterPermanent（精神崩溃
       会覆盖 ThinkTree 导致技能放不出），自定义 ThinkTree 中的 JobGiver_AIAbilityFight 得以驱动
       三个技能。Flammability 0 免疫点燃 + ArmorRating_Heat 1.0 耐火，火元素招牌特性。 -->

  <!-- ========== 熔火元素领主（Boss 本体） ========== -->
  <ThingDef ParentName="BasePawn">
    <defName>MMT_FireElementalLord</defName>
    <label>熔火元素领主</label>
    <description>元素位面的火焰主宰。黑曜石般的岩躯缝隙间流淌着永不熄灭的熔岩，胸口的核心是它全部力量的源泉。它踏过之处，只余灰烬。</description>
    <statBases>
      <Mass>180</Mass>
      <MoveSpeed>3.2</MoveSpeed>
      <Flammability>0</Flammability>
      <ComfyTemperatureMin>-30</ComfyTemperatureMin>
      <ComfyTemperatureMax>300</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.45</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.35</ArmorRating_Blunt>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <ToxicResistance>1</ToxicResistance>
      <PsychicSensitivity>0.5</PsychicSensitivity>
      <Wildness>1</Wildness>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
    </statBases>
    <tradeability>None</tradeability>
    <race>
      <body>QuadrupedAnimalWithPaws</body>
      <thinkTreeMain>MMT_FireElementalLord</thinkTreeMain>
      <thinkTreeConstant>MMT_FireElementalConstant</thinkTreeConstant>
      <renderTree>Animal</renderTree>
      <intelligence>ToolUser</intelligence>
      <fleshType>Insectoid</fleshType>
      <alwaysViolent>true</alwaysViolent>
      <hasGenders>false</hasGenders>
      <needsRest>false</needsRest>
      <foodType>None</foodType>
      <trainability>None</trainability>
      <herdAnimal>false</herdAnimal>
      <baseBodySize>2.6</baseBodySize>
      <baseHealthScale>5.5</baseHealthScale>
      <lifeExpectancy>1000</lifeExpectancy>
      <bleedRateFactor>0.2</bleedRateFactor>
      <isImmuneToInfections>true</isImmuneToInfections>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
      <soundMeleeDodge>Pawn_MeleeDodge</soundMeleeDodge>
      <lifeStageAges>
        <li>
          <def>AnimalAdult</def>
        </li>
      </lifeStageAges>
    </race>
    <tools>
      <li>
        <label>熔岩左拳</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>26</power>
        <cooldownTime>2.2</cooldownTime>
        <armorPenetration>0.35</armorPenetration>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>熔岩右拳</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>26</power>
        <cooldownTime>2.2</cooldownTime>
        <armorPenetration>0.35</armorPenetration>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>头槌</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>18</power>
        <cooldownTime>2.6</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
  </ThingDef>

  <!-- ========== 小火元素（召唤物） ========== -->
  <ThingDef ParentName="BasePawn">
    <defName>MMT_FireElementalLesser</defName>
    <label>小火元素</label>
    <description>从熔火元素领主身上分裂出的火焰碎块，悬浮的岩核被烈焰环绕。存在时间有限，但烧起来毫不含糊。</description>
    <statBases>
      <Mass>40</Mass>
      <MoveSpeed>4.2</MoveSpeed>
      <Flammability>0</Flammability>
      <ComfyTemperatureMin>-30</ComfyTemperatureMin>
      <ComfyTemperatureMax>300</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <ToxicResistance>1</ToxicResistance>
      <PsychicSensitivity>0.5</PsychicSensitivity>
      <Wildness>1</Wildness>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
    </statBases>
    <tradeability>None</tradeability>
    <race>
      <body>QuadrupedAnimalWithPaws</body>
      <thinkTreeMain>MMT_FireElementalLesser</thinkTreeMain>
      <thinkTreeConstant>MMT_FireElementalConstant</thinkTreeConstant>
      <renderTree>Animal</renderTree>
      <intelligence>ToolUser</intelligence>
      <fleshType>Insectoid</fleshType>
      <alwaysViolent>true</alwaysViolent>
      <hasGenders>false</hasGenders>
      <needsRest>false</needsRest>
      <foodType>None</foodType>
      <trainability>None</trainability>
      <herdAnimal>false</herdAnimal>
      <baseBodySize>0.9</baseBodySize>
      <baseHealthScale>1.2</baseHealthScale>
      <lifeExpectancy>1000</lifeExpectancy>
      <bleedRateFactor>0.2</bleedRateFactor>
      <isImmuneToInfections>true</isImmuneToInfections>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <lifeStageAges>
        <li>
          <def>AnimalAdult</def>
        </li>
      </lifeStageAges>
    </race>
    <tools>
      <li>
        <label>灼热拍击</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>灼热拍击</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
      </li>
    </tools>
  </ThingDef>
</Defs>
