<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 药品链 Hediff：数值对齐 HSK（Hediffs_MedicalDrink.xml、HerbalTea/ActivatedCarbon/Drugs/Methadone.xml 内联 hediff），
       全部使用原版 hediffClass/comps，剔除 SK 专有机制（腹泻、直接削减食物中毒） -->

  <!-- 抗生素药效：对照 HSK MedicalDrink hediff（提升血液过滤=免疫力） -->
  <HediffDef>
    <defName>MMT_MedicalDrinkBoost</defName>
    <label>抗生素</label>
    <description>抗生素在体内起效，增强免疫系统。</description>
    <labelNoun>一剂抗生素</labelNoun>
    <defaultLabelColor>(255,102,102)</defaultLabelColor>
    <initialSeverity>0.35</initialSeverity>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.5</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>隐性</label>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <minSeverity>0.01</minSeverity>
        <label>感觉好转</label>
        <painFactor>0.9</painFactor>
        <capMods>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>0.20</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.25</minSeverity>
        <label>免疫力增强</label>
        <painFactor>0.8</painFactor>
        <capMods>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>0.30</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>头脑昏沉</label>
        <painFactor>0.5</painFactor>
        <capMods>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>0.40</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.7</minSeverity>
        <label>过量</label>
        <painFactor>0.3</painFactor>
        <vomitMtbDays>0.1</vomitMtbDays>
        <painOffset>0.05</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.60</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.9</minSeverity>
        <label>严重过量</label>
        <painFactor>0.3</painFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- 草药茶药效：对照 HSK HerbalTeaConsumed（镇痛、加速代谢、令人疲倦） -->
  <HediffDef>
    <defName>MMT_HerbalTeaConsumed</defName>
    <label>草药茶</label>
    <description>草药茶的温和药效。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>3.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.0</severityPerDay>
        <showDaysToRecover>true</showDaysToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
        <label>茶效消退中</label>
        <painFactor>0.95</painFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
          <li>
            <capacity>Metabolism</capacity>
            <offset>0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.2</minSeverity>
        <label>草药茶的抚慰</label>
        <painFactor>0.9</painFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
          <li>
            <capacity>Metabolism</capacity>
            <offset>0.2</offset>
          </li>
        </capMods>
        <restFallFactorOffset>0.1</restFallFactorOffset>
      </li>
    </stages>
  </HediffDef>

  <!-- 活性炭药效：对照 HSK ActivatedCarbonConsumed（加速代谢排毒；SK 腹泻机制剔除） -->
  <HediffDef>
    <defName>MMT_ActivatedCarbonConsumed</defName>
    <label>活性炭</label>
    <description>活性炭在肠胃中吸附毒素。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>3.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.0</severityPerDay>
        <showDaysToRecover>true</showDaysToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
        <label>排毒中</label>
        <painFactor>0.95</painFactor>
        <capMods>
          <li>
            <capacity>Metabolism</capacity>
            <offset>0.15</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- 狂暴草药效：对照 HSK Berserk_herb_high（高剂量随机心脏病） -->
  <HediffDef>
    <defName>MMT_BerserkHerbHigh</defName>
    <label>狂暴草</label>
    <description>狂暴草的猛烈药效。</description>
    <hediffClass>Hediff_High</hediffClass>
    <defaultLabelColor>(1,0.5,0)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.6</severityPerDay>
        <showDaysToRecover>true</showDaysToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
        <label>狂暴草兴奋</label>
        <painFactor>0.72</painFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.15</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>0.15</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.72</minSeverity>
        <label>危险的亢奋</label>
        <painFactor>0.5</painFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.3</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>0.3</offset>
          </li>
        </capMods>
        <hediffGivers>
          <li Class="HediffGiver_Random">
            <hediff>HeartAttack</hediff>
            <allowOnLodgers>false</allowOnLodgers>
            <allowOnQuestRewardPawns>false</allowOnQuestRewardPawns>
            <allowOnQuestReservedPawns>false</allowOnQuestReservedPawns>
            <allowOnBeggars>false</allowOnBeggars>
            <mtbDays>5</mtbDays>
            <partsToAffect>
              <li>Heart</li>
            </partsToAffect>
          </li>
        </hediffGivers>
      </li>
    </stages>
  </HediffDef>

  <!-- 美沙酮药效：对照 HSK MethadoneHigh（仅"已用药"状态，压制戒断靠 chemical=Psychite 机制） -->
  <HediffDef>
    <defName>MMT_MethadoneHigh</defName>
    <label>美沙酮</label>
    <description>美沙酮在体内起效，压制戒断症状。</description>
    <hediffClass>Hediff_High</hediffClass>
    <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.0</severityPerDay>
        <showDaysToRecover>true</showDaysToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <label>已用药</label>
        <painFactor>0.9</painFactor>
      </li>
    </stages>
  </HediffDef>

  <!-- 止痛药药效：对照 HSK IbuprofenHigh -->
  <HediffDef>
    <defName>MMT_IbuprofenHigh</defName>
    <label>止痛药</label>
    <description>疼痛被止痛药阻断。</description>
    <hediffClass>Hediff_High</hediffClass>
    <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.3</severityPerDay>
        <showDaysToRecover>true</showDaysToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0.1</minSeverity>
        <label>感觉好转</label>
        <painFactor>0.35</painFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.9</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
