  <HediffDef>
    <defName>MMT_Perk_Veteran</defName>
    <label>老兵</label>
    <description>身经百战：射击精度提升 5%。</description>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <statFactors>
          <ShootingAccuracyPawn>1.05</ShootingAccuracyPawn>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
