<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 冰霜减速（冰霜附魔模块命中特效）：移速 -1.0（约 -20%），持续 180 tick（3 秒），重复命中刷新 -->
  <HediffDef>
    <defName>MMT_Hediff_FrostSlow</defName>
    <label>冰霜减速</label>
    <description>被低温弹头命中，肢体僵硬，移动速度降低。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>180~180</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>-1.0</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- 致盲（致盲附魔模块命中特效）：视力 -30%，持续 300 tick（5 秒），重复命中刷新 -->
  <HediffDef>
    <defName>MMT_Hediff_Blinded</defName>
    <label>致盲</label>
    <description>被强光眩目弹头命中，暂时视物不清。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300~300</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <!-- Sight 是 PawnCapacityDef 而非 StatDef，必须走 capMods（statOffsets 会报红字） -->
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <offset>-0.3</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- 蚀甲（蚀甲附魔模块命中特效）：利刃/钝器护甲 -25%，持续 300 tick（5 秒），重复命中刷新 -->
  <HediffDef>
    <defName>MMT_Hediff_ArmorShred</defName>
    <label>护甲腐蚀</label>
    <description>被强酸蚀刻弹头命中，护甲结构被腐蚀削弱。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300~300</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ArmorRating_Sharp>-0.25</ArmorRating_Sharp>
          <ArmorRating_Blunt>-0.25</ArmorRating_Blunt>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>
