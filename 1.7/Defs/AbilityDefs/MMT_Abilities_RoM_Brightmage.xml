<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 生成物：tools/build_mmt_rom_classes.py + tools/data/mmt_rom_class_mapping.json，
       不要手改（改动会在重跑时被覆盖）。光法师 职业技能 -->
  <AbilityDef ParentName="PsycastBase">
    <defName>MMT_Magic_LightLance</defName>
    <label>光矛</label>
    <description>聚光成矛，烧穿施法者与目标连线上的所有敌人。</description>
    <iconPath>UI/RoM/lightlance</iconPath>
    <writeCombatLog>true</writeCombatLog>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <statBases>
      <Ability_EntropyGain>8</Ability_EntropyGain>
      <Ability_PsyfocusCost>0.01</Ability_PsyfocusCost>
    </statBases>
    <cooldownTicksRange>7200</cooldownTicksRange>
    <verbProperties>
      <warmupTime>0.5</warmupTime>
      <range>24.9</range>
      <soundCast>MMT_FireBurn</soundCast>
      <soundCastTail>MMT_Vibration</soundCastTail>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <canTargetSelf>false</canTargetSelf>
        <canTargetBuildings>false</canTargetBuildings>
        <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MyModeTest.CompProperties_MMTLightSpear">
        <damageDef>Burn</damageDef>
        <damageAmount>14</damageAmount>
        <armorPen>0.15</armorPen>
        <igniteChance>0.5</igniteChance>
        <beamFleckDefName>MMT_Fleck_LightBeam</beamFleckDefName>
        <beamWidth>0.7</beamWidth>
        <impactFleckDefName>MMT_Fleck_Holy</impactFleckDefName>
        <impactFleckScale>3</impactFleckScale>
        <friendlyFire>false</friendlyFire>
      </li>
      <li Class="MyModeTest.CompProperties_MMTFleckFX">
        <casterFleckDefName>MMT_Fleck_Twinkle</casterFleckDefName>
        <targetFleckDefName>MMT_Fleck_Twinkle</targetFleckDefName>
      </li>
    </comps>
  </AbilityDef>
  <AbilityDef ParentName="PsycastBase">
    <defName>MMT_Magic_LightBurst</defName>
    <label>闪光爆发</label>
    <description>强光爆发，致盲区域敌人。</description>
    <iconPath>UI/RoM/lightburst</iconPath>
    <writeCombatLog>true</writeCombatLog>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <statBases>
      <Ability_EntropyGain>16</Ability_EntropyGain>
      <Ability_PsyfocusCost>0.02</Ability_PsyfocusCost>
    </statBases>
    <cooldownTicksRange>3600</cooldownTicksRange>
    <verbProperties>
      <warmupTime>0.5</warmupTime>
      <range>24.9</range>
      <soundCast>MMT_SoftExplosion</soundCast>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MyModeTest.CompProperties_MMTGiveHediffAoE">
        <hediffDef>MMT_HD_Blind</hediffDef>
        <radius>6</radius>
        <targetFriendly>false</targetFriendly>
        <includeSelf>false</includeSelf>
      </li>
      <li Class="MyModeTest.CompProperties_MMTFleckFX">
        <casterFleckDefName>MMT_Fleck_Twinkle</casterFleckDefName>
        <targetFleckDefName>ExplosionFlash</targetFleckDefName>
        <targetScale>10</targetScale>
        <targetBurstCount>6</targetBurstCount>
        <targetBurstRadius>5</targetBurstRadius>
        <targetBurstFleckDefName>MMT_Fleck_Twinkle</targetBurstFleckDefName>
      </li>
    </comps>
  </AbilityDef>
