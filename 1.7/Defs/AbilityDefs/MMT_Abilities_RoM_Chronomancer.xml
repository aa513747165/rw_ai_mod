<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 生成物：tools/build_mmt_rom_classes.py + tools/data/mmt_rom_class_mapping.json，
       不要手改（改动会在重跑时被覆盖）。时空法师 职业技能 -->
  <AbilityDef ParentName="PsycastBase">
    <defName>MMT_Magic_AlterFate</defName>
    <label>改写命运</label>
    <description>记录当前健康状态；限时内遭受致死伤害时回溯抵消（RoM 的预言资源简化为纯冷却）。</description>
    <iconPath>UI/RoM/alterfate</iconPath>
    <writeCombatLog>false</writeCombatLog>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <statBases>
      <Ability_EntropyGain>35</Ability_EntropyGain>
      <Ability_PsyfocusCost>0.04</Ability_PsyfocusCost>
    </statBases>
    <cooldownTicksRange>36000</cooldownTicksRange>
    <verbProperties>
      <warmupTime>0.5</warmupTime>
      <range>0</range>
      <soundCast>MMT_Gong</soundCast>
      <soundCastTail>MMT_Thunder_OffMap</soundCastTail>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>false</canTargetLocations>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetHumans>false</canTargetHumans>
        <canTargetMechs>false</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MyModeTest.CompProperties_MMTAlterFate">
        <fateHediffDef>MMT_HD_AlterFate</fateHediffDef>
      </li>
      <li Class="MyModeTest.CompProperties_MMTFleckFX">
        <casterFleckDefName>MMT_Fleck_AlterFate</casterFleckDefName>
      </li>
    </comps>
  </AbilityDef>
  <AbilityDef ParentName="PsycastBase">
    <defName>MMT_Magic_AccelerateTime</defName>
    <label>时间加速</label>
    <description>区域内敌人时间加速老化：行动迟缓、饥饿加剧（简化版）。</description>
    <iconPath>UI/RoM/acceleratetime</iconPath>
    <writeCombatLog>true</writeCombatLog>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <statBases>
      <Ability_EntropyGain>16</Ability_EntropyGain>
      <Ability_PsyfocusCost>0.02</Ability_PsyfocusCost>
    </statBases>
    <cooldownTicksRange>3600</cooldownTicksRange>
    <verbProperties>
      <warmupTime>0.5</warmupTime>
      <range>24.9</range>
      <soundCast>MMT_Vibration</soundCast>
      <soundCastTail>MMT_VibrationLow</soundCastTail>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MyModeTest.CompProperties_MMTGiveHediffAoE">
        <hediffDef>MMT_HD_AccelTime</hediffDef>
        <radius>5</radius>
        <targetFriendly>false</targetFriendly>
        <includeSelf>false</includeSelf>
      </li>
      <li Class="MyModeTest.CompProperties_MMTFleckFX">
        <casterFleckDefName>MMT_Fleck_AlterFate</casterFleckDefName>
        <targetFleckDefName>MMT_Fleck_AlterFate</targetFleckDefName>
      </li>
    </comps>
  </AbilityDef>
</Defs>
