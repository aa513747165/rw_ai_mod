      <warmupTime>0.5</warmupTime>
      <range>24.9</range>
      <soundCast>DropPod_Open</soundCast>
      <soundCastTail>GunTail_Medium</soundCastTail>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
