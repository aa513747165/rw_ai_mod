  <AbilityDef ParentName="PsycastBase">
    <defName>MMT_Magic_FitnessBrand</defName>
    <label>体能烙印</label>
    <description>烙印强化目标体能。</description>
    <level>1</level>
    <iconPath>UI/RoM/fitnessbrand</iconPath>
    <writeCombatLog>false</writeCombatLog>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <statBases>
      <Ability_EntropyGain>8</Ability_EntropyGain>
      <Ability_PsyfocusCost>0.01</Ability_PsyfocusCost>
    </statBases>
    <cooldownTicksRange>120</cooldownTicksRange>
    <verbProperties>
      <warmupTime>0.5</warmupTime>
      <range>24.9</range>
      <soundCast>MMT_Vibration</soundCast>
      <soundCastTail>GunTail_Medium</soundCastTail>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetSelf>true</canTargetSelf>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetBuildings>false</canTargetBuildings>
        <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff">
        <hediffDef>MMT_HD_BrandFitness</hediffDef>
        <psychic>true</psychic>
        <durationMultiplier>PsychicSensitivity</durationMultiplier>
        <applicableToMechs>false</applicableToMechs>
      </li>
      <li Class="MyModeTest.CompProperties_MMTFleckFX">
        <casterFleckDefName>MMT_Fleck_GlowingRune</casterFleckDefName>
        <targetFleckDefName>MMT_Fleck_GlowingRune</targetFleckDefName>
      </li>
    </comps>
  </AbilityDef>
