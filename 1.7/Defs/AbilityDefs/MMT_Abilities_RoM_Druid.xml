<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 生成物：tools/build_mmt_rom_classes.py + tools/data/mmt_rom_class_mapping.json，
       不要手改（改动会在重跑时被覆盖）。德鲁伊 职业技能 -->
  <AbilityDef ParentName="PsycastBase">
    <defName>MMT_Magic_Poison</defName>
    <label>施毒术</label>
    <description>使目标中毒（毒性积累）。</description>
    <level>1</level>
    <iconPath>UI/RoM/poison</iconPath>
    <writeCombatLog>true</writeCombatLog>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <statBases>
      <Ability_EntropyGain>8</Ability_EntropyGain>
      <Ability_PsyfocusCost>0.01</Ability_PsyfocusCost>
    </statBases>
    <cooldownTicksRange>1200</cooldownTicksRange>
    <verbProperties>
      <warmupTime>0.5</warmupTime>
      <range>24.9</range>
      <soundCast>ThrowMolotovCocktail</soundCast>
      <soundCastTail>GunTail_Medium</soundCastTail>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <canTargetSelf>false</canTargetSelf>
        <canTargetBuildings>false</canTargetBuildings>
        <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff">
        <hediffDef>ToxicBuildup</hediffDef>
        <psychic>true</psychic>
        <durationMultiplier>PsychicSensitivity</durationMultiplier>
        <applicableToMechs>false</applicableToMechs>
      </li>
      <li Class="MyModeTest.CompProperties_MMTFleckFX">
        <casterFleckDefName>MMT_Fleck_Flowers</casterFleckDefName>
        <targetFleckDefName>MMT_Fleck_Flowers</targetFleckDefName>
      </li>
    </comps>
  </AbilityDef>
