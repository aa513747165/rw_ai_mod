  <AbilityDef ParentName="PsycastBase">
    <defName>MMT_Magic_BloodGift</defName>
    <label>鲜血献祭</label>
    <description>自残放血，换取心灵熵下降（RoM 的回蓝灵能化改编）。</description>
    <level>1</level>
    <iconPath>UI/RoM/bloodgift</iconPath>
    <writeCombatLog>false</writeCombatLog>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <statBases>
      <Ability_EntropyGain>8</Ability_EntropyGain>
      <Ability_PsyfocusCost>0.01</Ability_PsyfocusCost>
    </statBases>
    <cooldownTicksRange>180</cooldownTicksRange>
    <verbProperties>
      <warmupTime>0.5</warmupTime>
      <range>0</range>
      <targetRequired>false</targetRequired>
      <soundCast>MMT_VibrationLow</soundCast>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>false</canTargetLocations>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetHumans>false</canTargetHumans>
        <canTargetMechs>false</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MyModeTest.CompProperties_MMTSelfEntropy">
        <entropyChange>-15</entropyChange>
        <selfDamage>8</selfDamage>
      </li>
      <li Class="MyModeTest.CompProperties_MMTFleckFX">
        <casterFleckDefName>MMT_Fleck_BloodMist</casterFleckDefName>
      </li>
    </comps>
  </AbilityDef>
