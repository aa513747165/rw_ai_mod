<Defs>
  <!-- 生成物：tools/build_mmt_rom_classes.py + tools/data/mmt_rom_class_mapping.json，
       不要手改（改动会在重跑时被覆盖）。死灵法师 职业技能 -->
  <AbilityDef ParentName="PsycastBase">
    <defName>MMT_Magic_RaiseUndead</defName>
    <label>死者苏生</label>
    <description>把一具尸体点化为食尸鬼仆从，限时存在。</description>
    <iconPath>UI/RoM/raiseundead</iconPath>
    <writeCombatLog>true</writeCombatLog>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <statBases>
      <Ability_EntropyGain>16</Ability_EntropyGain>
      <Ability_PsyfocusCost>0.02</Ability_PsyfocusCost>
    </statBases>
    <cooldownTicksRange>180</cooldownTicksRange>
    <verbProperties>
      <warmupTime>0.5</warmupTime>
      <range>24.9</range>
      <soundCast>ThrowMolotovCocktail</soundCast>
      <soundCastTail>GunTail_Medium</soundCastTail>
      <targetParams>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetItems>false</canTargetItems>
        <canTargetCorpses>true</canTargetCorpses>
        <onlyTargetCorpses>true</onlyTargetCorpses>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MyModeTest.CompProperties_MMTSummon">
        <pawnKindDef>Ghoul</pawnKindDef>
        <count>1</count>
        <durationTicks>36000</durationTicks>
        <maxActive>3</maxActive>
        <fromCorpse>true</fromCorpse>
      </li>
      <li Class="MyModeTest.CompProperties_MMTFleckFX">
        <casterFleckDefName>MMT_Fleck_SummoningCircle</casterFleckDefName>
        <targetFleckDefName>MMT_Fleck_SummoningCircle</targetFleckDefName>
      </li>
    </comps>
  </AbilityDef>
  <AbilityDef ParentName="PsycastBase">
    <defName>MMT_Magic_DeathMark</defName>
    <label>死亡印记（I）</label>
    <description>烙印死亡印记：目标命中与攻击欲大幅下降。</description>
    <iconPath>UI/RoM/deathmark</iconPath>
