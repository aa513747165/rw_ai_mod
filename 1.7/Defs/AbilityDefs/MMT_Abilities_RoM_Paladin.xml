  <AbilityDef ParentName="PsycastBase">
    <defName>MMT_Magic_Heal</defName>
    <label>圣光术</label>
    <description>圣光治疗目标数处伤口并止血。</description>
    <level>1</level>
    <iconPath>UI/RoM/Heal</iconPath>
    <writeCombatLog>false</writeCombatLog>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <statBases>
      <Ability_EntropyGain>8</Ability_EntropyGain>
      <Ability_PsyfocusCost>0.01</Ability_PsyfocusCost>
    </statBases>
    <cooldownTicksRange>900</cooldownTicksRange>
    <verbProperties>
      <warmupTime>0.5</warmupTime>
      <range>24.9</range>
      <soundCast>Message_PositiveEvent</soundCast>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetSelf>true</canTargetSelf>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetBuildings>false</canTargetBuildings>
        <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MyModeTest.CompProperties_MMTHeal">
        <healAmount>8</healAmount>
        <maxInjuries>3</maxInjuries>
        <tendBleeding>true</tendBleeding>
      </li>
      <li Class="MyModeTest.CompProperties_MMTFleckFX">
        <casterFleckDefName>MMT_Fleck_Healing_Small</casterFleckDefName>
        <targetFleckDefName>MMT_Fleck_Healing_Small</targetFleckDefName>
      </li>
    </comps>
  </AbilityDef>
