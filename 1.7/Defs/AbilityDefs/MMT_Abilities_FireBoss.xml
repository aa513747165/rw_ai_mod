<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 熔火元素领主 Boss 技能（纯 CD 路线，用户指定）：
       不挂 PsycastBase 父类——无灵能熵/精神力消耗，showPsycastEffects 关闭，
       节奏完全由 cooldownTicksRange 控制（对照 Anomaly 实体技能 Heatspikes/ConsumeLeap 写法）；
       aiCanUse + ai_IsOffensive 开启，由 ThinkTree 的 JobGiver_AIAbilityFight 驱动施放。
       效果桶全部走 MMT 技能特效框架（SkillFX 系列 pawn 侧 CompProperties_MMT*，
       视觉/伤害参数全部 XML 透传，C# 零新增特例逻辑）。 -->

  <!-- ① 召唤小火元素：限时炮灰（SkillFX 生物召唤桶，派系随施法者进魔物派系）。
       一次 2 只、存活 60s、CD 45s——场上自然维持 4 只上下，峰值 ≤6 只，与旧版上限等效。 -->
  <AbilityDef>
    <defName>MMT_BossFire_SummonLesser</defName>
    <label>召唤火元素</label>
    <description>从胸口的熔岩核心分裂出两只小火元素，投入战斗。小火元素存在约 60 秒后溃散。</description>
    <iconPath>UI/RoM/summon_demon</iconPath>
    <writeCombatLog>true</writeCombatLog>
    <showPsycastEffects>false</showPsycastEffects>
    <ai_IsOffensive>true</ai_IsOffensive>
    <aiCanUse>true</aiCanUse>
    <cooldownTicksRange>2700</cooldownTicksRange>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>1.0</warmupTime>
      <range>24.9</range>
      <soundCast>MMT_Powerup</soundCast>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <canTargetSelf>false</canTargetSelf>
        <canTargetBuildings>false</canTargetBuildings>
        <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MyModeTest.CompProperties_MMTSkillSummon">
        <mode>Animal</mode>
        <animalKindDefName>MMT_FireElementalLesser</animalKindDefName>
        <count>2</count>
        <durationSeconds>60</durationSeconds>
        <vanishFleckDefName>MMT_Fleck_Flame</vanishFleckDefName>
        <soundDefName>MMT_Powerup</soundDefName>
      </li>
    </comps>
  </AbilityDef>

  <!-- ② 流星火雨：大范围随机落点持续轰击（SkillFX 天降打击桶——原版闪电事件
       视觉（闪电+天空闪光+雷声）叠加自定义 Flame 爆炸伤害层；12 连发绕目标半径 6 格随机落点）。 -->
  <AbilityDef>
    <defName>MMT_BossFire_FireRain</defName>
    <label>流星火雨</label>
    <description>引动元素位面的流火，对目标区域进行 12 轮随机落点轰击，点燃范围内的一切。</description>
    <iconPath>UI/RoM/firestorm</iconPath>
    <writeCombatLog>true</writeCombatLog>
    <showPsycastEffects>false</showPsycastEffects>
    <ai_IsOffensive>true</ai_IsOffensive>
    <aiCanUse>true</aiCanUse>
    <cooldownTicksRange>3600</cooldownTicksRange>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>1.5</warmupTime>
      <range>24.9</range>
      <soundCast>MMT_FireBurn</soundCast>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <canTargetSelf>false</canTargetSelf>
        <canTargetBuildings>false</canTargetBuildings>
        <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MyModeTest.CompProperties_MMTStrike">
        <radius>6</radius>
        <targetFriendly>false</targetFriendly>
        <strikeCount>12</strikeCount>
        <strikeIntervalTicks>45</strikeIntervalTicks>
        <damageDefName>Flame</damageDefName>
        <damage>18</damage>
        <armorPenetration>0</armorPenetration>
        <explosionRadius>1.9</explosionRadius>
        <chanceToStartFire>0.5</chanceToStartFire>
      </li>
    </comps>
  </AbilityDef>

  <!-- ③ 熔岩火柱：窄范围定点喷发（SkillFX 地面火焰桶单柱模式——俯视序列帧自绘：
       5 帧径向爆燃序列（起燃→峰值→旋卷→余烬）按 frameTicks 循环播放、整帧平铺地面
       （1.7 竖直 quad 不渲染、切片堆叠已证伪塌扁，序列帧只做俯视构图），帧图自带颜色故 tint 纯白；
       站上来的目标按跳吃高伤高穿甲 Burn 并被点燃，引燃地面走原版火蔓延）。 -->
  <AbilityDef>
    <defName>MMT_BossFire_FlamePillar</defName>
    <label>熔岩火柱</label>
    <description>在目标脚下喷起一道熔岩火柱，小范围内持续造成高额火焰伤害并点燃地面。</description>
    <iconPath>UI/RoM/sunfire</iconPath>
    <writeCombatLog>true</writeCombatLog>
    <showPsycastEffects>false</showPsycastEffects>
    <ai_IsOffensive>true</ai_IsOffensive>
    <aiCanUse>true</aiCanUse>
    <cooldownTicksRange>900</cooldownTicksRange>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.75</warmupTime>
      <range>24.9</range>
      <soundCast>MMT_FireWooshSD</soundCast>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <canTargetSelf>false</canTargetSelf>
        <canTargetBuildings>false</canTargetBuildings>
        <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MyModeTest.CompProperties_MMTGroundFire">
        <radius>0</radius>
        <targetFriendly>false</targetFriendly>
        <texPath>Things/Mote/MMT_FlamePillar</texPath>
        <tint>(1,1,1)</tint>
        <frameTexPaths>
          <li>Things/Mote/MMT_FlameErupt/MMT_FlameErupt_0</li>
          <li>Things/Mote/MMT_FlameErupt/MMT_FlameErupt_1</li>
          <li>Things/Mote/MMT_FlameErupt/MMT_FlameErupt_2</li>
          <li>Things/Mote/MMT_FlameErupt/MMT_FlameErupt_3</li>
          <li>Things/Mote/MMT_FlameErupt/MMT_FlameErupt_4</li>
        </frameTexPaths>
        <frameTicks>7</frameTicks>
        <visualScale>2.2</visualScale>
        <pillarHeight>3.2</pillarHeight>
        <pillarLayers>7</pillarLayers>
        <pillarTopScale>0.4</pillarTopScale>
        <pillarSway>0.35</pillarSway>
        <durationTicks>180</durationTicks>
        <damageDefName>Burn</damageDefName>
        <damage>10</damage>
        <damageIntervalTicks>15</damageIntervalTicks>
        <armorPenetration>0.35</armorPenetration>
        <ignitePawnChance>0.4</ignitePawnChance>
        <igniteCellChance>0.15</igniteCellChance>
        <effectRadius>1.5</effectRadius>
        <soundDefName>FireSpew_Resolve</soundDefName>
      </li>
    </comps>
  </AbilityDef>
  <!-- ④ 小火元素召唤物技能：火焰弹（单发火球，验证召唤物技能链路——
       复用 SkillShooting.cs 的 MMTSingleShot 投射物桶，小怪级数值，短 CD 高频骚扰）。 -->
  <AbilityDef>
    <defName>MMT_SummonFire_FlameBolt</defName>
    <label>火焰弹</label>
    <description>向目标喷射一枚不稳定的火球，命中后爆裂并点燃周围。</description>
    <iconPath>Things/Projectile/LauncherShot</iconPath>
    <writeCombatLog>true</writeCombatLog>
    <showPsycastEffects>false</showPsycastEffects>
    <ai_IsOffensive>true</ai_IsOffensive>
    <aiCanUse>true</aiCanUse>
    <cooldownTicksRange>600</cooldownTicksRange>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>1.0</warmupTime>
      <range>24.9</range>
      <soundCast>MMT_FireWooshSD</soundCast>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <canTargetSelf>false</canTargetSelf>
        <canTargetBuildings>false</canTargetBuildings>
        <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MyModeTest.CompProperties_MMTSingleShot">
        <projectileDef>MMT_Proj_SkillFireball</projectileDef>
        <soundDefName>Shot_IncendiaryLauncher</soundDefName>
      </li>
      <li Class="MyModeTest.CompProperties_MMTFleckFX">
        <casterFleckDefName>MMT_Fleck_Flame</casterFleckDefName>
        <targetFleckDefName>MMT_Fleck_Flame</targetFleckDefName>
      </li>
    </comps>
  </AbilityDef>
</Defs>
