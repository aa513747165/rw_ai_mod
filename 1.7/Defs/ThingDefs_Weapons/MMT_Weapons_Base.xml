<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- MMT 武器共享基类：以原版 BaseWeapon/BaseGun/BaseMeleeWeapon 为模型，剔除 CE/HSK 组件 -->
	<ThingDef Name="MMT_BaseWeapon" Abstract="True">
		<thingClass>ThingWithComps</thingClass>
		<category>Item</category>
		<drawerType>MapMeshOnly</drawerType>
		<drawGUIOverlay>true</drawGUIOverlay>
		<altitudeLayer>Item</altitudeLayer>
		<alwaysHaulable>true</alwaysHaulable>
		<tickerType>Never</tickerType>
		<equipmentType>Primary</equipmentType>
		<useHitPoints>true</useHitPoints>
		<pathCost>14</pathCost>
		<selectable>true</selectable>
		<rotatable>false</rotatable>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<DeteriorationRate>2</DeteriorationRate>
			<Beauty>-3</Beauty>
			<SellPriceFactor>0.20</SellPriceFactor>
		</statBases>
		<comps>
			<li Class="CompProperties_Forbiddable"/>
			<li>
				<compClass>CompEquippable</compClass>
			</li>
		</comps>
		<graphicData>
			<onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
		</graphicData>
	</ThingDef>

	<ThingDef Name="MMT_BaseGun" Abstract="True" ParentName="MMT_BaseWeapon">
		<techLevel>Industrial</techLevel>
		<smeltable>true</smeltable>
		<thingCategories>
			<li>WeaponsRanged</li>
		</thingCategories>
		<weaponClasses>
			<li>Ranged</li>
		</weaponClasses>
		<statBases>
			<Flammability>0.5</Flammability>
		</statBases>
		<comps>
			<li>
				<compClass>CompQuality</compClass>
			</li>
		</comps>
	</ThingDef>

	<ThingDef Name="MMT_BaseMeleeWeapon" Abstract="True" ParentName="MMT_BaseWeapon">
		<techLevel>Industrial</techLevel>
		<smeltable>true</smeltable>
		<burnableByRecipe>true</burnableByRecipe>
		<thingCategories>
			<li>WeaponsMelee</li>
		</thingCategories>
		<weaponClasses>
			<li>Melee</li>
		</weaponClasses>
		<comps>
			<li>
				<compClass>CompQuality</compClass>
			</li>
		</comps>
	</ThingDef>

	<!-- 炮塔枪基类：不作为装备流通，仅被炮塔建筑引用；不可熔炼（无 smeltProducts） -->
	<ThingDef Name="MMT_BaseTurretGun" Abstract="True" ParentName="MMT_BaseGun">
		<tradeability>None</tradeability>
		<generateCommonality>0</generateCommonality>
		<smeltable>false</smeltable>
	</ThingDef>
</Defs>
